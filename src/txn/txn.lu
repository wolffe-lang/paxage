//! Transactions (X5, X6). Plan is read-only. Execute takes the durable steps in
//! prediction section 2's order, each followed by its named hook; undo (the same
//! code for an in-process rollback and for rescue) classifies every operation
//! before it writes anything, then restores old identities in reverse order.

use walk
use intent
use database as db
use failpoint
use registry
use literal
use schema
use model
use payload
use staging
use version
use std.str as text
use std.list as list
use std.x.crypto.sha2 as sha2

/// The held root and how this run applies owners and hooks.
pub struct Ctx { root: walk.Root, fail: failpoint.Fail, privileged: bool }

/// One F5 file record of a manifest.
pub struct Rec {
    path: str,
    kind: str,
    mode: int,
    owner: int,
    group: int,
    length: int,
    sha256: str,
    target: str,
}

/// One declared action.
pub struct Action { kind: str, name: str }

/// A package in the old or new set: identity, reason, its manifest and payload.
pub struct Pkg {
    name: str,
    version: str,
    arch: str,
    slot: str,
    reason: str,
    digest: str,
    bytes: List[byte],
    recs: List[Rec],
    configs: List[str],
    actions: List[Action],
    model: model.Package,
    payload: str,
    payload_length: int,
    payload_sha256: str,
    manifest_object: str,
}

/// Where a put's bytes come from: a staged file (root-relative) or generated bytes.
pub struct Source { rel: str, bytes: List[byte] }

/// A complete plan: operations, their sources, the next generation and summary lines.
pub struct Plan {
    ops: List[intent.Op],
    sources: List[Source],
    next: db.Db,
    packages: List[Pkg],
    stage: List[Pkg],
    summary: List[str],
    error: str,
}

/// The state directory, root-relative.
pub fn state() -> str { "var/lib/larder" }

fn tx_rel(t: str) -> str { "var/lib/larder/transactions/{t}" }

fn hook(c: Ctx, point: str, detail: str) -> str { failpoint.hit(c.fail, point, detail) }

fn sub(s: str, a: int, b: int) -> str { text.get(s, a, b) else |_| { "" } }

// ------------------------------------------------------------------ manifests

/// Decode an already validated manifest's records, configs and actions.
pub fn decode(bytes: List[byte], reason: str) -> Pkg {
    let d = literal.parse(bytes)
    var p = Pkg {
        name: "",
        version: "",
        arch: "",
        slot: "",
        reason,
        digest: sha2.to_hex(sha2.sum256(bytes)),
        bytes: copy bytes,
        recs: List[Rec](),
        configs: List[str](),
        actions: List[Action](),
        model: model.Package {
            name: "",
            version: "",
            arch: "",
            slot: "",
            requires: List[model.Need](),
            optional: List[model.Need](),
            provides: List[model.Offer](),
            conflicts: List[model.Need](),
            replaces: List[model.Need](),
        },
        payload: "",
        payload_length: 0,
        payload_sha256: "",
        manifest_object: "",
    }
    if d.error != "" || schema.manifest(d, 0) != "" { return p }
    p.name = schema.string(d, 0, "name")
    p.version = schema.string(d, 0, "version")
    p.arch = schema.string(d, 0, "arch")
    p.slot = schema.string(d, 0, "slot")
    p.model = schema.package(d, 0)
    for c in literal.children(d, literal.field(d, 0, "files")) {
        (mut p.recs).push(Rec {
            path: schema.string(d, c, "path"),
            kind: schema.string(d, c, "type"),
            mode: schema.integer(d, c, "mode"),
            owner: schema.integer(d, c, "owner"),
            group: schema.integer(d, c, "group"),
            length: schema.integer(d, c, "length"),
            sha256: schema.string(d, c, "sha256"),
            target: schema.string(d, c, "target"),
        })
    }
    for c in literal.children(d, literal.field(d, 0, "configs")) {
        (mut p.configs).push(d.nodes[c].text)
    }
    for c in literal.children(d, literal.field(d, 0, "actions")) {
        (mut p.actions).push(Action {
            kind: schema.string(d, c, "kind"),
            name: schema.string(d, c, "name"),
        })
    }
    p
}

fn rec_index(p: Pkg, path: str) -> int {
    for i in 0..p.recs.len { if p.recs[i].path == path { return i } }
    -1
}

fn is_config(p: Pkg, path: str) -> bool {
    for c in p.configs { if c == path { return true } }
    false
}

/// What a manifest record requires of the live name.
pub fn want_of(p: Pkg, r: Rec) -> intent.Want {
    var w = intent.Want {
        kind: r.kind,
        mode: r.mode,
        uid: r.owner,
        gid: r.group,
        length: r.length,
        sha256: r.sha256,
        target: r.target,
    }
    if r.kind == "symlink" { w.mode = 0; w.length = 0 }
    if r.kind == "hardlink" {
        w.kind = "link"
        let at = rec_index(p, r.target)
        if at >= 0 { w.length = p.recs[at].length; w.sha256 = p.recs[at].sha256 }
    }
    w
}

/// The live identity as a want.
pub fn want_of_live(l: walk.Ident) -> intent.Want {
    var w = intent.Want {
        kind: l.kind,
        mode: l.mode,
        uid: l.uid,
        gid: l.gid,
        length: l.length,
        sha256: l.sha256,
        target: l.target,
    }
    if l.kind == "symlink" { w.mode = 0; w.length = 0 }
    if l.kind == "dir" { w.length = 0 }
    w
}

/// Whether a live name is what a want describes. Links compare content (their
/// inode is checked separately, after relinking); logical roots ignore owners.
pub fn matches(l: walk.Ident, w: intent.Want, logical: bool) -> bool {
    if w.kind == "absent" { return l.kind == "absent" }
    let owners = logical || l.uid == w.uid && l.gid == w.gid
    if w.kind == "dir" { return l.kind == "dir" && l.mode == w.mode && owners }
    if w.kind == "symlink" { return l.kind == "symlink" && l.target == w.target && owners }
    l.kind == "file" && l.mode == w.mode && l.length == w.length && l.sha256 == w.sha256 && owners
}

fn same_inode(r: walk.Root, a: str, b: str) -> bool {
    let x = walk.look_path(r, a, false)
    let y = walk.look_path(r, b, false)
    x.kind == "file" && y.kind == "file" && x.dev == y.dev && x.ino == y.ino
}

// ------------------------------------------------------------------ planning

struct Owner { package: str, rec: Rec, from: int }

fn op(action: str, path: str, old: intent.Want, new: intent.Want, backup: bool) -> intent.Op {
    intent.Op { index: 0, action, path, old, new, backup }
}

fn none_source() -> Source { Source { rel: "", bytes: List[byte]() } }

struct Work {
    mkdirs: List[intent.Op],
    msrc: List[Source],
    chmetas: List[intent.Op],
    puts: List[intent.Op],
    psrc: List[Source],
    links: List[intent.Op],
    deletes: List[intent.Op],
    rmdirs: List[intent.Op],
    error: str,
}

fn dir_want(mode: int, uid: int, gid: int) -> intent.Want {
    intent.Want { kind: "dir", mode, uid, gid, length: 0, sha256: "", target: "" }
}

fn file_want(bytes: List[byte], mode: int, uid: int, gid: int) -> intent.Want {
    intent.Want {
        kind: "file",
        mode,
        uid,
        gid,
        length: bytes.len,
        sha256: sha2.to_hex(sha2.sum256(bytes)),
        target: "",
    }
}

fn planned_dir(w: Work, path: str) -> bool {
    for o in w.mkdirs { if o.path == path { return true } }
    false
}

/// Add mkdir operations for the missing ancestors of rel (0755, root), owned by package.
fn ensure_parents(c: Ctx, mut w: Work, mut owned: List[db.Owned], rel: str, package: str) {
    let parts = walk.components(walk.parent_of(rel))
    var prefix = ""
    for name in parts {
        prefix = walk.join(prefix, name)
        if planned_dir(w, prefix) { continue }
        let live = walk.look_path(c.root, prefix, false)
        if live.kind == "dir" { continue }
        if live.kind != "absent" { w.error = "unowned-collision {prefix}"; return }
        (mut w.mkdirs).push(op("mkdir", prefix, intent.nothing(), dir_want(493, 0, 0), false))
        (mut w.msrc).push(none_source())
        (mut owned).push(db.Owned { path: prefix, package })
    }
}

fn baseline(old: db.Db, path: str) -> str {
    for b in old.baselines { if b.path == path { return b.sha256 } }
    ""
}

fn proposal_of(old: db.Db, path: str) -> int {
    for i in 0..old.proposals.len { if old.proposals[i].path == path { return i } }
    -1
}

fn lines_of(bytes: List[byte]) -> List[str] {
    let s = str_from_utf8(bytes) else |_| { return List[str]() }
    var out = List[str]()
    for l in text.split(s, "\n") { if l != "" { (mut out).push(l) } }
    out
}

struct Edited { bytes: List[byte], changed: bool, error: str }

fn account_edit(
    current: List[byte],
    line: str,
    name: str,
    id: int,
    idfield: int,
    kind: str,
) -> Edited {
    var out = Edited { bytes: copy current, changed: false, error: "" }
    for l in lines_of(current) {
        let f = text.split(l, ":")
        if f.len < 3 { continue }
        if f[0] == name {
            if f[idfield] != "{id}" { out.error = "{kind}-conflict {name}" }
            return out
        }
        if f[idfield] == "{id}" {
            out.error = "{kind}-id-conflict {name} {id} used by {f[0]}"
            return out
        }
    }
    var b = copy current
    if b.len > 0 && b[b.len - 1] != 10 as byte { (mut b).push(10 as byte) }
    for x in "{line}\n".bytes() { (mut b).push(x) }
    out.bytes = b
    out.changed = true
    out
}

fn read_live(c: Ctx, rel: str) -> List[byte] {
    let d = walk.dir(c.root, walk.parent_of(rel))
    if d.error != "" { return List[byte]() }
    let fd = fs_open_at(d.fd, walk.base_of(rel), 21, 0) else |_| {
        walk.close(d)
        return List[byte]()
    }
    var data = List[byte]()
    loop {
        let chunk = fs_read_chunk(fd, 65536) else |_| { break }
        if chunk.len == 0 { break }
        for x in chunk { (mut data).push(x) }
        if data.len > 1048576 { break }
    }
    fs_close(fd) else |_| {}
    walk.close(d)
    data
}

fn edit_file(c: Ctx, mut w: Work, rel: str, bytes: List[byte], mode: int) {
    let live = walk.look_path(c.root, rel, true)
    if live.kind != "absent" && live.kind != "file" { w.error = "unowned-collision {rel}"; return }
    var new = file_want(bytes, mode, 0, 0)
    var old = intent.nothing()
    if live.kind == "file" {
        old = want_of_live(live)
        new.mode = live.mode
        new.uid = live.uid
        new.gid = live.gid
    }
    (mut w.puts).push(op("put", rel, old, new, live.kind == "file"))
    (mut w.psrc).push(Source { rel: "", bytes: copy bytes })
}

fn plan_accounts(c: Ctx, mut w: Work, old: db.Db, mut next: db.Db, adds: List[Pkg]) {
    var passwd = read_live(c, "etc/passwd")
    var group = read_live(c, "etc/group")
    let shadow_live = walk.look_path(c.root, "etc/shadow", false)
    var shadow = read_live(c, "etc/shadow")
    var pw = false
    var gr = false
    var sh = false
    for p in adds {
        for a in p.actions {
            if a.kind != "account" { continue }
            var known = false
            for x in old.accounts { if x.name == a.name { known = true } }
            if known { continue }
            let acct = registry.account(a.name)
            if acct.error != "" { w.error = acct.error; return }
            let pe = account_edit(
                passwd,
                "{acct.name}:x:{acct.uid}:{acct.gid}:{acct.gecos}:{acct.home}:{acct.shell}",
                acct.name,
                acct.uid,
                2,
                "account",
            )
            if pe.error != "" { w.error = pe.error; return }
            let ge = account_edit(
                group,
                "{acct.name}:x:{acct.gid}:",
                acct.name,
                acct.gid,
                2,
                "group",
            )
            if ge.error != "" { w.error = ge.error; return }
            if pe.changed { passwd = pe.bytes; pw = true }
            if ge.changed { group = ge.bytes; gr = true }
            if shadow_live.kind == "file" {
                let se = account_edit(shadow, "{acct.name}:!:::::::", acct.name, -2, 0, "shadow")
                if se.changed { shadow = se.bytes; sh = true }
            }
            (mut next.accounts).push(db.
                Account { name: acct.name, uid: acct.uid, gid: acct.gid, package: p.name })
        }
    }
    if pw || gr { ensure_parents(c, mut w, mut next.directories, "etc/passwd", "") }
    if w.error != "" { return }
    if pw { edit_file(c, mut w, "etc/passwd", passwd, 420) }
    if gr { edit_file(c, mut w, "etc/group", group, 420) }
    if sh { edit_file(c, mut w, "etc/shadow", shadow, 384) }
}

fn plan_directories(c: Ctx, mut w: Work, old: db.Db, mut next: db.Db, adds: List[Pkg]) {
    for p in adds {
        for a in p.actions {
            if a.kind == "cache" {
                let e = registry.cache(a.name)
                if e != "" { w.error = e; return }
                (mut next.pending).push(db.Pending { kind: "cache", name: a.name, package: p.name })
                continue
            }
            if a.kind != "directory" { continue }
            let r = registry.directory(a.name)
            if r.error != "" { w.error = r.error; return }
            var known = false
            for o in old.directories { if o.path == r.path && o.package == p.name { known = true } }
            if known { continue }
            ensure_parents(c, mut w, mut next.directories, r.path, p.name)
            if w.error != "" { return }
            let live = walk.look_path(c.root, r.path, false)
            let want = dir_want(r.mode, r.uid, r.gid)
            if live.kind == "absent" {
                (mut w.mkdirs).push(op("mkdir", r.path, intent.nothing(), want, false))
                (mut w.msrc).push(none_source())
            } else if !matches(live, want, !c.privileged) {
                w.error = "directory-conflict {r.path}"
                return
            }
            (mut next.directories).push(db.Owned { path: r.path, package: p.name })
        }
    }
}

fn index_owners(pkgs: List[Pkg]) -> Map[str, int] {
    var m = Map[str, int]()
    for i in 0..pkgs.len {
        for r in pkgs[i].recs {
            if r.kind == "dir" { continue }
            m[r.path] = i
        }
    }
    m
}

fn find_pkg(pkgs: List[Pkg], name: str) -> int {
    for i in 0..pkgs.len { if pkgs[i].name == name { return i } }
    -1
}

fn rec_less(a: Rec, b: Rec) -> bool { version.lexical(a.path, b.path) < 0 }

fn op_less(a: intent.Op, b: intent.Op) -> bool { version.lexical(a.path, b.path) < 0 }

fn op_more(a: intent.Op, b: intent.Op) -> bool { version.lexical(a.path, b.path) > 0 }

/// Plan the move from old (with its decoded packages) to next. purge names packages
/// whose residual configs are deleted. Read-only: no name is written.
pub fn plan(c: Ctx, old: db.Db, olds: List[Pkg], news: List[Pkg], purge: List[str]) -> Plan {
    var w = Work {
        mkdirs: List[intent.Op](),
        msrc: List[Source](),
        chmetas: List[intent.Op](),
        puts: List[intent.Op](),
        psrc: List[Source](),
        links: List[intent.Op](),
        deletes: List[intent.Op](),
        rmdirs: List[intent.Op](),
        error: "",
    }
    var next = db.empty(old.arch, old.slot, old.repository, old.ownership)
    next.generation = old.generation + 1
    next.transaction = "t{next.generation}"
    var out = Plan {
        ops: List[intent.Op](),
        sources: List[Source](),
        next: db.empty("", "", "", ""),
        packages: copy news,
        stage: List[Pkg](),
        summary: List[str](),
        error: "",
    }
    let logical = !c.privileged
    let old_files = index_owners(olds)
    let new_files = index_owners(news)
    // Identity changes for the summary and the staging list.
    for p in news {
        let at = find_pkg(olds, p.name)
        if at < 0 {
            (mut out.summary).push("install {p.name} {p.version} ({p.reason})")
            (mut out.stage).push(copy p)
        } else if olds[at].digest != p.digest {
            (mut out.summary).push("upgrade {p.name} {olds[at].version} -> {p.version}")
            (mut out.stage).push(copy p)
        } else if olds[at].reason != p.reason {
            (mut out.summary).push("mark {p.name} {p.reason}")
        }
    }
    for p in olds {
        if find_pkg(news, p.name) < 0 { (mut out.summary).push("remove {p.name} {p.version}") }
    }
    var adds = List[Pkg]()
    for p in out.stage { (mut adds).push(copy p) }
    // New and changed records, path order (parents before children).
    var proposals = List[db.Proposal]()
    var residuals = List[db.Residual]()
    var baselines = List[db.Baseline]()
    for p in news {
        let at = find_pkg(olds, p.name)
        let unchanged = at >= 0 && olds[at].digest == p.digest
        for cfg in p.configs {
            if unchanged {
                (mut baselines).push(db.
                    Baseline { path: cfg, package: p.name, sha256: baseline(old, cfg) })
            }
        }
        if unchanged {
            for pr in old.proposals { if pr.package == p.name { (mut proposals).push(copy pr) } }
            continue
        }
        var recs = copy p.recs
        list.sort_by(mut recs, rec_less)
        for r in recs {
            let want = want_of(p, r)
            if r.kind != "dir" {
                let other = new_files[r.path] else -1
                if other >= 0 && news[other].name != p.name {
                    out.error = "file-conflict {r.path} owner={news[other].name}"
                    return out
                }
            }
            let prior = old_files[r.path] else -1
            if r.kind != "dir" &&
                prior >= 0 &&
                olds[prior].name != p.name &&
                find_pkg(news, olds[prior].name) >= 0 {
                out.error = "file-conflict {r.path} owner={olds[prior].name}"
                return out
            }
            let live = walk.look_path(c.root, r.path, true)
            if live.kind == "error" { out.error = live.error; return out }
            if r.kind == "dir" {
                if live.kind == "absent" {
                    if !planned_dir(w, r.path) {
                        (mut w.mkdirs).push(op("mkdir", r.path, intent.nothing(), want, false))
                        (mut w.msrc).push(none_source())
                    }
                } else if live.kind != "dir" {
                    out.error = "unowned-collision {r.path}"
                    return out
                } else if !matches(live, want, logical) {
                    var owned_before = false
                    for q in olds {
                        if q.name == p.name && rec_index(q, r.path) >= 0 { owned_before = true }
                    }
                    if !owned_before { out.error = "directory-conflict {r.path}"; return out }
                    (mut w.chmetas).push(op("chmeta", r.path, want_of_live(live), want, false))
                }
                continue
            }
            let mine = prior >= 0
            if live.kind == "dir" || live.kind == "other" {
                out.error = "unowned-collision {r.path}"
                return out
            }
            if !mine {
                if live.kind != "absent" { out.error = "unowned-collision {r.path}"; return out }
                if want.kind == "link" {
                    (mut w.links).push(op("link", r.path, intent.nothing(), want, false))
                } else {
                    (mut w.puts).push(op("put", r.path, intent.nothing(), want, false))
                    (mut w.psrc).push(Source {
                        rel: "{tx_rel(next.transaction)}/stage/{p.name}/{r.path}",
                        bytes: List[byte](),
                    })
                }
                if is_config(p, r.path) {
                    (mut baselines).push(db.
                        Baseline { path: r.path, package: p.name, sha256: r.sha256 })
                }
                continue
            }
            // Owned by the package's previous version (or a package this plan removes).
            let prev = copy olds[prior]
            let prev_rec = copy prev.recs[rec_index(prev, r.path)]
            var old_want = want_of_live(live)
            var backup = live.kind == "file"
            if prev_rec.kind == "hardlink" &&
                live.kind == "file" &&
                same_inode(c.root, r.path, prev_rec.target) {
                // Still a second name of its source: undo relinks it, whatever the shared content.
                old_want.kind = "link"
                old_want.target = prev_rec.target
                backup = false
            }
            if is_config(p, r.path) {
                let b = baseline(old, r.path)
                let n = r.sha256
                (mut baselines).push(db.Baseline { path: r.path, package: p.name, sha256: n })
                if live.kind == "absent" { continue }
                let l = live.sha256
                if l == b {
                    if n != b {
                        (mut w.puts).push(op("put", r.path, old_want, want, backup))
                        (mut w.psrc).push(Source {
                            rel: "{tx_rel(next.transaction)}/stage/{p.name}/{r.path}",
                            bytes: List[byte](),
                        })
                    }
                    continue
                }
                if n == b || l == n { continue }
                let ppath = "{r.path}.larder-new"
                let plive = walk.look_path(c.root, ppath, true)
                let mine_prop = proposal_of(old, ppath)
                if plive.kind != "absent" && mine_prop < 0 {
                    out.error = "proposal-exists {ppath}"
                    return out
                }
                if plive.kind != "absent" && plive.kind != "file" {
                    out.error = "proposal-exists {ppath}"
                    return out
                }
                var pold = intent.nothing()
                if plive.kind == "file" { pold = want_of_live(plive) }
                (mut w.puts).push(op("put", ppath, pold, want, plive.kind == "file"))
                (mut w.psrc).push(Source {
                    rel: "{tx_rel(next.transaction)}/stage/{p.name}/{r.path}",
                    bytes: List[byte](),
                })
                (mut proposals).push(db.Proposal { path: ppath, package: p.name, sha256: n })
                (mut out.summary).push("proposal {ppath}")
                continue
            }
            if matches(live, want, logical) && want.kind != "link" { continue }
            if live.kind != "absent" && !matches(live, want_of(prev, prev_rec), logical) {
                (mut out.summary).push("replace-modified {r.path}")
            }
            if want.kind == "link" {
                if matches(live, want, logical) && same_inode(c.root, r.path, r.target) {
                    var target_changes = false
                    for x in w.puts { if x.path == r.target { target_changes = true } }
                    if !target_changes { continue }
                }
                (mut w.links).push(op("link", r.path, old_want, want, backup))
            } else {
                (mut w.puts).push(op("put", r.path, old_want, want, backup))
                (mut w.psrc).push(Source {
                    rel: "{tx_rel(next.transaction)}/stage/{p.name}/{r.path}",
                    bytes: List[byte](),
                })
            }
        }
        for pr in old.proposals {
            if pr.package != p.name { continue }
            var kept = false
            for x in proposals { if x.path == pr.path { kept = true } }
            if !kept { (mut proposals).push(copy pr) }
        }
    }
    // Paths the old set owned that the new set does not.
    var gone = List[Rec]()
    var gone_pkg = List[str]()
    for q in olds {
        let still = find_pkg(news, q.name)
        if still >= 0 && news[still].digest == q.digest { continue }
        for r in q.recs {
            var kept = false
            for p in news { if rec_index(p, r.path) >= 0 { kept = true } }
            for x in gone { if x.path == r.path { kept = true } }
            if kept { continue }
            (mut gone).push(copy r)
            (mut gone_pkg).push(q.name)
        }
    }
    // Deepest first: reverse path order.
    var order = List[int]()
    for i in 0..gone.len { (mut order).push(i) }
    var i = 1
    while i < order.len {
        var j = i
        while j > 0 && version.lexical(gone[order[j]].path, gone[order[j - 1]].path) > 0 {
            let t = order[j]
            order[j] = order[j - 1]
            order[j - 1] = t
            j -= 1
        }
        i += 1
    }
    for k in order {
        let r = copy gone[k]
        let pname = gone_pkg[k]
        let q = copy olds[find_pkg(olds, pname)]
        let live = walk.look_path(c.root, r.path, true)
        if live.kind == "error" { out.error = live.error; return out }
        if live.kind == "absent" { continue }
        if r.kind == "dir" {
            if live.kind != "dir" { continue }
            if empty_after(c, w, r.path) {
                (mut w.
                    rmdirs).push(op("rmdir", r.path, want_of_live(live), intent.nothing(), false))
            }
            continue
        }
        let w_old = want_of(q, r)
        if is_config(q, r.path) {
            if live.kind == "file" &&
                live.sha256 == baseline(old, r.path) &&
                matches(live, w_old, logical) {
                (mut w.deletes).push(op("delete", r.path, w_old, intent.nothing(), true))
            } else {
                (mut residuals).push(db.Residual { path: r.path, package: pname })
                (mut out.summary).push("residual {r.path}")
            }
            continue
        }
        if matches(live, w_old, logical) {
            if w_old.kind == "link" && !same_inode(c.root, r.path, r.target) {
                (mut w.
                    deletes).push(op("delete", r.path, want_of_live(live), intent.nothing(), true))
            } else {
                (mut w.deletes).push(
                    op("delete", r.path, w_old, intent.nothing(), w_old.kind == "file"),
                )
            }
        } else {
            (mut residuals).push(db.Residual { path: r.path, package: pname })
            (mut out.summary).push("residual {r.path}")
        }
    }
    // Proposals of removed packages.
    for pr in old.proposals {
        if find_pkg(news, pr.package) >= 0 { continue }
        let live = walk.look_path(c.root, pr.path, true)
        if live.kind == "file" && live.sha256 == pr.sha256 {
            (mut w.deletes).push(op("delete", pr.path, want_of_live(live), intent.nothing(), true))
        }
    }
    // Residuals: keep old ones unless purged or reclaimed by a package.
    for res in old.residuals {
        var claimed = false
        for p in news { if rec_index(p, res.path) >= 0 { claimed = true } }
        if claimed { continue }
        var purged = false
        for n in purge { if n == res.package { purged = true } }
        if purged && find_pkg(news, res.package) < 0 {
            let live = walk.look_path(c.root, res.path, true)
            var cfg = false
            for q in olds { if q.name == res.package && is_config(q, res.path) { cfg = true } }
            for b in old.baselines { if b.path == res.path { cfg = true } }
            if live.kind == "file" && (cfg || text.starts_with(res.path, "etc/")) {
                (mut w.deletes).push(
                    op("delete", res.path, want_of_live(live), intent.nothing(), true),
                )
                (mut out.summary).push("purge {res.path}")
                continue
            }
            if live.kind == "absent" { continue }
        }
        (mut residuals).push(copy res)
    }
    // Accounts persist; directories of removed packages go when empty.
    for a in old.accounts { (mut next.accounts).push(copy a) }
    var dirs_rev = copy old.directories
    list.reverse(mut dirs_rev)
    var kept_dirs = List[db.Owned]()
    for o in dirs_rev {
        if find_pkg(news, o.package) >= 0 || o.package == "" {
            (mut kept_dirs).push(copy o)
            continue
        }
        let live = walk.look_path(c.root, o.path, false)
        if live.kind == "dir" && empty_after(c, w, o.path) {
            (mut w.rmdirs).push(op("rmdir", o.path, want_of_live(live), intent.nothing(), false))
        } else if live.kind != "absent" {
            (mut kept_dirs).push(copy o)
        }
    }
    list.reverse(mut kept_dirs)
    for o in kept_dirs { (mut next.directories).push(copy o) }
    for pe in old.pending {
        if find_pkg(news, pe.package) >= 0 { (mut next.pending).push(copy pe) }
    }
    plan_accounts(c, mut w, old, mut next, adds)
    if w.error != "" { out.error = w.error; return out }
    plan_directories(c, mut w, old, mut next, adds)
    if w.error != "" { out.error = w.error; return out }
    for pe in next.pending {
        var listed = false
        for s in out.summary { if s == "pending {pe.kind} {pe.name}" { listed = true } }
        if !listed { (mut out.summary).push("pending {pe.kind} {pe.name}") }
    }
    // The next generation's package list.
    for p in news {
        (mut next.packages).push(db.Installed {
            name: p.name,
            version: p.version,
            arch: p.arch,
            slot: p.slot,
            reason: p.reason,
            manifest: p.digest,
        })
    }
    next.baselines = baselines
    next.residuals = residuals
    next.proposals = proposals
    // Final order: mkdir shallowest-first, chmeta, puts, links, deletes, rmdirs deepest-first.
    var ops = List[intent.Op]()
    var srcs = List[Source]()
    var mks = copy w.mkdirs
    list.sort_by(mut mks, op_less)
    for x in mks { (mut ops).push(copy x); (mut srcs).push(none_source()) }
    for x in w.chmetas { (mut ops).push(copy x); (mut srcs).push(none_source()) }
    for k in 0..w.puts.len { (mut ops).push(copy w.puts[k]); (mut srcs).push(copy w.psrc[k]) }
    for x in w.links { (mut ops).push(copy x); (mut srcs).push(none_source()) }
    var dels = copy w.deletes
    list.sort_by(mut dels, op_more)
    for x in dels { (mut ops).push(copy x); (mut srcs).push(none_source()) }
    var rms = copy w.rmdirs
    list.sort_by(mut rms, op_more)
    for x in rms { (mut ops).push(copy x); (mut srcs).push(none_source()) }
    for k in 0..ops.len { ops[k].index = k }
    out.ops = ops
    out.sources = srcs
    out.next = next
    out
}

fn deleted(w: Work, path: str) -> bool {
    for o in w.deletes { if o.path == path { return true } }
    for o in w.rmdirs { if o.path == path { return true } }
    false
}

/// Whether a live directory holds nothing once this plan's deletions run.
fn empty_after(c: Ctx, w: Work, rel: str) -> bool {
    let d = walk.dir(c.root, rel)
    if d.error != "" { return false }
    let names = walk.names(d)
    walk.close(d)
    for n in names {
        if !deleted(w, walk.join(rel, n)) { return false }
    }
    true
}

// ------------------------------------------------------------------ durable writes

fn write_new(d: walk.Dir, name: str, bytes: List[byte], mode: int) -> str {
    let fd = fs_open_at(d.fd, name, 20, 384) else |e| match e {
        exists => { return "exists {walk.join(d.rel, name)}" },
        _ => { return walk.because("create {walk.join(d.rel, name)}") },
    }
    var error = ""
    fs_write_chunk(fd, bytes) else |_| { error = walk.because("write {walk.join(d.rel, name)}") }
    if error == "" { fs_set_mode_fd(fd, mode) else |_| { error = "mode {walk.join(d.rel, name)}" } }
    if error == "" { fs_sync(fd) else |_| { error = walk.because("sync {walk.join(d.rel, name)}") } }
    fs_close(fd) else |_| { error = "close {walk.join(d.rel, name)}" }
    error
}

fn mkdir_in(d: walk.Dir, name: str) -> str {
    fs_create_dir_at(d.fd, name, 448) else |e| match e {
        exists => { return "exists {walk.join(d.rel, name)}" },
        _ => { return "mkdir {walk.join(d.rel, name)}" },
    }
    ""
}

fn remove_name(d: walk.Dir, name: str) -> str {
    fs_remove_at(d.fd, name) else |e| match e {
        not_found => { return "" },
        _ => { return "remove {walk.join(d.rel, name)}" },
    }
    ""
}

/// Read a small state file through the walk, bounded.
pub fn read_rel(c: Ctx, rel: str, cap: int) -> List[byte] {
    let d = walk.dir(c.root, walk.parent_of(rel))
    if d.error != "" { return List[byte]() }
    let fd = fs_open_at(d.fd, walk.base_of(rel), 21, 0) else |_| {
        walk.close(d)
        return List[byte]()
    }
    var data = List[byte]()
    loop {
        let chunk = fs_read_chunk(fd, 65536) else |_| { break }
        if chunk.len == 0 { break }
        for x in chunk { (mut data).push(x) }
        if data.len > cap { break }
    }
    fs_close(fd) else |_| {}
    walk.close(d)
    data
}

/// Load generation n and check it against the commit record's digest.
pub fn load(c: Ctx, cur: db.Current) -> db.Db {
    let bytes = read_rel(c, "{state()}/generations/{cur.generation}/db.lrd", 1048576)
    var bad = db.empty("", "", "", "")
    if bytes.len == 0 || sha2.to_hex(sha2.sum256(bytes)) != cur.database {
        bad.error = "database-invalid generation {cur.generation}"
        return bad
    }
    let out = db.parse(bytes)
    if out.error == "" && out.generation != cur.generation {
        bad.error = "database-invalid generation {cur.generation}"
        return bad
    }
    out
}

/// The current commit record.
pub fn current(c: Ctx) -> db.Current {
    let bytes = read_rel(c, "{state()}/current", 4096)
    if bytes.len == 0 {
        return db.Current {
            generation: -1,
            database: "",
            transaction: "",
            error: "current-invalid",
        }
    }
    db.parse_current(bytes)
}

/// The installed packages' manifests from generation g, decoded.
pub fn installed(c: Ctx, g: db.Db) -> List[Pkg] {
    var out = List[Pkg]()
    for p in g.packages {
        let bytes = read_rel(
            c,
            "{state()}/generations/{g.generation}/manifests/{p.manifest}",
            1048576,
        )
        var pkg = decode(bytes, p.reason)
        if bytes.len == 0 || pkg.digest != p.manifest || pkg.name != p.name { pkg.name = "" }
        (mut out).push(pkg)
    }
    out
}

/// The pending transaction's name, or "".
pub fn pending(c: Ctx) -> str {
    let d = walk.dir(c.root, "{state()}/transactions")
    if d.error != "" { return "" }
    let names = walk.names(d)
    walk.close(d)
    if names.len == 0 { return "" }
    var all = copy names
    list.sort_by(mut all, str_less)
    text.join(",", all)
}

fn str_less(a: str, b: str) -> bool { version.lexical(a, b) < 0 }

// ------------------------------------------------------------------ apply

fn set_meta(c: Ctx, fd: int, w: intent.Want) -> str {
    if c.privileged { fs_set_owner_fd(fd, w.uid, w.gid) else |_| { return "owner" } }
    fs_set_mode_fd(fd, w.mode) else |_| { return "mode" }
    ""
}

fn copy_source(c: Ctx, src: Source, out: int) -> str {
    if src.rel == "" {
        fs_write_chunk(out, src.bytes) else |_| { return walk.because("!") }
        return sha2.to_hex(sha2.sum256(src.bytes))
    }
    let d = walk.dir(c.root, walk.parent_of(src.rel))
    if d.error != "" { return "" }
    let fd = fs_open_at(d.fd, walk.base_of(src.rel), 21, 0) else |_| { walk.close(d); return "" }
    let s = fs_fstat_record(fd) else |_| {
        fs_close(fd) else |_| {}
        walk.close(d)
        return ""
    }
    let h = walk.copy_fd(fd, out, s[1])
    fs_close(fd) else |_| {}
    walk.close(d)
    h
}

fn step(c: Ctx, point: str, detail: str, error: str) -> str {
    if error != "" { return error }
    let injected = hook(c, point, detail)
    if injected != "" { return "{point}: {injected}" }
    ""
}

fn apply_one(c: Ctx, t: str, o: intent.Op, src: Source) -> str {
    let i = o.index
    let pd = walk.dir(c.root, walk.parent_of(o.path))
    if pd.error != "" { return pd.error }
    let name = walk.base_of(o.path)
    var e = step(c, "apply:{i}:walk", "path={o.path}", "")
    if e != "" { walk.close(pd); return e }
    let live = walk.look(c.root, pd, name, true)
    if live.kind == "error" { walk.close(pd); return live.error }
    if !matches(live, o.old, !c.privileged) && !(o.old.kind == "link" && live.kind == "file") {
        walk.close(pd)
        return "live-changed {o.path}"
    }
    let tmp = ".larder-{t}-{i}"
    if o.action == "mkdir" {
        e = mkdir_in(pd, name)
        if e == "" {
            let fd = fs_open_at(pd.fd, name, 48, 0) else |_| { -1 }
            if fd < 0 {
                e = "path-race {o.path}"
            } else {
                e = set_meta(c, fd, o.new)
                if e == "" { fs_sync(fd) else |_| { e = walk.because("sync {o.path}") } }
                fs_close(fd) else |_| {}
            }
        }
        e = step(c, "apply:{i}:renamed", "", e)
    } else if o.action == "chmeta" {
        let fd = fs_open_at(pd.fd, name, 48, 0) else |_| { -1 }
        if fd < 0 {
            e = "path-race {o.path}"
        } else {
            e = set_meta(c, fd, o.new)
            if e == "" { fs_sync(fd) else |_| { e = walk.because("sync {o.path}") } }
            fs_close(fd) else |_| {}
        }
        e = step(c, "apply:{i}:renamed", "", e)
    } else if o.action == "put" && o.new.kind == "symlink" {
        fs_symlink_at(o.new.target, pd.fd, tmp) else |_| { e = "symlink {o.path}" }
        if e == "" && c.privileged { e = walk.lchown(c.root, pd, tmp, o.new.uid, o.new.gid) }
        e = step(c, "apply:{i}:temp", "", e)
        if e == "" { e = walk.rename(c.root, pd, tmp, name) }
        e = step(c, "apply:{i}:renamed", "", e)
    } else if o.action == "put" {
        let out = fs_open_at(pd.fd, tmp, 20, 384) else |_| { -1 }
        if out < 0 {
            e = "create {o.path}"
        } else {
            let h = copy_source(c, src, out)
            if walk.copy_failed(h) {
                e = "write {o.path}{walk.copy_why(h)}"
            } else if h != o.new.sha256 {
                e = "content {o.path}"
            }
            if e == "" { e = set_meta(c, out, o.new) }
            if e == "" { fs_sync(out) else |_| { e = walk.because("sync {o.path}") } }
            fs_close(out) else |_| { e = "close {o.path}" }
        }
        e = step(c, "apply:{i}:temp", "", e)
        if e == "" { e = walk.rename(c.root, pd, tmp, name) }
        e = step(c, "apply:{i}:renamed", "", e)
    } else if o.action == "link" {
        let sd = walk.dir(c.root, walk.parent_of(o.new.target))
        if sd.error != "" {
            e = sd.error
        } else {
            fs_link_at(sd.fd, walk.base_of(o.new.target), pd.fd, tmp, false) else |_| {
                e = "link {o.path}"
            }
            walk.close(sd)
        }
        e = step(c, "apply:{i}:temp", "", e)
        if e == "" { e = walk.rename(c.root, pd, tmp, name) }
        e = step(c, "apply:{i}:renamed", "", e)
    } else if o.action == "delete" {
        fs_remove_at(pd.fd, name) else |_| { e = "remove {o.path}" }
        e = step(c, "apply:{i}:renamed", "", e)
    } else if o.action == "rmdir" {
        fs_remove_dir_at(pd.fd, name) else |_| { e = "rmdir {o.path}" }
        e = step(c, "apply:{i}:renamed", "", e)
    } else {
        e = "unknown-action {o.action}"
    }
    if e == "" { e = walk.sync(pd) }
    walk.close(pd)
    step(c, "apply:{i}", "", e)
}

fn validate(c: Ctx, ops: List[intent.Op]) -> str {
    let logical = !c.privileged
    for o in ops {
        let live = walk.look_path(c.root, o.path, true)
        if live.kind == "error" { return live.error }
        if !matches(live, o.new, logical) { return "validate {o.path}" }
        if o.new.kind == "link" && !same_inode(c.root, o.path, o.new.target) {
            return "validate {o.path}"
        }
    }
    ""
}

fn accounts_consistent(c: Ctx, next: db.Db) -> str {
    if next.accounts.len == 0 { return "" }
    let passwd = lines_of(read_rel(c, "etc/passwd", 1048576))
    let group = lines_of(read_rel(c, "etc/group", 1048576))
    for a in next.accounts {
        var user = false
        var grp = false
        for l in passwd {
            let f = text.split(l, ":")
            if f.len >= 4 && f[0] == a.name && f[2] == "{a.uid}" && f[3] == "{a.gid}" {
                user = true
            }
        }
        for l in group {
            let f = text.split(l, ":")
            if f.len >= 3 && f[2] == "{a.gid}" { grp = true }
        }
        if !user || !grp { return "account-inconsistent {a.name}" }
    }
    ""
}

// ------------------------------------------------------------------ staging, backups

fn stage_one(c: Ctx, t: str, p: Pkg) -> str {
    let sd = walk.dir(c.root, "{tx_rel(t)}/stage")
    if sd.error != "" { return sd.error }
    var e = mkdir_in(sd, p.name)
    walk.close(sd)
    if e != "" { return e }
    let rel = "{tx_rel(t)}/stage/{p.name}"
    let held = walk.dir(c.root, rel)
    if held.error != "" { return held.error }
    let path = "{c.root.path}/{rel}"
    let s = fs_lstat(path) else |_| { walk.close(held); return "path-race {rel}" }
    let h = fs_fstat_record(held.fd) else |_| { walk.close(held); return "path-race {rel}" }
    walk.close(held)
    if s[9] != h[9] || s[10] != h[10] { return "path-race {rel}" }
    let fd = fs_open_mode(p.payload, 21) else |_| { return "stage-open {p.name}" }
    let st = fs_fstat(fd) else |_| { fs_close(fd) else |_| {}; return "stage-open {p.name}" }
    if st[0] != 0 ||
        st[1] != p.payload_length ||
        walk.digest_fd(fd, p.payload_length) != p.payload_sha256 {
        fs_close(fd) else |_| {}
        return "payload-hash {p.name}"
    }
    let pos = fs_seek(fd, 0, 0) else |_| { -1 }
    if pos != 0 { fs_close(fd) else |_| {}; return "payload-seek {p.name}" }
    var stream = payload.Stream { fd, pos: 0, length: p.payload_length, error: "" }
    let inv = payload.inspect(mut stream)
    if inv.error != "" { fs_close(fd) else |_| {}; return "{p.name}: {inv.error}" }
    let d = literal.parse(p.bytes)
    let m = staging.manifest(inv.entries, d)
    if m != "" { fs_close(fd) else |_| {}; return "{p.name}: {m}" }
    e = staging.stage_private(fd, inv.entries, path)
    fs_close(fd) else |_| {}
    if e != "" { return "{p.name}: {e}" }
    ""
}

fn backup_one(c: Ctx, t: str, o: intent.Op) -> str {
    let bd = walk.dir(c.root, "{tx_rel(t)}/backup")
    if bd.error != "" { return bd.error }
    let pd = walk.dir(c.root, walk.parent_of(o.path))
    if pd.error != "" { walk.close(bd); return pd.error }
    let input = fs_open_at(pd.fd, walk.base_of(o.path), 21, 0) else |_| { -1 }
    walk.close(pd)
    if input < 0 { walk.close(bd); return "backup-open {o.path}" }
    let out = fs_open_at(bd.fd, "{o.index}", 20, 384) else |_| { -1 }
    if out < 0 {
        fs_close(input) else |_| {}
        walk.close(bd)
        return "backup-create {o.index}"
    }
    var e = ""
    let h = walk.copy_fd(input, out, o.old.length)
    if walk.copy_failed(h) {
        e = "backup-write {o.index}{walk.copy_why(h)}"
    } else if h != o.old.sha256 {
        e = "live-changed {o.path}"
    }
    if e == "" { fs_sync(out) else |_| { e = walk.because("backup-sync {o.index}") } }
    fs_close(out) else |_| { e = "backup-close {o.index}" }
    fs_close(input) else |_| {}
    walk.close(bd)
    e
}

// ------------------------------------------------------------------ cleanup and undo

/// Remove a transaction's directory contents and the directory itself (X6 finish).
fn cleanup(c: Ctx, t: str, prefix: str) -> str {
    let td = walk.dir(c.root, tx_rel(t))
    if td.error != "" {
        if !walk.missing(td) { return td.error }
    } else {
        var e = walk.remove_tree(td, "backup")
        if e == "" { e = walk.sync(td) }
        e = step(c, "{prefix}cleanup:backup", "", e)
        if e == "" { e = walk.remove_tree(td, "stage") }
        if e == "" { e = walk.sync(td) }
        e = step(c, "{prefix}cleanup:stage", "", e)
        if e == "" { e = remove_name(td, "intent") }
        if e == "" { e = remove_name(td, "intent.tmp") }
        if e == "" { e = walk.sync(td) }
        walk.close(td)
        e = step(c, "{prefix}cleanup:intent", "", e)
        if e != "" { return e }
    }
    let all = walk.dir(c.root, "{state()}/transactions")
    if all.error != "" { return all.error }
    var e = ""
    fs_remove_dir_at(all.fd, t) else |er| match er {
        not_found => {},
        _ => { e = "rmdir {tx_rel(t)}" },
    }
    if e == "" { e = walk.sync(all) }
    walk.close(all)
    step(c, "{prefix}cleanup:dir", "", e)
}

/// Remove an uncommitted generation and commit temp, then the whole transaction tree.
/// The intent goes first, and durably: removing the tree syncs each directory as it goes,
/// so a power cut inside it could leave the backups gone and the intent still there, and the
/// next rescue would try to undo again without them (rescue-missing-backup, found by the
/// power-cut witness). Without its intent, t<N> is one rescue discards: the live tree is
/// already the old one when this runs.
fn discard(c: Ctx, t: str, to: int, prefix: str) -> str {
    let td = walk.dir(c.root, tx_rel(t))
    if td.error == "" {
        var d = remove_name(td, "intent")
        if d == "" { d = remove_name(td, "intent.tmp") }
        if d == "" { d = walk.sync(td) }
        walk.close(td)
        d = step(c, "{prefix}cleanup:intent", "", d)
        if d != "" { return d }
    } else if !walk.missing(td) {
        return td.error
    }
    let s = walk.dir(c.root, state())
    if s.error != "" { return s.error }
    var e = remove_name(s, "current.{t}")
    if e == "" { e = walk.sync(s) }
    walk.close(s)
    if e != "" { return e }
    let g = walk.dir(c.root, "{state()}/generations")
    if g.error != "" { return g.error }
    let cur = current(c)
    if cur.error == "" && cur.generation != to {
        e = walk.remove_tree(g, "{to}")
        if e == "" { e = walk.sync(g) }
    }
    walk.close(g)
    e = step(c, "{prefix}generation", "", e)
    if e != "" { return e }
    let all = walk.dir(c.root, "{state()}/transactions")
    if all.error != "" { return all.error }
    e = walk.remove_tree(all, t)
    if e == "" { e = walk.sync(all) }
    walk.close(all)
    step(c, "{prefix}cleanup:dir", "", e)
}

fn remove_temps(c: Ctx, t: str, o: intent.Op) -> str {
    let pd = walk.dir(c.root, walk.parent_of(o.path))
    if pd.error != "" {
        if walk.missing(pd) { return "" }
        return pd.error
    }
    var e = remove_name(pd, ".larder-{t}-{o.index}")
    if e == "" { e = remove_name(pd, ".larder-{t}-u{o.index}") }
    if e == "" { e = walk.sync(pd) }
    walk.close(pd)
    e
}

fn restore(c: Ctx, t: str, o: intent.Op) -> str {
    let pd = walk.dir(c.root, walk.parent_of(o.path))
    if pd.error != "" { return "rescue-unknown-state {o.path} ({pd.error})" }
    let name = walk.base_of(o.path)
    let live = walk.look(c.root, pd, name, false)
    let tmp = ".larder-{t}-u{o.index}"
    var e = ""
    let w = o.old
    if w.kind == "absent" {
        if live.kind == "dir" {
            fs_remove_dir_at(pd.fd, name) else |_| {
                e = "rescue-unknown-state {o.path} (directory not empty)"
            }
        } else if live.kind != "absent" {
            fs_remove_at(pd.fd, name) else |_| { e = "remove {o.path}" }
        }
    } else if w.kind == "dir" {
        if live.kind == "absent" { e = mkdir_in(pd, name) }
        if e == "" {
            let fd = fs_open_at(pd.fd, name, 48, 0) else |_| { -1 }
            if fd < 0 {
                e = "rescue-unknown-state {o.path}"
            } else {
                e = set_meta(c, fd, w)
                if e == "" { fs_sync(fd) else |_| { e = walk.because("sync {o.path}") } }
                fs_close(fd) else |_| {}
            }
        }
    } else if w.kind == "symlink" {
        remove_name(pd, tmp)
        fs_symlink_at(w.target, pd.fd, tmp) else |_| { e = "symlink {o.path}" }
        if e == "" && c.privileged { e = walk.lchown(c.root, pd, tmp, w.uid, w.gid) }
        if e == "" { e = walk.rename(c.root, pd, tmp, name) }
    } else if w.kind == "file" {
        remove_name(pd, tmp)
        let bd = walk.dir(c.root, "{tx_rel(t)}/backup")
        if bd.error != "" {
            e = "rescue-missing-backup {o.path}"
        } else {
            let input = fs_open_at(bd.fd, "{o.index}", 21, 0) else |_| { -1 }
            walk.close(bd)
            let out = fs_open_at(pd.fd, tmp, 20, 384) else |_| { -1 }
            if input < 0 || out < 0 {
                e = "rescue-missing-backup {o.path}"
            } else {
                let h = walk.copy_fd(input, out, w.length)
                if walk.copy_failed(h) {
                    e = "restore-write {o.path}{walk.copy_why(h)}"
                } else if h != w.sha256 {
                    e = "rescue-missing-backup {o.path}"
                }
                if e == "" { e = set_meta(c, out, w) }
                if e == "" { fs_sync(out) else |_| { e = walk.because("sync {o.path}") } }
            }
            if input >= 0 { fs_close(input) else |_| {} }
            if out >= 0 { fs_close(out) else |_| {} }
            if e == "" { e = walk.rename(c.root, pd, tmp, name) }
        }
    }
    if e == "" { e = walk.sync(pd) }
    walk.close(pd)
    e
}

fn relink(c: Ctx, t: str, o: intent.Op) -> str {
    if same_inode(c.root, o.path, o.old.target) { return "" }
    let pd = walk.dir(c.root, walk.parent_of(o.path))
    if pd.error != "" { return "rescue-unknown-state {o.path} ({pd.error})" }
    let sd = walk.dir(c.root, walk.parent_of(o.old.target))
    if sd.error != "" { walk.close(pd); return "rescue-unknown-state {o.old.target}" }
    let tmp = ".larder-{t}-u{o.index}"
    remove_name(pd, tmp)
    var e = ""
    fs_link_at(sd.fd, walk.base_of(o.old.target), pd.fd, tmp, false) else |_| {
        e = "link {o.path}"
    }
    walk.close(sd)
    if e == "" { e = walk.rename(c.root, pd, tmp, walk.base_of(o.path)) }
    if e == "" { e = walk.sync(pd) }
    walk.close(pd)
    e
}

/// Undo an uncommitted transaction from its intent. Every operation is classified
/// before anything is written; an unknown identity refuses with zero writes.
pub fn undo(c: Ctx, it: intent.Intent) -> str {
    let t = it.transaction
    let logical = !c.privileged
    for o in it.ops {
        if !o.backup { continue }
        let b = walk.look_path(c.root, "{tx_rel(t)}/backup/{o.index}", true)
        if b.kind != "file" || b.sha256 != o.old.sha256 || b.length != o.old.length {
            return "rescue-missing-backup {o.path}"
        }
    }
    var states = List[str]()
    for o in it.ops {
        let live = walk.look_path(c.root, o.path, true)
        if live.kind == "error" { return "rescue-unknown-state {o.path} ({live.error})" }
        if matches(live, o.old, logical) {
            (mut states).push("old")
        } else if matches(live, o.new, logical) {
            (mut states).push("new")
        } else if o.old.kind == "link" && live.kind == "absent" {
            (mut states).push("new")
        } else {
            return "rescue-unknown-state {o.path}"
        }
    }
    var k = it.ops.len
    while k > 0 {
        k -= 1
        let o = copy it.ops[k]
        var e = remove_temps(c, t, o)
        if e == "" && states[k] == "new" && o.old.kind != "link" { e = restore(c, t, o) }
        e = step(c, "rescue:undo:{k}", "path={o.path}", e)
        if e != "" { return e }
    }
    for o in it.ops {
        if o.old.kind != "link" { continue }
        var e = relink(c, t, o)
        e = step(c, "rescue:relink:{o.index}", "", e)
        if e != "" { return e }
    }
    for o in it.ops {
        let live = walk.look_path(c.root, o.path, true)
        if !matches(live, o.old, logical) { return "rescue-unknown-state {o.path} (after undo)" }
        if o.old.kind == "link" && !same_inode(c.root, o.path, o.old.target) {
            return "rescue-unknown-state {o.path} (link)"
        }
    }
    discard(c, t, it.to, "rescue:")
}

/// Finish a committed transaction: only cleanup remains (X6).
pub fn finish(c: Ctx, t: str) -> str { cleanup(c, t, "rescue:") }

/// Discard a transaction whose intent never became durable: nothing live changed.
pub fn undo_unprepared(c: Ctx, t: str, to: int) -> str { discard(c, t, to, "rescue:") }

// ------------------------------------------------------------------ execute

/// Result of a transaction: the committed generation or the named failure.
pub struct Done { generation: int, error: str }

fn rollback(c: Ctx, t: str, to: int, durable: bool, error: str) -> Done {
    var e = ""
    if durable {
        let bytes = read_rel(c, "{tx_rel(t)}/intent", 268435456)
        let it = intent.parse(bytes)
        if it.error != "" { e = it.error } else { e = undo(c, it) }
    } else {
        e = discard(c, t, to, "rescue:")
    }
    if e != "" {
        return Done { generation: -1, error: "{error}; rollback refused: {e}; run lrd rescue" }
    }
    Done { generation: -1, error: "{error}; rolled back" }
}

/// Space and inodes for backups, staged payloads, new files and the records, with
/// 1 MiB of headroom; refused before the first durable step (pm00 R-pm00-10).
fn capacity(c: Ctx, p: Plan) -> str {
    var bytes = 1048576
    var inodes = 16
    for o in p.ops {
        if o.backup { bytes += o.old.length; inodes += 1 }
        if o.action == "put" || o.action == "mkdir" || o.action == "link" {
            bytes += o.new.length
            inodes += 1
        }
    }
    for pkg in p.stage { bytes += pkg.payload_length; inodes += pkg.recs.len + 1 }
    let sf = fs_statfs(c.root.path) else |_| { return "no-space: statfs refused" }
    let available = sf[5] * sf[2]
    if sf[0] / 32 % 2 == 1 && bytes > available {
        return "no-space: need {bytes} bytes, {available} available"
    }
    if sf[0] / 128 % 2 == 1 && inodes > sf[7] {
        return "no-space: need {inodes} inodes, {sf[7]} free"
    }
    ""
}

/// Take every durable step of section 2 for plan p from generation from.
pub fn execute(c: Ctx, p: Plan, from: int) -> Done {
    let to = from + 1
    let t = "t{to}"
    var room = capacity(c, p)
    room = step(c, "capacity", "", room)
    if room != "" { return Done { generation: -1, error: room } }
    let all = walk.dir(c.root, "{state()}/transactions")
    if all.error != "" { return Done { generation: -1, error: all.error } }
    var e = mkdir_in(all, t)
    if e == "" { e = walk.sync(all) }
    walk.close(all)
    if e != "" { return Done { generation: -1, error: e } }
    let td = walk.dir(c.root, tx_rel(t))
    if td.error != "" { return rollback(c, t, to, false, td.error) }
    e = mkdir_in(td, "stage")
    if e == "" { e = mkdir_in(td, "backup") }
    if e == "" { e = walk.sync(td) }
    walk.close(td)
    if e != "" { return rollback(c, t, to, false, e) }
    for pkg in p.stage {
        e = stage_one(c, t, pkg)
        if e != "" { return rollback(c, t, to, false, "stage: {e}") }
    }
    e = step(c, "stage", "", "")
    if e != "" { return rollback(c, t, to, false, e) }
    for o in p.ops {
        if !o.backup { continue }
        e = backup_one(c, t, o)
        e = step(c, "backup:{o.index}", "path={o.path}", e)
        if e != "" { return rollback(c, t, to, false, e) }
    }
    let bd = walk.dir(c.root, "{tx_rel(t)}/backup")
    if bd.error != "" { return rollback(c, t, to, false, bd.error) }
    e = walk.sync(bd)
    walk.close(bd)
    if e != "" { return rollback(c, t, to, false, e) }
    // The next generation's bytes are fixed now so the intent can bind them.
    let db_text = db.render(p.next)
    let db_bytes = db_text.bytes()
    let it = intent.Intent {
        transaction: t,
        from,
        to,
        database: sha2.to_hex(sha2.sum256(db_bytes)),
        ops: copy p.ops,
        error: "",
    }
    let td2 = walk.dir(c.root, tx_rel(t))
    if td2.error != "" { return rollback(c, t, to, false, td2.error) }
    e = write_new(td2, "intent.tmp", intent.render(it), 384)
    e = step(c, "intent-written", "", e)
    if e != "" { walk.close(td2); return rollback(c, t, to, false, e) }
    e = walk.rename(c.root, td2, "intent.tmp", "intent")
    if e == "" { e = walk.sync(td2) }
    walk.close(td2)
    if e != "" { return rollback(c, t, to, false, e) }
    let all2 = walk.dir(c.root, "{state()}/transactions")
    if all2.error == "" { e = walk.sync(all2); walk.close(all2) } else { e = all2.error }
    e = step(c, "intent", "", e)
    if e != "" { return rollback(c, t, to, true, e) }
    for k in 0..p.ops.len {
        e = apply_one(c, t, p.ops[k], p.sources[k])
        if e != "" { return rollback(c, t, to, true, e) }
    }
    e = validate(c, p.ops)
    if e == "" { e = accounts_consistent(c, p.next) }
    if e != "" { return rollback(c, t, to, true, e) }
    // Generation N: manifests by digest, then db.lrd, all synced.
    let gens = walk.dir(c.root, "{state()}/generations")
    if gens.error != "" { return rollback(c, t, to, true, gens.error) }
    e = mkdir_in(gens, "{to}")
    if e != "" { walk.close(gens); return rollback(c, t, to, true, e) }
    let g = walk.dir(c.root, "{state()}/generations/{to}")
    if g.error != "" { walk.close(gens); return rollback(c, t, to, true, g.error) }
    e = mkdir_in(g, "manifests")
    let md = walk.dir(c.root, "{state()}/generations/{to}/manifests")
    if e == "" && md.error != "" { e = md.error }
    if e == "" {
        for pkg in p.packages {
            e = write_new(md, pkg.digest, pkg.bytes, 420)
            if e != "" { break }
        }
    }
    if e == "" { e = walk.sync(md) }
    walk.close(md)
    if e == "" { e = write_new(g, "db.lrd", db_bytes, 420) }
    if e == "" { fs_set_mode_fd(g.fd, 493) else |_| { e = "mode generation" } }
    if e == "" { e = walk.sync(g) }
    walk.close(g)
    if e == "" { e = walk.sync(gens) }
    walk.close(gens)
    e = step(c, "generation", "", e)
    if e != "" { return rollback(c, t, to, true, e) }
    // The commit decision.
    let record = db.render_current(db.
        Current { generation: to, database: it.database, transaction: t, error: "" })
    let sdir = walk.dir(c.root, state())
    if sdir.error != "" { return rollback(c, t, to, true, sdir.error) }
    e = write_new(sdir, "current.{t}", record.bytes(), 384)
    e = step(c, "commit-written", "", e)
    if e != "" { walk.close(sdir); return rollback(c, t, to, true, e) }
    e = walk.rename(c.root, sdir, "current.{t}", "current")
    if e != "" { walk.close(sdir); return rollback(c, t, to, true, e) }
    let renamed = hook(c, "commit-renamed", "")
    if renamed != "" {
        walk.close(sdir)
        return Done {
            generation: to,
            error: "commit-renamed: {renamed}; committed generation {to}; run lrd rescue to finish",
        }
    }
    e = walk.sync(sdir)
    walk.close(sdir)
    e = step(c, "commit", "", e)
    if e != "" {
        return Done {
            generation: to,
            error: "{e}; committed generation {to}; run lrd rescue to finish",
        }
    }
    e = cleanup(c, t, "")
    if e != "" {
        return Done {
            generation: to,
            error: "{e}; committed generation {to}; run lrd rescue to finish",
        }
    }
    e = step(c, "done", "", "")
    if e != "" { return Done { generation: to, error: "{e}; committed generation {to}" } }
    Done { generation: to, error: "" }
}
