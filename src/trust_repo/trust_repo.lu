//! Test-only file repository publication. Timestamp is the only replaceable output.

use trust_options as options
use trust_writer as writer
use trust_metadata as meta
use trust_json as json
use trust_io as io
use trust_inspect as inspect
use trust_cache as cache
use trust_client as client
use trust_store as store
use transport
use failpoint
use literal
use schema
use std.hex as hex
use std.x.crypto.curve25519 as curve

/// Loaded test-only signing material, never accepted without its marker and mode.
pub struct Keys { values: List[writer.Signing], error: str }

fn names() -> List[str] { ["root1", "root2", "root3", "targets", "snapshot", "timestamp"] }

/// Load six marked 0600 key files from a private directory.
pub fn load_keys(dir: str) -> Keys {
    var out = Keys { values: List[writer.Signing](), error: io.private_dir(dir) }
    if out.error != "" { return out }
    for name in names() {
        let path = "{dir}/{name}.test-only.key"
        let stat = fs_lstat(path) else |_| { out.error = "test-key-file"; return out }
        if stat[0] != 0 || stat[4] != 384 { out.error = "test-key-mode"; return out }
        let input = io.read(path, 4096)
        if input.error != "" { out.error = input.error; return out }
        let d = json.parse(input.bytes)
        let marker = json.field(d, 0, "test-only")
        if d.error != "" ||
            marker < 0 ||
            d.nodes[marker].kind != "bool" ||
            d.nodes[marker].number != 1 {
            out.error = "Real repository keys require a constant-time signing review and a production key ceremony"
            return out
        }
        let seed_hex = meta.text(d, 0, "seed")
        if !schema.digest(seed_hex) { out.error = "test-key-seed"; return out }
        let seed = hex.decode(seed_hex) else List[byte]()
        let key = writer.test_key(seed)
        if key.public != meta.text(d, 0, "public") { out.error = "test-key-public"; return out }
        (mut out.values).push(key)
    }
    out
}

fn keygen(dir: str) -> str {
    if dir == "" { return "missing-keys-directory" }
    let error = cache.directory(dir)
    if error != "" { return error }
    let lock = io.lock(dir)
    if lock < 0 { return "keys-locked" }
    var result = ""
    for name in names() {
        let randomness = os_random(32)
        var seed = List[byte]()
        for b in randomness { (mut seed).push(b as byte) }
        let key = writer.test_key(seed)
        let seed_hex = hex.encode(seed)
        let body = "{{\"public\":\"{key.public}\",\"seed\":\"{seed_hex}\",\"test-only\":true}}"
        let bytes = body.bytes()
        let path = "{dir}/{name}.test-only.key"
        result = io.create(path, bytes)
        if result != "" { break }
        fs_set_mode(path, 384) else |_| { result = "test-key-mode" }
        if result != "" { break }
    }
    fs_sync_dir(dir) else |_| { result = "state-dir-sync" }
    fs_close(lock) else |_| { result = "state-close" }
    result
}

fn write_metadata(repo: str, text: str, role: str, version: int) -> str {
    if text == "" { return "metadata-encoding" }
    let bytes = text.bytes()
    let m = meta.parse(bytes, role)
    if m.error != "" { return m.error }
    if m.version != version { return "metadata-version" }
    let error = io.create_public("{repo}/metadata/{version}.{role}.json", bytes)
    if error != "" { return error }
    fs_sync_dir("{repo}/metadata") else |_| { return "state-dir-sync" }
    ""
}

fn initialize(repo: str, keys: Keys, o: options.Options, now: int) -> str {
    let expires = options.expiry(o, "--root-validity", 31536000, now)
    let text = writer.root(keys.values, keys.values[0..3], 1, expires)
    write_metadata(repo, text, "root", 1)
}

fn rotate(repo: str, keys: Keys, o: options.Options, now: int) -> str {
    let v = options.integer(options.flag_value(o, "--version"))
    if v < 2 { return "root-version" }
    let old = load_keys(options.flag_value(o, "--old-keys"))
    if old.error != "" { return old.error }
    let input = io.read("{repo}/metadata/{v - 1}.root.json", 65536)
    if input.error != "" { return input.error }
    let old_root = meta.parse(input.bytes, "root")
    if old_root.error != "" { return old_root.error }
    var signers = old.values[0..3]
    for key in keys.values[0..3] { (mut signers).push(key) }
    let text = writer.root(
        keys.values,
        signers,
        v,
        options.expiry(o, "--root-validity", 31536000, now),
    )
    let bytes = text.bytes()
    let candidate = meta.parse(bytes, "root")
    if candidate.error != "" { return candidate.error }
    if meta.verify(candidate, old_root, "root") != "" { return "root-old-threshold" }
    if meta.verify(candidate, candidate, "root") != "" { return "root-new-threshold" }
    write_metadata(repo, text, "root", v)
}

fn add_file(repo: str, source: str, e: meta.Entry) -> str {
    let path = "{repo}/targets/{e.digest}.{e.path}"
    let old = fs_lstat(path) else |error| match error {
        not_found => { List[int]() },
        _ => { return "target-file" },
    }
    if old.len != 0 {
        // Referencing an already verified immutable object is not rewriting it.
        let measured = cache.measure(path, e.length)
        if measured.error != "" || measured.length != e.length || measured.digest != e.digest {
            return "immutable-rewrite"
        }
        return ""
    }
    cache.copy_verified(source, path, e)
}

/// Staged target entries, or the refusal that stopped the staging.
pub struct Staged { entries: List[meta.Entry], error: str }

/// Copy each manifest, its payload and its buildinfo create-only into repo/targets, and list their entries.
fn stage_entries(repo: str, o: options.Options) -> Staged {
    var entries = List[meta.Entry]()
    for i in 0..o.manifests.len {
        let source = o.manifests[i]
        let input = io.read(source, 1048576)
        if input.error != "" { return Staged { entries: List[meta.Entry](), error: input.error } }
        let d = literal.parse(input.bytes)
        if d.error != "" { return Staged { entries: List[meta.Entry](), error: d.error } }
        let error = schema.manifest(d, 0)
        if error != "" { return Staged { entries: List[meta.Entry](), error } }
        let name = schema.string(d, 0, "name")
        let version = schema.string(d, 0, "version")
        let arch = schema.string(d, 0, "arch")
        if !source.ends_with(".manifest") {
            return Staged { entries: List[meta.Entry](), error: "target-kind" }
        }
        let payload = source[0..source.len - 9] + ".payload.tar"
        let paths = [source, payload, o.buildinfos[i]]
        let kinds = ["manifest", "payload", "buildinfo"]
        let suffixes = ["manifest", "payload.tar", "buildinfo"]
        for j in 0..3 {
            let path = paths[j]
            let measured = cache.measure(path, 17179869184)
            if measured.error != "" {
                return Staged { entries: List[meta.Entry](), error: measured.error }
            }
            if j == 2 && measured.digest != schema.string(d, 0, "buildinfo") {
                return Staged { entries: List[meta.Entry](), error: "buildinfo-hash" }
            }
            let e = meta.Entry {
                path: "{name}-{version}.{suffixes[j]}",
                digest: measured.digest,
                length: measured.length,
                version: 0,
                name: copy name,
                package_version: copy version,
                arch: copy arch,
                kind: kinds[j],
            }
            if !meta.logical(e.path) {
                return Staged { entries: List[meta.Entry](), error: "logical-name" }
            }
            let copied = add_file(repo, path, e)
            if copied != "" { return Staged { entries: List[meta.Entry](), error: copied } }
            (mut entries).push(e)
        }
    }
    Staged { entries, error: "" }
}

fn publish(repo: str, keys: Keys, o: options.Options, now: int) -> str {
    let v = options.integer(options.flag_value(o, "--version"))
    if v < 1 { return "metadata-version" }
    if o.manifests.len != o.buildinfos.len { return "target-incomplete" }
    var root_version = 1
    if options.flag_value(o, "--root-version") != "" {
        root_version = options.integer(options.flag_value(o, "--root-version"))
    }
    if root_version < 1 || root_version == 9223372036854775807 { return "root-version" }
    if fs_exists("{repo}/metadata/{root_version + 1}.root.json") { return "publish-root-stale" }
    let root_input = io.read("{repo}/metadata/{root_version}.root.json", 65536)
    if root_input.error != "" { return root_input.error }
    let root = meta.parse(root_input.bytes, "root")
    if root.error != "" || meta.verify(root, root, "root") != "" { return "publish-root" }
    if root.expires <= now { return "expired-root" }
    let staged = stage_entries(repo, o)
    if staged.error != "" { return staged.error }
    let entries = copy staged.entries
    fs_sync_dir("{repo}/targets") else |_| { return "state-dir-sync" }
    let targets_text = writer.targets(
        entries,
        v,
        options.expiry(o, "--targets-validity", 7776000, now),
        keys.values[3],
    )
    let targets_bytes = targets_text.bytes()
    let targets = meta.parse(targets_bytes, "targets")
    let target_auth = meta.verify(targets, root, "targets")
    if target_auth != "" { return target_auth }
    let targets_ref = meta.Entry {
        path: "targets.json",
        digest: meta.digest(targets_bytes),
        length: targets_bytes.len,
        version: v,
        name: "",
        package_version: "",
        arch: "",
        kind: "",
    }
    let snapshot_text = writer.reference(
        "snapshot",
        v,
        options.expiry(o, "--snapshot-validity", 1209600, now),
        targets_ref,
        keys.values[4],
    )
    let snapshot_bytes = snapshot_text.bytes()
    let snapshot = meta.parse(snapshot_bytes, "snapshot")
    let snapshot_auth = meta.verify(snapshot, root, "snapshot")
    if snapshot_auth != "" { return snapshot_auth }
    let snapshot_ref = meta.Entry {
        path: "snapshot.json",
        digest: meta.digest(snapshot_bytes),
        length: snapshot_bytes.len,
        version: v,
        name: "",
        package_version: "",
        arch: "",
        kind: "",
    }
    let timestamp_text = writer.reference(
        "timestamp",
        v,
        options.expiry(o, "--timestamp-validity", 172800, now),
        snapshot_ref,
        keys.values[5],
    )
    let timestamp_bytes = timestamp_text.bytes()
    let timestamp = meta.parse(timestamp_bytes, "timestamp")
    let timestamp_auth = meta.verify(timestamp, root, "timestamp")
    if timestamp_auth != "" { return timestamp_auth }
    let old = io.read("{repo}/metadata/timestamp.json", 16384)
    if old.error == "" {
        let previous = meta.parse(old.bytes, "timestamp")
        if previous.error != "" { return previous.error }
        if meta.verify(previous, root, "timestamp") == "" && previous.version >= v {
            return "publish-version"
        }
    } else if old.error != "not-found" {
        return old.error
    }
    let target_written = write_metadata(repo, targets_text, "targets", v)
    if target_written != "" { return target_written }
    let snapshot_written = write_metadata(repo, snapshot_text, "snapshot", v)
    if snapshot_written != "" { return snapshot_written }
    io.replace_public("{repo}/metadata", "timestamp.json", "timestamp.{v}.next", timestamp_bytes)
}

/// `signed` bytes wrapped in an envelope with no signatures, so one parser reads both.
fn wrap(signed: List[byte]) -> List[byte] {
    var out = "{{\"signatures\":[],\"signed\":".bytes()
    for b in signed { (mut out).push(b) }
    (mut out).push(125 as byte)
    out
}

fn parse_any(bytes: List[byte]) -> meta.Meta {
    var m = meta.absent("root")
    for role in ["root", "timestamp", "snapshot", "targets"] {
        m = meta.parse(bytes, role)
        if m.error != "role-type" { return m }
    }
    m
}

fn public_of(o: options.Options, flag: str) -> inspect.PublicKey {
    let path = options.flag_value(o, flag)
    if path == "" { return inspect.PublicKey { public: "", error: "role-keys" } }
    inspect.read_public(path)
}

/// Write the bytes a root's signers will sign, from public keys alone. Prints the roles and the digest.
fn draft_root(o: options.Options, now: int) -> str {
    let version = options.integer(options.flag_value(o, "--version"))
    if version < 1 { return "root-version" }
    let expires = meta.utc(options.flag_value(o, "--expires"))
    if expires < 0 { return "metadata-time" }
    var roots = List[str]()
    for path in o.root_keys {
        let key = inspect.read_public(path)
        if key.error != "" { return key.error }
        (mut roots).push(key.public)
    }
    let threshold = options.integer(options.flag_value(o, "--root-threshold"))
    if threshold < 1 { return "threshold" }
    let targets = public_of(o, "--targets-key")
    if targets.error != "" { return targets.error }
    let snapshot = public_of(o, "--snapshot-key")
    if snapshot.error != "" { return snapshot.error }
    let timestamp = public_of(o, "--timestamp-key")
    if timestamp.error != "" { return timestamp.error }
    let out = options.flag_value(o, "--out")
    if out == "" { return "missing-option-value" }
    let signed = writer.root_signed(
        version,
        expires,
        roots,
        threshold,
        targets.public,
        snapshot.public,
        timestamp.public,
    )
    if signed == "" { return "metadata-encoding" }
    let bytes = signed.bytes()
    let m = meta.parse(wrap(bytes), "root")
    if m.error != "" { return m.error }
    if m.expires <= now { return "expired-root" }
    var added = List[str]()
    var removed = List[str]()
    let previous_path = options.flag_value(o, "--previous")
    if previous_path != "" {
        let input = io.read(previous_path, 65536)
        if input.error != "" { return input.error }
        let previous = meta.parse(input.bytes, "root")
        if previous.error != "" { return previous.error }
        if m.version != previous.version + 1 { return "root-version" }
        for key in m.keys {
            var known = false
            for old in previous.keys { if old.id == key.id { known = true } }
            if !known { (mut added).push(copy key.id) }
        }
        for old in previous.keys {
            var kept = false
            for key in m.keys { if old.id == key.id { kept = true } }
            if !kept { (mut removed).push(copy old.id) }
        }
    }
    let error = io.create(out, bytes)
    if error != "" { return error }
    print("version {m.version}")
    print("expires {writer.date(m.expires)}")
    for r in m.roles {
        var ids = ""
        for id in r.keys { ids = "{ids} {id}" }
        print("role {r.name} threshold {r.threshold}{ids}")
    }
    for id in added { print("added {id}") }
    for id in removed { print("removed {id}") }
    print("sha256 {meta.digest(bytes)}")
    print("length {bytes.len}")
    ""
}

/// Attach detached Ed25519 signatures to signed bytes, after checking each against the key it claims.
fn attach(o: options.Options) -> str {
    let signed_in = io.read(options.flag_value(o, "--signed"), 1048576)
    if signed_in.error != "" { return signed_in.error }
    let m = parse_any(wrap(signed_in.bytes))
    if m.error != "" { return m.error }
    var defining = copy m
    if m.role != "root" {
        let root_path = options.flag_value(o, "--root")
        if root_path == "" { return "root-required" }
        let input = io.read(root_path, 65536)
        if input.error != "" { return input.error }
        defining = meta.parse(input.bytes, "root")
        if defining.error != "" { return defining.error }
    }
    var previous = meta.absent("root")
    var has_previous = false
    let previous_path = options.flag_value(o, "--previous")
    if previous_path != "" {
        let input = io.read(previous_path, 65536)
        if input.error != "" { return input.error }
        previous = meta.parse(input.bytes, "root")
        if previous.error != "" { return previous.error }
        has_previous = true
    }
    let ri = meta.role_index(defining, m.role)
    if ri < 0 { return "role-keys" }
    var pi = -1
    if has_previous { pi = meta.role_index(previous, "root") }
    let pairs = copy o.signatures
    if pairs.len == 0 { return "threshold-not-met" }
    var ids = List[str]()
    var sigs = List[str]()
    var by_new = 0
    var by_old = 0
    for pair in pairs {
        let eq = pair.find("=") else { return "key-malformed" }
        let key = inspect.read_public(pair[0..eq])
        if key.error != "" { return key.error }
        let id = meta.digest(writer.key_object(key.public).bytes())
        for seen in ids { if seen == id { return "duplicate-signature" } }
        let raw = io.read(pair[eq + 1..], 65)
        if raw.error == "metadata-byte-limit" || raw.error == "" && raw.bytes.len != 64 {
            return "signature-length"
        }
        if raw.error != "" { return raw.error }
        var in_new = false
        for expected in defining.roles[ri].keys { if expected == id { in_new = true } }
        var in_old = false
        if pi >= 0 {
            for expected in previous.roles[pi].keys { if expected == id { in_old = true } }
        }
        if !in_new && !in_old { return "unknown-signer" }
        let public = hex.decode(key.public) else List[byte]()
        if !curve.verify_strict(public, signed_in.bytes, raw.bytes) { return "bad-signature" }
        if in_new { by_new += 1 }
        if in_old { by_old += 1 }
        (mut ids).push(id)
        (mut sigs).push(hex.encode(raw.bytes))
    }
    if by_new < defining.roles[ri].threshold { return "threshold-not-met" }
    if pi >= 0 && by_old < previous.roles[pi].threshold { return "previous-threshold-not-met" }
    let out = options.flag_value(o, "--out")
    if out == "" { return "missing-option-value" }
    let envelope = writer.attached(str_from_utf8(signed_in.bytes) else "", ids, sigs)
    let bytes = envelope.bytes()
    let check = meta.parse(bytes, m.role)
    if check.error != "" { return check.error }
    var verdict = ""
    if m.role == "root" {
        verdict = meta.verify(check, check, "root")
    } else {
        verdict = meta.verify(check, defining, m.role)
    }
    if verdict != "" { return verdict }
    let error = io.create(out, bytes)
    if error != "" { return error }
    print("role {m.role}")
    print("signatures {ids.len}")
    print("sha256 {meta.digest(bytes)}")
    ""
}

/// Stage a batch's objects create-only and write the targets bytes its signer will sign.
fn draft_targets(repo: str, o: options.Options, now: int) -> str {
    let version = options.integer(options.flag_value(o, "--version"))
    if version < 1 { return "metadata-version" }
    let expires = meta.utc(options.flag_value(o, "--expires"))
    if expires < 0 { return "metadata-time" }
    if o.manifests.len != o.buildinfos.len || o.manifests.len == 0 { return "target-incomplete" }
    let out = options.flag_value(o, "--out")
    if out == "" { return "missing-option-value" }
    let staged = stage_entries(repo, o)
    if staged.error != "" { return staged.error }
    fs_sync_dir("{repo}/targets") else |_| { return "state-dir-sync" }
    let signed = writer.targets_signed(staged.entries, version, expires)
    if signed == "" { return "metadata-encoding" }
    let bytes = signed.bytes()
    let m = meta.parse(wrap(bytes), "targets")
    if m.error != "" { return m.error }
    let error = io.create(out, bytes)
    if error != "" { return error }
    for e in m.entries {
        print("target {e.name} {e.package_version} {e.kind} {e.length} {e.digest}")
    }
    print("version {m.version}")
    print("expires {writer.date(m.expires)}")
    print("sha256 {meta.digest(bytes)}")
    ""
}

/// The newest root in a docroot's metadata directory, or an absent root saying why.
fn latest_root(repo: str) -> meta.Meta {
    var best = meta.absent("root")
    best.error = "not-found"
    for v in 1..1000 {
        let input = io.read("{repo}/metadata/{v}.root.json", 65536)
        if input.error != "" { break }
        best = meta.parse(input.bytes, "root")
    }
    best
}

fn docroot(o: options.Options) -> str {
    let raw = options.file_path(options.flag_value(o, "--repo"))
    if raw == "" { return "" }
    fs_realpath(raw) else ""
}

/// The bytes a snapshot or timestamp signer will sign: a reference to the newest file of the role below it.
fn draft_reference(role: str, o: options.Options, now: int) -> str {
    let repo = docroot(o)
    if repo == "" { return "unsupported-transport" }
    let version = options.integer(options.flag_value(o, "--version"))
    if version < 1 { return "metadata-version" }
    var below = "targets"
    var flag = "--targets-version"
    var file = "targets.json"
    if role == "timestamp" {
        below = "snapshot"
        flag = "--snapshot-version"
        file = "snapshot.json"
    }
    let below_version = options.integer(options.flag_value(o, flag))
    if below_version < 1 { return "metadata-version" }
    let expires = meta.utc(options.flag_value(o, "--expires"))
    if expires < 0 { return "metadata-time" }
    let out = options.flag_value(o, "--out")
    if out == "" { return "missing-option-value" }
    let root = latest_root(repo)
    if root.error != "" { return root.error }
    let input = io.read("{repo}/metadata/{below_version}.{below}.json", 1048576 + 65536)
    if input.error != "" { return input.error }
    let m = meta.parse(input.bytes, below)
    if m.error != "" { return m.error }
    if m.version != below_version { return "metadata-version" }
    let auth = meta.verify(m, root, below)
    if auth != "" { return auth }
    let ref = meta.Entry {
        path: file,
        digest: meta.digest(input.bytes),
        length: input.bytes.len,
        version: below_version,
        name: "",
        package_version: "",
        arch: "",
        kind: "",
    }
    let signed = writer.reference_signed(role, version, expires, ref)
    if signed == "" { return "metadata-encoding" }
    let bytes = signed.bytes()
    let d = meta.parse(wrap(bytes), role)
    if d.error != "" { return d.error }
    if d.expires <= now { return "expired-{role}" }
    let error = io.create(out, bytes)
    if error != "" { return error }
    print("references {file} {below_version} {ref.length} {ref.digest}")
    print("version {version}")
    print("expires {writer.date(d.expires)}")
    print("sha256 {meta.digest(bytes)}")
    print("length {bytes.len}")
    ""
}

/// One envelope read for a commit.
struct Item { bytes: List[byte], m: meta.Meta }

fn ordered(items: List[Item], role: str) -> List[int] {
    var order = List[int]()
    for i in 0..items.len { if items[i].m.role == role { (mut order).push(i) } }
    for i in 0..order.len {
        for j in i + 1..order.len {
            if items[order[j]].m.version < items[order[i]].m.version {
                let old = order[i]
                order[i] = order[j]
                order[j] = old
            }
        }
    }
    order
}

fn referenced(repo: str, items: List[Item], role: str, e: meta.Entry) -> str {
    // The file a reference names is either committed together with it or already in the docroot.
    var bytes = List[byte]()
    var found = false
    for i in 0..items.len {
        if items[i].m.role == role && items[i].m.version == e.version {
            bytes = copy items[i].bytes
            found = true
        }
    }
    if !found {
        let input = io.read("{repo}/metadata/{e.version}.{role}.json", 1048576 + 65536)
        if input.error != "" { return "commit-dangling" }
        bytes = copy input.bytes
    }
    if bytes.len != e.length || meta.digest(bytes) != e.digest { return "commit-dangling" }
    ""
}

/// "" when a versioned file is absent, "same" when the identical bytes are already there (a repeated commit
/// after an interruption), "immutable-rewrite" when other bytes are.
fn place(repo: str, role: str, version: int, bytes: List[byte]) -> str {
    let input = io.read("{repo}/metadata/{version}.{role}.json", 1048576 + 65536)
    if input.error == "not-found" { return "" }
    if input.error != "" { return input.error }
    if meta.digest(input.bytes) == meta.digest(bytes) { return "same" }
    "immutable-rewrite"
}

/// Place verified metadata into a docroot: roots, targets and snapshots create-only, then the timestamp replaced last.
/// Every file is checked before the first is written.
fn commit(repo: str, o: options.Options, now: int, f: failpoint.Fail) -> str {
    if o.adds.len == 0 { return "commit-empty" }
    var items = List[Item]()
    for path in o.adds {
        let input = io.read(path, 1048576 + 65536)
        if input.error != "" { return input.error }
        let m = parse_any(input.bytes)
        if m.error != "" { return m.error }
        (mut items).push(Item { bytes: copy input.bytes, m: copy m })
    }
    var current = latest_root(repo)
    for i in ordered(items, "root") {
        let m = copy items[i].m
        let self_check = meta.verify(m, m, "root")
        if self_check != "" { return self_check }
        let held = place(repo, "root", m.version, items[i].bytes)
        if held == "immutable-rewrite" { return held }
        if held == "same" {
            current = copy m
            continue
        }
        if held != "" { return held }
        if current.error == "" {
            if m.version != current.version + 1 { return "root-version" }
            let previous = meta.verify(m, current, "root")
            if previous != "" { return previous }
        } else if m.version != 1 {
            return "root-version"
        }
        current = copy m
    }
    if current.error != "" { return current.error }
    for role in ["targets", "snapshot"] {
        for i in ordered(items, role) {
            let m = copy items[i].m
            let auth = meta.verify(m, current, role)
            if auth != "" { return auth }
            let held = place(repo, role, m.version, items[i].bytes)
            if held != "" && held != "same" { return held }
            if role == "targets" {
                for e in m.entries {
                    let path = "{repo}/targets/{e.digest}.{e.path}"
                    let measured = cache.measure(path, e.length)
                    if measured.error != "" ||
                        measured.length != e.length ||
                        measured.digest != e.digest {
                        return "commit-dangling"
                    }
                }
            } else {
                let linked = referenced(repo, items, "targets", m.entries[0])
                if linked != "" { return linked }
            }
        }
    }
    let stamps = ordered(items, "timestamp")
    if stamps.len > 1 { return "publish-version" }
    var stamp = meta.absent("timestamp")
    if stamps.len == 1 {
        stamp = copy items[stamps[0]].m
        let auth = meta.verify(stamp, current, "timestamp")
        if auth != "" { return auth }
        if stamp.expires <= now { return "expired-timestamp" }
        let linked = referenced(repo, items, "snapshot", stamp.entries[0])
        if linked != "" { return linked }
        let old = io.read("{repo}/metadata/timestamp.json", 16384)
        if old.error == "" {
            let previous = meta.parse(old.bytes, "timestamp")
            if previous.error == "" &&
                meta.verify(previous, current, "timestamp") == "" &&
                previous.version >= stamp.version {
                return "publish-version"
            }
        } else if old.error != "not-found" {
            return old.error
        }
    }
    var writes = 0
    for role in ["root", "targets", "snapshot"] {
        for i in ordered(items, role) {
            if place(repo, role, items[i].m.version, items[i].bytes) == "same" { continue }
            let written = write_metadata(
                repo,
                str_from_utf8(items[i].bytes) else "",
                role,
                items[i].m.version,
            )
            if written != "" { return written }
            writes += 1
            let hit = failpoint.hit(f, "commit:{writes}", "{role} {items[i].m.version}")
            if hit != "" { return hit }
        }
    }
    let before = failpoint.hit(f, "commit:timestamp", "")
    if before != "" { return before }
    if stamps.len == 1 {
        let error = io.replace_public(
            "{repo}/metadata",
            "timestamp.json",
            "timestamp.{stamp.version}.next",
            items[stamps[0]].bytes,
        )
        if error != "" { return error }
    }
    fs_sync_dir("{repo}/metadata") else |_| { return "state-dir-sync" }
    let after = failpoint.hit(f, "commit:done", "")
    if after != "" { return after }
    print("committed {items.len}")
    ""
}

/// The whole repository through the client's own code: bootstrap from the pinned root, update, then read every
/// target it names into a scratch cache. State and cache are directories the caller names for this check.
fn verify_all(o: options.Options, now: int) -> str {
    let k = transport.shipped()
    var error = client.run("bootstrap", o, now, k)
    if error != "" { return error }
    error = client.run("update", o, now, k)
    if error != "" { return error }
    let state_dir = options.flag_value(o, "--state")
    let cache_dir = options.flag_value(o, "--cache")
    let url = options.flag_value(o, "--repo")
    let loaded = store.load(state_dir)
    if loaded.error != "" { return loaded.error }
    var count = 0
    for e in loaded.value.targets.entries {
        if !meta.known_kind(e.kind) { continue }
        let one = options.parse(
            [
                "--repo",
                copy url,
                "--state",
                copy state_dir,
                "--cache",
                copy cache_dir,
                "--target",
                copy e.path,
            ],
            0,
        )
        if one.error != "" { return one.error }
        error = client.run("fetch", one, now, k)
        if error != "" { return error }
        count += 1
    }
    print("verified targets {count}")
    ""
}

fn esc(text: str) -> str {
    text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

fn sort_names(names: List[str]) -> List[str] {
    var out = copy names
    for i in 0..out.len {
        for j in i + 1..out.len {
            if json.before(out[j], out[i]) {
                let old = copy out[i]
                out[i] = copy out[j]
                out[j] = old
            }
        }
    }
    out
}

fn safe_base(base: str) -> bool {
    if !base.starts_with("/") || !base.ends_with("/") || base.len > 64 { return false }
    for b in base.bytes() {
        let c = b as int
        let alnum = c >= 48 && c <= 57 || c >= 97 && c <= 122 || c >= 65 && c <= 90
        if !alnum && c != 47 && c != 45 && c != 95 && c != 46 { return false }
    }
    true
}

/// A file a verified role names, read from the docroot and checked against the reference that names it.
fn named_file(repo: str, role: str, e: meta.Entry) -> meta.Meta {
    var m = meta.absent(role)
    let input = io.read("{repo}/metadata/{e.version}.{role}.json", 1048576 + 65536)
    if input.error != "" { m.error = input.error; return m }
    if input.bytes.len != e.length { m.error = "metadata-length"; return m }
    if meta.digest(input.bytes) != e.digest { m.error = "metadata-hash"; return m }
    meta.parse(input.bytes, role)
}

fn page_head(title: str) -> str {
    "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>{esc(title)}</title></head><body>\n"
}

/// Static pages for a repository that verifies: a front page and one page per package, written create-only.
fn index_pages(o: options.Options, now: int) -> str {
    let repo = docroot(o)
    if repo == "" { return "unsupported-transport" }
    let out = options.flag_value(o, "--out")
    if out == "" { return "missing-option-value" }
    var base = options.flag_value(o, "--base")
    if base == "" { base = "/pax/" }
    if !safe_base(base) { return "unsupported-transport" }
    let root = latest_root(repo)
    if root.error != "" { return root.error }
    let stamp_in = io.read("{repo}/metadata/timestamp.json", 16384 + 65536)
    if stamp_in.error != "" { return stamp_in.error }
    let stamp = meta.parse(stamp_in.bytes, "timestamp")
    if stamp.error != "" { return stamp.error }
    let auth = meta.verify(stamp, root, "timestamp")
    if auth != "" { return auth }
    if stamp.expires <= now { return "expired-timestamp" }
    let snapshot = named_file(repo, "snapshot", stamp.entries[0])
    let snapshot_auth = meta.verify(snapshot, root, "snapshot")
    if snapshot_auth != "" { return snapshot_auth }
    let targets = named_file(repo, "targets", snapshot.entries[0])
    let targets_auth = meta.verify(targets, root, "targets")
    if targets_auth != "" { return targets_auth }
    var names = List[str]()
    var seen = Map[str, bool]()
    for e in targets.entries {
        if !meta.known_kind(e.kind) { continue }
        if !(seen[e.name] else false) {
            seen[e.name] = true
            (mut names).push(copy e.name)
        }
    }
    let sorted = sort_names(names)
    var front = page_head("PAX packages")
    front += "<h1>PAX packages</h1>\n"
    front += "<p>Timestamp version {stamp.version}, valid until {writer.date(stamp.expires)}. Snapshot version {snapshot.version}, targets version {targets.version}.</p>\n"
    front += "<table><tr><th>Package</th><th>Versions</th></tr>\n"
    var pages = List[str]()
    var bodies = List[str]()
    for name in sorted {
        var versions = ""
        var page = page_head("{name} on PAX")
        page += "<h1>{esc(name)}</h1>\n<p><a href=\"../index.html\">All packages</a></p>\n"
        page += "<table><tr><th>Version</th><th>Architecture</th><th>Kind</th><th>Length</th><th>SHA-256</th><th>File</th></tr>\n"
        var last = ""
        for e in targets.entries {
            if e.name != name || !meta.known_kind(e.kind) { continue }
            if e.package_version != last {
                if versions != "" { versions += ", " }
                versions += esc(e.package_version)
                last = copy e.package_version
            }
            page += "<tr><td>{esc(e.package_version)}</td><td>{esc(e.arch)}</td><td>{esc(e.kind)}</td><td>{e.length}</td><td>{e.digest}</td><td><a href=\"{base}targets/{e.digest}.{esc(e.path)}\">{esc(e.path)}</a></td></tr>\n"
        }
        page += "</table></body></html>\n"
        front += "<tr><td><a href=\"packages/{esc(name)}.html\">{esc(name)}</a></td><td>{versions}</td></tr>\n"
        (mut pages).push("{out}/packages/{name}.html")
        (mut bodies).push(page)
    }
    front += "</table></body></html>\n"
    if fs_exists("{out}/index.html") { return "immutable-rewrite" }
    for path in pages { if fs_exists(path) { return "immutable-rewrite" } }
    for dir in [copy out, "{out}/packages"] {
        let made = cache.directory(dir)
        if made != "" { return made }
    }
    var error = io.create_public("{out}/index.html", front.bytes())
    if error != "" { return error }
    for i in 0..pages.len {
        error = io.create_public(pages[i], bodies[i].bytes())
        if error != "" { return error }
    }
    print("pages {pages.len + 1}")
    ""
}

/// Run one test-only repository operation, with an exclusive publisher lock.
pub fn run(verb: str, o: options.Options, now: int) -> str {
    run_with(verb, o, now, failpoint.none())
}

/// The same, with a named transition armed (the test-only executable's commit).
pub fn run_with(verb: str, o: options.Options, now: int, f: failpoint.Fail) -> str {
    if verb == "keygen" { return keygen(options.flag_value(o, "--keys")) }
    if verb == "draft-root" { return draft_root(o, now) }
    if verb == "attach" { return attach(o) }
    if verb == "draft-snapshot" { return draft_reference("snapshot", o, now) }
    if verb == "draft-timestamp" { return draft_reference("timestamp", o, now) }
    if verb == "verify" { return verify_all(o, now) }
    if verb == "index" { return index_pages(o, now) }
    if verb == "key-id" { return inspect.key_id(options.flag_value(o, "--public")) }
    if verb == "inspect" {
        return inspect.inspect(
            options.flag_value(o, "--file"),
            options.flag_value(o, "--root"),
            now,
        )
    }
    let raw = options.file_path(options.flag_value(o, "--repo"))
    if raw == "" { return "unsupported-transport" }
    let error = cache.directory(raw)
    if error != "" { return error }
    let repo = fs_realpath(raw) else |_| { return "directory" }
    let lock = io.lock(repo)
    if lock < 0 { return "repository-locked" }
    var result = ""
    for child in ["metadata", "targets"] {
        result = cache.directory("{repo}/{child}")
        if result != "" { break }
    }
    if result == "" && verb == "draft-targets" {
        result = draft_targets(repo, o, now)
    } else if result == "" && verb == "commit" {
        result = commit(repo, o, now, f)
    } else if result == "" {
        let keys = load_keys(options.flag_value(o, "--keys"))
        result = keys.error
        if result == "" {
            if verb == "init" {
                result = initialize(repo, keys, o, now)
            } else if verb == "rotate" {
                result = rotate(repo, keys, o, now)
            } else if verb == "publish" {
                result = publish(repo, keys, o, now)
            } else {
                result = "unsupported-repo-verb"
            }
        }
    }
    fs_sync_dir(repo) else |_| { result = "state-dir-sync" }
    fs_sync_dir("{repo}/..") else |_| { result = "state-dir-sync" }
    fs_close(lock) else |_| { result = "state-close" }
    result
}
