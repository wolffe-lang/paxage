use std.x.crypto.sha2 as sha2
use payload
use staging

fn expect(ok: bool, row: str) -> bool {
    if !ok { fs_write(2, "FAIL {row}\n") else |_| {} }
    ok
}

fn main() -> int {
    if !expect(
        staging.privilege(0) == "privileged-staging-is-pm04-pm05",
        "stage-euid-zero-refused",
    ) {
        return 1
    }
    if !expect(staging.privilege(1000) == "", "stage-nonroot-allowed") { return 1 }
    if !expect(!payload.allowed_path("../escape"), "F6-traversal-refused") { return 1 }
    if !expect(!payload.allowed_path("/escape"), "F6-absolute-refused") { return 1 }
    if !expect(!payload.allowed_path("var/db"), "F5-reserved-refused") { return 1 }
    if !expect(!payload.safe_link("usr/x", "../../escape"), "F6-link-escape") { return 1 }
    if !expect(payload.safe_link("usr/x", "../etc/config"), "F6-relative-link") { return 1 }
    if !expect(payload.number("9223372036854775808".bytes(), 10) == -1, "F6-number-overflow") {
        return 1
    }
    if !expect(payload.number("00000000001".bytes(), 8) == 1, "F6-octal") { return 1 }
    if !expect(payload.number([128 as byte], 8) == -1, "F6-base256-refused") { return 1 }
    if !expect(payload.ustar_path("usr/bin/tool"), "F6-ustar-path") { return 1 }
    if !expect(!payload.ustar_path("usr/é"), "F6-nonportable-path-needs-pax") { return 1 }
    if !expect(!payload.ustar_path("usr/a b"), "F6-nonportable-space-needs-pax") { return 1 }
    let messages = ["", "abc", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"]
    let hashes = [
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    ]
    for i in 0..messages.len {
        var st = sha2.new256()
        for b in messages[i].bytes() { sha2.update256(mut st, [b]) }
        if !expect(sha2.to_hex(sha2.final256(take st)) == hashes[i], "FIPS-180-4-{i}") { return 1 }
    }
    var million = sha2.new256()
    var chunk = List[byte]()
    for _i in 0..1000 { (mut chunk).push(97 as byte) }
    for _i in 0..1000 { sha2.update256(mut million, chunk) }
    if !expect(
        sha2.to_hex(sha2.final256(take million)) ==
            "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
        "FIPS-million-a",
    ) {
        return 1
    }
    print("PASS payload-unit-and-FIPS exit=0")
    0
}
