use std.x.crypto.sha2 as sha2
use payload
use staging

fn main() {
    assert(staging.privilege(0) == "privileged-staging-is-pm04-pm05", "stage-euid-zero-refused")
    assert(staging.privilege(1000) == "", "stage-nonroot-allowed")
    assert(!payload.allowed_path("../escape"), "F6-traversal-refused")
    assert(!payload.allowed_path("/escape"), "F6-absolute-refused")
    assert(!payload.allowed_path("var/db"), "F5-reserved-refused")
    assert(!payload.safe_link("usr/x", "../../escape"), "F6-link-escape")
    assert(payload.safe_link("usr/x", "../etc/config"), "F6-relative-link")
    assert(payload.number("9223372036854775808".bytes(), 10) == -1, "F6-number-overflow")
    assert(payload.number("00000000001".bytes(), 8) == 1, "F6-octal")
    assert(payload.number([128 as byte], 8) == -1, "F6-base256-refused")
    assert(payload.ustar_path("usr/bin/tool"), "F6-ustar-path")
    let messages = ["", "abc", "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"]
    let hashes = [
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
    ]
    for i in 0..messages.len {
        var st = sha2.new256()
        for b in messages[i].bytes() { sha2.update256(mut st, [b]) }
        assert(sha2.to_hex(sha2.final256(take st)) == hashes[i], "FIPS-180-4-{i}")
    }
    var million = sha2.new256()
    var chunk = List[byte]()
    for _i in 0..1000 { (mut chunk).push(97 as byte) }
    for _i in 0..1000 { sha2.update256(mut million, chunk) }
    assert(
        sha2.to_hex(sha2.final256(take million)) ==
            "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
        "FIPS-million-a",
    )
    print("END payload-unit-and-FIPS exit=0")
}
