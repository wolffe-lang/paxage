//! Pure T7-T13 transition rules. Persistence is a separate caller obligation.
use trust_metadata as meta
/// Highest accepted version and exact whole-envelope hash within this key epoch.
pub struct Mark { version: int, hash: str }
/// Authoritative state: root, current partial chain, rollback marks and time floor.
pub struct State {
    root: meta.Meta, timestamp: meta.Meta, snapshot: meta.Meta, targets: meta.Meta,
    timestamp_mark: Mark, snapshot_mark: Mark, targets_mark: Mark,
    snapshot_floor: int, targets_floor: int, floor: int, stage: int, repository: str,
}
/// Named version/hash refusal; no state change on failure.
pub fn version_error(role: str, old: Mark, candidate: Mark) -> str {
    if old.version < 0 || candidate.version < 1 { return "metadata-version" }
    if candidate.version < old.version { return "rollback-{role}" }
    if old.version != 0 && candidate.version == old.version && candidate.hash != old.hash { return "same-version-rewrite" }
    ""
}
/// Explicit supplied time cannot precede persisted update time.
pub fn clock_error(floor: int, now: int) -> str {
    if floor < 0 || now < 0 { return "metadata-time" }
    if now < floor { return "clock-before-floor" }
    ""
}
/// Initial state from a caller-pinned root. Caller MUST check bootstrap_error first.
pub fn initial(root: meta.Meta, now: int) -> State {
    State { root: copy root, timestamp: meta.absent("timestamp"), snapshot: meta.absent("snapshot"), targets: meta.absent("targets"), timestamp_mark: Mark { version: 0, hash: "" }, snapshot_mark: Mark { version: 0, hash: "" }, targets_mark: Mark { version: 0, hash: "" }, snapshot_floor: 0, targets_floor: 0, floor: now, stage: 0, repository: "" }
}
/// Structural/self-signature check, not a substitute for pinned-root provenance.
pub fn bootstrap_error(root: meta.Meta, now: int) -> str {
    if now < 0 { return "metadata-time" }
    if root.role != "root" || root.version < 1 { return "bootstrap-unpinned" }
    meta.verify(root, root, "root")
}
/// Exact whole-file reference check before signature work.
pub fn binding(candidate: meta.Meta, reference: meta.Entry) -> str {
    if candidate.wire.len != reference.length { return "metadata-length" }
    if meta.digest(candidate.wire) != reference.digest { return "metadata-hash" }
    if candidate.version != reference.version { return "{candidate.role}-version" }
    ""
}
/// Atomically applicable in-memory step: every refusal leaves s unchanged.
pub fn advance(mut s: State, candidate: meta.Meta, now: int) -> str {
    let clock = clock_error(s.floor, now)
    if clock != "" { return clock }
    if candidate.error != "" { return candidate.error }
    let mark = Mark { version: candidate.version, hash: meta.digest(candidate.wire) }
    if candidate.role == "root" {
        let old = Mark { version: s.root.version, hash: meta.digest(s.root.wire) }
        let error = version_error("root", old, mark)
        if error != "" { return error }
        if s.root.version == 9223372036854775807 || candidate.version != s.root.version + 1 { return "root-version" }
        if meta.verify(candidate, s.root, "root") != "" { return "root-old-threshold" }
        if meta.verify(candidate, candidate, "root") != "" { return "root-new-threshold" }
        let reset = meta.keys_changed(s.root, candidate, "timestamp") || meta.keys_changed(s.root, candidate, "snapshot")
        s.root = copy candidate
        // Any root update invalidates active-chain authorization. High-water marks
        // survive unless freshness keys rotate; this also handles threshold changes.
        s.timestamp = meta.absent("timestamp")
        s.snapshot = meta.absent("snapshot")
        s.targets = meta.absent("targets")
        s.stage = 0
        if reset {
            s.timestamp_mark = Mark { version: 0, hash: "" }
            s.snapshot_mark = Mark { version: 0, hash: "" }
            s.targets_mark = Mark { version: 0, hash: "" }
            s.snapshot_floor = 0
            s.targets_floor = 0
        }
        s.floor = now
        return ""
    }
    if s.root.expires <= now { return "expired-root" }
    if candidate.expires <= now { return "expired-{candidate.role}" }
    if candidate.role == "timestamp" {
        let error = version_error("timestamp", s.timestamp_mark, mark)
        if error != "" { return error }
        if candidate.entries.len != 1 { return "metadata-reference" }
        if candidate.entries[0].version < s.snapshot_floor { return "rollback-snapshot" }
        let verified = meta.verify(candidate, s.root, "timestamp")
        if verified != "" { return verified }
        s.timestamp = copy candidate
        s.timestamp_mark = mark
        s.snapshot_floor = candidate.entries[0].version
        s.snapshot = meta.absent("snapshot")
        s.targets = meta.absent("targets")
        s.stage = 1
    } else if candidate.role == "snapshot" {
        if s.stage < 1 || s.timestamp.entries.len != 1 { return "update-order" }
        if s.timestamp.expires <= now { return "expired-timestamp" }
        let error = version_error("snapshot", s.snapshot_mark, mark)
        if error != "" { return error }
        let bound = binding(candidate, s.timestamp.entries[0])
        if bound != "" { return bound }
        if candidate.entries.len != 1 || candidate.entries[0].version < s.targets_floor { return "rollback-targets" }
        let verified = meta.verify(candidate, s.root, "snapshot")
        if verified != "" { return verified }
        s.snapshot = copy candidate
        s.snapshot_mark = mark
        s.targets_floor = candidate.entries[0].version
        s.targets = meta.absent("targets")
        s.stage = 2
    } else if candidate.role == "targets" {
        if s.stage < 2 || s.snapshot.entries.len != 1 { return "update-order" }
        if s.timestamp.expires <= now { return "expired-timestamp" }
        if s.snapshot.expires <= now { return "expired-snapshot" }
        let error = version_error("targets", s.targets_mark, mark)
        if error != "" { return error }
        let bound = binding(candidate, s.snapshot.entries[0])
        if bound != "" { return bound }
        let verified = meta.verify(candidate, s.root, "targets")
        if verified != "" { return verified }
        s.targets = copy candidate
        s.targets_mark = mark
        s.stage = 3
    } else { return "role-type" }
    s.floor = now
    ""
}
/// Recheck authorization/freshness before exposing any target from a loaded state.
pub fn ready(s: State, now: int) -> str {
    let clock = clock_error(s.floor, now)
    if clock != "" { return clock }
    if s.stage != 3 { return "incomplete-trust-chain" }
    for m in [copy s.root, copy s.timestamp, copy s.snapshot, copy s.targets] {
        if m.expires <= now { return "expired-{m.role}" }
        let verified = meta.verify(m, s.root, m.role)
        if verified != "" { return verified }
    }
    if s.timestamp.entries.len != 1 || s.snapshot.entries.len != 1 { return "metadata-reference" }
    let snapshot = binding(s.snapshot, s.timestamp.entries[0])
    if snapshot != "" { return snapshot }
    binding(s.targets, s.snapshot.entries[0])
}

/// A proposed persisted state must preserve clock/version history or perform
/// an authenticated single-step root epoch transition. No arbitrary fallback.
pub fn continuity(old: State, next: State) -> str {
    let clock = clock_error(old.floor, next.floor)
    if clock != "" { return clock }
    let root = version_error("root", Mark { version: old.root.version, hash: meta.digest(old.root.wire) }, Mark { version: next.root.version, hash: meta.digest(next.root.wire) })
    if root != "" { return root }
    var reset = false
    if next.root.version != old.root.version {
        if old.root.version == 9223372036854775807 || next.root.version != old.root.version + 1 { return "root-version" }
        if meta.verify(next.root, old.root, "root") != "" { return "root-old-threshold" }
        if meta.verify(next.root, next.root, "root") != "" { return "root-new-threshold" }
        reset = meta.keys_changed(old.root, next.root, "timestamp") || meta.keys_changed(old.root, next.root, "snapshot")
    }
    if !reset {
        let before = [copy old.timestamp_mark, copy old.snapshot_mark, copy old.targets_mark]
        let after = [copy next.timestamp_mark, copy next.snapshot_mark, copy next.targets_mark]
        let roles = ["timestamp", "snapshot", "targets"]
        for i in 0..3 {
            if after[i].version == 0 && before[i].version == 0 { continue }
            let error = version_error(roles[i], before[i], after[i])
            if error != "" { return error }
        }
        if next.snapshot_floor < old.snapshot_floor { return "rollback-snapshot" }
        if next.targets_floor < old.targets_floor { return "rollback-targets" }
    }
    ""
}
