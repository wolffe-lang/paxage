//! member: false
//! Standalone format, planning, pack and isolated stage CLI. No live-root mutation.

use literal
use schema
use model
use version
use solver
use checker
use payload_cli
use std.json as json
use std.str as text
use std.x.crypto.sha2 as sha2

fn usage() -> str {
    "Usage: larder (lrd) version | check-manifest FILE | compare V1 V2 | resolve --snapshot DIR --want SPEC... [--json]\nPayload: pack SOURCE TEMPLATE OUTDIR --epoch N | verify-payload FILE --length N [--manifest FILE] | list-payload FILE --length N [--json] | stage FILE --length N --sha256 HEX --manifest FILE --into DIR\nMutating verbs install, remove, upgrade, sync are refused until pm04."
}

fn bad_usage(message: str) -> int { eprint("larder: {message}\n{usage()}"); 2 }

fn fail(message: str) -> int { eprint("larder: {message}"); 1 }

struct Input { bytes: List[byte], error: str }

fn read_input(path: str) -> Input {
    let fd = fs_open_mode(path, 21) else |_| {
        return Input { bytes: List[byte](), error: "io-open" }
    }
    let stat = fs_fstat(fd) else |_| {
        fs_close(fd) else |_| {}
        return Input { bytes: List[byte](), error: "io-stat" }
    }
    if stat[0] != 0 {
        fs_close(fd) else |_| {}
        return Input { bytes: List[byte](), error: "not-regular" }
    }
    if stat[1] > 1048576 {
        fs_close(fd) else |_| {}
        return Input { bytes: List[byte](), error: "byte-limit" }
    }
    var data = List[byte]()
    var error = ""
    loop {
        var amount = 1048577 - data.len
        if amount > 65536 { amount = 65536 }
        let chunk = fs_read_chunk(fd, amount) else |e| match e {
            eof => { break },
            io => { error = "io-read"; break },
        }
        if chunk.len == 0 { break }
        for b in chunk { (mut data).push(b) }
        if data.len > 1048576 { error = "byte-limit"; break }
    }
    fs_close(fd) else |_| { error = "io-close" }
    Input { bytes: data, error }
}

fn quote(s: str) -> str { json.stringify(json.from_str(s)) else |_| { "\"json-error\"" } }

struct Request { need: model.Need, error: str }

fn request(spec: str, arch: str, slot: str) -> Request {
    var n = model.Need { name: "", op: "any", version: "", arch, slot }
    var error = ""
    var at = spec.len
    let bytes = spec.bytes()
    for i in 0..bytes.len {
        let c = bytes[i] as int
        if c == 61 || c == 33 || c == 60 || c == 62 { at = i; break }
    }
    let head = version.part(spec, 0, at)
    if at < spec.len {
        var end = at + 1
        if end < bytes.len && bytes[end] == 61 as byte { end += 1 }
        n.op = version.part(spec, at, end)
        n.version = version.part(spec, end, spec.len)
        if !(
            n.op == "=" ||
                n.op == "!=" ||
                n.op == "<" ||
                n.op == "<=" ||
                n.op == ">" ||
                n.op == ">="
        ) ||
            !version.valid(n.version) {
            error = "bad-want"
        }
    }
    let parts = text.split(head, "@")
    n.name = parts[0]
    if parts.len == 2 {
        let identity = text.split(parts[1], "/")
        if identity.len != 2 {
            error = "bad-want"
        } else {
            n.arch = identity[0]
            n.slot = identity[1]
        }
    } else if parts.len != 1 {
        error = "bad-want"
    }
    if !schema.identity(n.name) || !schema.identity(n.arch) || !schema.identity(n.slot) {
        error = "bad-want"
    }
    Request { need: n, error }
}

fn sorted(values: List[str]) -> List[str] {
    var result = copy values
    for i in 0..result.len {
        var j = i
        while j > 0 && version.lexical(result[j], result[j - 1]) < 0 {
            let prior = result[j - 1]
            result[j - 1] = result[j]
            result[j] = prior
            j -= 1
        }
    }
    result
}

fn array(values: List[str]) -> str {
    var s = "["
    for i in 0..values.len {
        if i > 0 { s += "," }
        s += quote(values[i])
    }
    s + "]"
}

fn op_matches(v: str, n: model.Need) -> bool {
    if n.op == "any" { return true }
    let c = version.compare(v, n.version)
    if n.op == "=" { return c == 0 }
    if n.op == "!=" { return c != 0 }
    if n.op == "<" { return c < 0 }
    if n.op == "<=" { return c <= 0 }
    if n.op == ">" { return c > 0 }
    n.op == ">=" && c >= 0
}

fn emit(s: model.Snapshot, p: solver.Plan, wants: List[str], as_json: bool) {
    var chosen = List[str]()
    for i in p.selected { (mut chosen).push(model.id(s.packages[i])) }
    let selected = sorted(chosen)
    var removals = "["
    var removal_text = ""
    var count = 0
    for old in sorted(s.installed) {
        var retained = false
        for id in selected { if id == old { retained = true } }
        if retained { continue }
        var replacement = ""
        var reason = ""
        for old_pkg in s.packages {
            if model.id(old_pkg) != old { continue }
            for i in p.selected {
                let q = copy s.packages[i]
                if q.name == old_pkg.name && q.arch == old_pkg.arch && q.slot == old_pkg.slot {
                    replacement = model.id(q)
                    reason = "same-slot upgrade"
                }
                if replacement == "" {
                    for r in q.replaces {
                        if r.name == old_pkg.name &&
                            r.arch == old_pkg.arch &&
                            r.slot == old_pkg.slot &&
                            op_matches(old_pkg.version, r) {
                            replacement = model.id(q)
                            reason = "replaces"
                        }
                    }
                }
            }
        }
        if p.status == "solved" {
            if count > 0 { removals += "," }
            removals += "{{\"old\":{quote(old)},\"replacement\":{quote(replacement)},\"reason\":{quote(reason)}}}"
            removal_text += "\nremove {old} -> {replacement} ({reason})"
            count += 1
        }
    }
    removals += "]"
    let explanation = "{p.explanation}; packages={s.packages.len}; wants={text.join(",", wants)}; holds={text.join(",", sorted(s.holds))}; installed={text.join(",", sorted(s.installed))}"
    if as_json {
        print(
            "{{\"status\":{quote(p.status)},\"selected\":{array(selected)},\"removals\":{removals},\"nodes\":{p.nodes},\"explanation\":{quote(explanation)}}}",
        )
    } else {
        var output = "status: {p.status}\nnodes: {p.nodes}"
        for id in selected { output += "\nselect {id}" }
        print("{output}{removal_text}\nexplanation: {explanation}")
    }
}

fn resolve(args: List[str]) -> int {
    var dir = ""
    var wants = List[str]()
    var as_json = false
    var i = 1
    while i < args.len {
        if args[i] == "--snapshot" && i + 1 < args.len && dir == "" {
            dir = args[i + 1]
            i += 2
        } else if args[i] == "--json" && !as_json {
            as_json = true
            i += 1
        } else if args[i] == "--want" {
            i += 1
            let start = i
            while i < args.len && !text.starts_with(args[i], "--") {
                (mut wants).push(args[i])
                i += 1
            }
            if start == i { return bad_usage("--want needs a specification") }
        } else {
            return bad_usage("unknown or incomplete resolve option")
        }
    }
    if dir == "" || wants.len == 0 || wants.len > 128 {
        return bad_usage("resolve needs --snapshot and 1..128 --want specifications")
    }
    let input = read_input("{dir}/snapshot.lrd")
    if input.error != "" { return fail(input.error) }
    let data = literal.parse(input.bytes)
    if data.error != "" { return fail(data.error) }
    let e = schema.snapshot(data)
    if e != "" { return fail(e) }
    let s = schema.universe(data)
    var needs = List[model.Need]()
    for w in wants {
        let r = request(w, s.arch, s.slot)
        if r.error != "" { return bad_usage("{r.error}: {w}") }
        (mut needs).push(r.need)
    }
    let p = solver.resolve(s, needs)
    if p.status == "solved" {
        let c = checker.check(s, needs, p.selected)
        if c != "" { eprint("larder: internal-plan-error: {c}"); return 5 }
    }
    emit(s, p, wants, as_json)
    if p.status == "unsatisfiable" {
        eprint("larder: unsatisfiable: exhaustive snapshot proof")
        return 3
    }
    if p.status == "budget-exceeded" {
        eprint("larder: budget-exceeded: search incomplete")
        return 4
    }
    0
}

fn main() -> int {
    let a = env_args()
    if a.len < 1 { return bad_usage("missing verb") }
    let verb = a[0]
    if verb == "pack" || verb == "verify-payload" || verb == "list-payload" || verb == "stage" {
        return payload_cli.run(a)
    }
    for mutating in ["install", "remove", "upgrade", "sync"] {
        if verb == mutating { eprint("larder: {verb} refused: mutation arrives in pm04"); return 6 }
    }
    if (verb == "--help" || verb == "help") && a.len == 1 { print(usage()); return 0 }
    if (verb == "version" || verb == "--version") && a.len == 1 {
        print("larder 0.1.0 (lrd; format v1, pack and stage)")
        return 0
    }
    if verb == "compare" && a.len == 3 {
        if !version.valid(a[1]) || !version.valid(a[2]) { return fail("bad-version") }
        print("{version.compare(a[1], a[2])}")
        return 0
    }
    if verb == "check-manifest" && a.len == 2 {
        let input = read_input(a[1])
        if input.error != "" { return fail(input.error) }
        let d = literal.parse(input.bytes)
        if d.error != "" { return fail(d.error) }
        let e = schema.manifest(d, 0)
        if e != "" { return fail(e) }
        let hash = sha2.to_hex(sha2.sum256(input.bytes))
        print("manifest ok sha256={hash} bytes={input.bytes.len}")
        return 0
    }
    if verb == "resolve" { return resolve(a) }
    bad_usage("unknown verb or wrong argument count")
}
