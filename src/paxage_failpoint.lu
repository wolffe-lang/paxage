//! member: false
//! Test-only: the root verbs with PAXAGE_FAILPOINT armed. Never shipped
//! as paxage; the shipped executable passes failpoint.none().

use root_cli
use failpoint
use transport

fn main() -> int {
    let a = env_args()
    if a.len < 1 || !root_cli.owns(a[0]) { eprint("paxage-failpoint: root verbs only"); return 2 }
    let spec = env_get("PAXAGE_FAILPOINT") else |_| { "" }
    let fifo = env_get("PAXAGE_FAILPOINT_FIFO") else |_| { "" }
    let mark = env_get("PAXAGE_FAILPOINT_MARK") else |_| { "" }
    let f = failpoint.marked(failpoint.parse(spec, fifo), mark)
    if !failpoint.valid(spec, f) {
        eprint("paxage-failpoint: bad PAXAGE_FAILPOINT {spec}")
        return 2
    }
    let knobs = env_get("PAXAGE_FETCH_KNOBS") else |_| { "" }
    root_cli.run_with(a, f, transport.knobs(knobs))
}
