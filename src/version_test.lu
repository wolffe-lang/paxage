use version

fn main() {
    assert(version.compare("1~rc-1", "1-1") < 0, "V1-tilde-before-end")
    assert(version.compare("1-1", "1.0-1") < 0, "V1-end-before-separator")
    assert(version.compare("1.0-1", "1.00-1") == 0, "V1-zero-normalization")
    assert(version.compare("1:0-1", "99999999999999999999999999999999-9") > 0, "V1-epoch-dominates")
    assert(version.compare("1-99999999999999999999", "1-99999999999999999998") > 0, "V1-unbounded-release")
    assert(version.valid("0:1.0-01"), "V2-valid")
    for bad in ["", "1", "1-0", "-1", "1-1-1", "1:2:3-1", "1/2-1", "é-1", "-1:1-1", "1-+1"] {
        assert(!version.valid(bad), "V2-invalid {bad}")
    }
    let values = ["0-1", "00-1", "1~rc-1", "1-1", "1+1-1", "1.0-1", "1_0-1", "1a-1", "1A-1", "10-1", "1.00-1", "1:0-1", "2:0-1", "1-2"]
    for a in values {
        assert(version.compare(a, a) == 0, "V3-reflexive")
        for b in values {
            assert(version.compare(a, b) == -version.compare(b, a), "V3-antisymmetry")
            for c in values {
                if version.compare(a, b) <= 0 && version.compare(b, c) <= 0 {
                    assert(version.compare(a, c) <= 0, "V3-transitivity")
                }
            }
        }
    }
    print("END version-properties exit=0")
}
