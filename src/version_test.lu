use version

fn check_row(ok: bool, row: str) -> bool {
    if !ok { fs_write(2, "FAIL {row}\n") else |_| {} }
    ok
}

fn main() -> int {
    if !check_row(version.compare("1~rc-1", "1-1") < 0, "V1-tilde-before-end") { return 1 }
    if !check_row(version.compare("1-1", "1.0-1") < 0, "V1-end-before-separator") { return 1 }
    if !check_row(version.compare("1.0-1", "1.00-1") == 0, "V1-zero-normalization") { return 1 }
    if !check_row(
        version.compare("1:0-1", "99999999999999999999999999999999-9") > 0,
        "V1-epoch-dominates",
    ) {
        return 1
    }
    if !check_row(
        version.compare("1-99999999999999999999", "1-99999999999999999998") > 0,
        "V1-unbounded-release",
    ) {
        return 1
    }
    if !check_row(version.valid("0:1.0-01"), "V2-valid") { return 1 }
    for bad in ["", "1", "1-0", "-1", "1-1-1", "1:2:3-1", "1/2-1", "é-1", "-1:1-1", "1-+1"] {
        if !check_row(!version.valid(bad), "V2-invalid {bad}") { return 1 }
    }
    let values = [
        "0-1",
        "00-1",
        "1~rc-1",
        "1-1",
        "1+1-1",
        "1.0-1",
        "1_0-1",
        "1a-1",
        "1A-1",
        "10-1",
        "1.00-1",
        "1:0-1",
        "2:0-1",
        "1-2",
    ]
    for a in values {
        if !check_row(version.compare(a, a) == 0, "V3-reflexive") { return 1 }
        for b in values {
            if !check_row(version.compare(a, b) == -version.compare(b, a), "V3-antisymmetry") {
                return 1
            }
            for c in values {
                if version.compare(a, b) <= 0 && version.compare(b, c) <= 0 {
                    if !check_row(version.compare(a, c) <= 0, "V3-transitivity") { return 1 }
                }
            }
        }
    }
    var generated = List[str]()
    let prefix = ["0", "1", "01", "10", "A", "a", "~", "_"]
    let suffix = ["", "~rc", ".0", "+1", "_x", "A9", "00"]
    for i in 0..64 {
        let p = prefix[i % prefix.len]
        let q = suffix[i * 3 % suffix.len]
        let v = "{i % 3}:{p}{q}-{i % 7 + 1}"
        if !check_row(version.valid(v), "V3-generated-valid") { return 1 }
        (mut generated).push(v)
    }
    for a in generated {
        for b in generated {
            if !check_row(
                version.compare(a, b) == -version.compare(b, a),
                "V3-generated-antisymmetry",
            ) {
                return 1
            }
        }
    }
    var seed = 1447375411
    print("version property seed={seed} versions=64 triples=10000")
    for _i in 0..10000 {
        seed = (seed * 1664525 + 1013904223) % 4294967296
        let a = generated[seed / 65536 % 64]
        seed = (seed * 1664525 + 1013904223) % 4294967296
        let b = generated[seed / 65536 % 64]
        seed = (seed * 1664525 + 1013904223) % 4294967296
        let c = generated[seed / 65536 % 64]
        if version.compare(a, b) <= 0 && version.compare(b, c) <= 0 {
            if !check_row(version.compare(a, c) <= 0, "V3-generated-transitivity") { return 1 }
        }
    }
    print("PASS version-properties exit=0")
    0
}
