use trust_metadata as meta
fn row(ok: bool, name: str) -> bool {
    if ok { print("PASS {name}") } else { fs_write(2, "FAIL {name}\n") else |_| {} }
    ok
}
fn expect(text: str, role: str, error: str, name: str) -> bool {
    let bytes = text.bytes()
    let m = meta.parse(bytes, role)
    if m.error != error { print("DETAIL expected={error} actual={m.error}") }
    row(m.error == error, name)
}
fn main() -> int {
    var ok = true
    if !row(meta.utc("1970-01-01T00:00:00Z") == 0, "T4-epoch") { ok = false }
    if !row(meta.utc("2000-02-29T12:34:56Z") == 951827696, "T4-leap-year") { ok = false }
    if !row(meta.utc("2100-02-29T00:00:00Z") == -1, "T4-century-not-leap") { ok = false }
    if !row(meta.utc("2026-11-03T05:30:00+00:00") == -1, "T4-UTC-only") { ok = false }
    if !row(meta.utc("2026-11-03T24:00:00Z") == -1, "T4-hour-bound") { ok = false }
    if !row(meta.logical("a-1.payload.tar"), "T10-logical-valid") { ok = false }
    for bad in ["a/b", "..", "a..b", "a\\b", "a%2fb", "a?b", "a#b", "a\x00b"] {
        if !row(!meta.logical(bad), "T10-logical-refused") { ok = false }
    }
    let good = r#"{"signatures":[],"signed":{"_type":"timestamp","expires":"2030-01-01T00:00:00Z","meta":{"snapshot.json":{"hashes":{"sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},"length":100,"version":1}},"spec_version":"1.0.37","version":1}}"#
    if !expect(good, "timestamp", "", "T7-timestamp-schema") { ok = false }
    if !expect(good, "snapshot", "role-type", "T4-role-type") { ok = false }
    if !expect(r#"{"signatures":[],"signed":{}}"#, "root", "missing-field", "T4-missing-field") { ok = false }
    if !expect(r#"{"signatures":[],"signed":{"_type":"root","expires":"2030-01-01T00:00:00Z","spec_version":"2.0.0","version":1}}"#, "root", "spec-version", "T4-spec-version") { ok = false }
    if !expect(r#"{"signatures":[],"signed":{"_type":"timestamp","expires":"2030-01-01T00:00:00Z","meta":{},"spec_version":"1.0.37","version":1}}"#, "timestamp", "metadata-reference", "T7-missing-snapshot") { ok = false }
    if !expect(r#"{"signatures":[],"signed":{"_type":"targets","delegations":{},"expires":"2030-01-01T00:00:00Z","spec_version":"1.0.37","targets":{},"version":1}}"#, "targets", "unsupported-delegations", "T9-delegations") { ok = false }
    if !expect(r#"{"signatures":[],"signed":{"_type":"targets","expires":"2030-01-01T00:00:00Z","spec_version":"1.0.37","targets":{},"version":1}}"#, "targets", "", "T9-empty-targets") { ok = false }
    if ok { 0 } else { 1 }
}
