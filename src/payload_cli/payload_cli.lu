//! Pack, reader and stage CLI plumbing. No trust/root/network verbs.

use payload
use packing
use staging
use literal
use schema
use std.json as json
use std.x.crypto.sha2 as sha2

fn fail(error: str) -> int { eprint("larder: {error}"); 1 }

fn quote(s: str) -> str { json.stringify(json.from_str(s)) else |_| { "\"json-error\"" } }

fn bound_data(path: str, expected: str, expected_length: int) -> literal.Data {
    let fd = fs_open_mode(path, 21) else |_| {
        return literal.Data { nodes: List[literal.Node](), error: "io-open" }
    }
    let st = fs_fstat(fd) else |_| {
        fs_close(fd) else |_| {}
        return literal.Data { nodes: List[literal.Node](), error: "io-stat" }
    }
    if st[0] != 0 || st[1] > 1048576 {
        fs_close(fd) else |_| {}
        return literal.Data { nodes: List[literal.Node](), error: "byte-limit" }
    }
    if expected_length >= 0 && st[1] != expected_length {
        fs_close(fd) else |_| {}
        return literal.Data { nodes: List[literal.Node](), error: "manifest-length" }
    }
    var s = payload.Stream { fd, pos: 0, length: st[1], error: "" }
    let b = payload.read(mut s, st[1])
    if s.error == "" {
        let extra = fs_read_chunk(fd, 1) else |e| match e {
            eof => { List[byte]() },
            io => { s.error = "io-read"; List[byte]() },
        }
        if extra.len != 0 { s.error = "manifest-length" }
    }
    fs_close(fd) else |_| { s.error = "io-close" }
    if s.error != "" { return literal.Data { nodes: List[literal.Node](), error: s.error } }
    if expected != "" && sha2.to_hex(sha2.sum256(b)) != expected {
        return literal.Data { nodes: List[literal.Node](), error: "manifest-digest" }
    }
    literal.parse(b)
}

fn data(path: str) -> literal.Data { bound_data(path, "", -1) }

fn use_manifest(path: str, es: List[payload.Entry], expected: str, length: int) -> str {
    let d = bound_data(path, expected, length)
    if d.error != "" { return d.error }
    let valid = schema.manifest(d, 0)
    if valid != "" { return valid }
    staging.manifest(es, d)
}

/// Stream one bounded output row at a time; empty on success or inventory-write.
/// Listing does not imply blob or signer authentication.
pub fn inventory(es: List[payload.Entry], as_json: bool) -> str {
    if as_json { fs_write(1, "[") else |_| { return "inventory-write" } }
    for i in 0..es.len {
        region output_row {
            let e = copy es[i]
            var row = ""
            if as_json {
                if i > 0 { fs_write(1, ",") else |_| { return "inventory-write" } }
                row = "{{\"path\":{quote(e.path)},\"type\":{quote(e.kind)},\"mode\":{e.mode},\"owner\":{e.owner},\"group\":{e.group},\"length\":{e.length},\"sha256\":{quote(e.hash)},\"target\":{quote(e.target)}}}"
            } else {
                row = "{e.kind}\t{e.mode}\t{e.length}\t{e.path}\t{e.target}\n"
            }
            fs_write(1, row) else |_| { return "inventory-write" }
        }
    }
    if as_json { fs_write(1, "]\n") else |_| { return "inventory-write" } }
    ""
}

fn reader(
    fd: int,
    length: int,
    verb: str,
    manifest_path: str,
    root: str,
    as_json: bool,
    manifest_hash: str,
    manifest_length: int,
) -> int {
    let offset = fs_seek(fd, 0, 0) else |_| { return fail("payload-seek") }
    if offset != 0 { return fail("payload-seek") }
    var s = payload.Stream { fd, pos: 0, length, error: "" }
    let result = payload.inspect(mut s)
    if result.error != "" { return fail(result.error) }
    if manifest_path != "" {
        let m = use_manifest(manifest_path, result.entries, manifest_hash, manifest_length)
        if m != "" { return fail(m) }
    }
    if verb == "stage" {
        let e = staging.stage(fd, result.entries, root)
        if e != "" { return fail(e) }
        print("stage ok entries={result.entries.len}")
    } else if verb == "list-payload" {
        let written = inventory(result.entries, as_json)
        if written != "" { return fail(written) }
    } else {
        print("payload ok entries={result.entries.len} bytes={length}")
    }
    0
}

/// Run one new verb. Every rejection is named; usage returns 2, data/I/O 1.
pub fn run(args: List[str]) -> int {
    let verb = args[0]
    if verb == "stage" {
        let uid = os_euid() else |_| { return fail("stage-identity-unavailable") }
        let denied = staging.privilege(uid)
        if denied != "" { return fail(denied) }
    }
    if verb == "pack" {
        if args.len != 6 || args[4] != "--epoch" {
            eprint("larder: usage: pack SOURCE TEMPLATE OUTDIR --epoch N")
            return 2
        }
        let epoch = payload.number(args[5].bytes(), 10)
        if epoch < 0 { return fail("pack-epoch") }
        let d = data(args[2])
        if d.error != "" { return fail(d.error) }
        let v = schema.manifest(d, 0)
        if v != "" { return fail(v) }
        let e = packing.pack(args[1], d, args[3], epoch)
        if e != "" { return fail(e) }
        let name = schema.string(d, 0, "name")
        let vname = schema.string(d, 0, "version")
        print("pack ok {name}-{vname}")
        return 0
    }
    var path = ""
    var manifest_path = ""
    var expected = ""
    var manifest_hash = ""
    var manifest_length = -1
    var manifest_hash_set = false
    var manifest_length_set = false
    var root = ""
    var length = -1
    var as_json = false
    if args.len > 1 { path = args[1] }
    var i = 2
    while i < args.len {
        let option = args[i]
        if option == "--json" && !as_json && verb == "list-payload" {
            as_json = true
            i += 1
            continue
        }
        if i + 1 >= args.len { eprint("larder: incomplete payload option"); return 2 }
        let value = args[i + 1]
        if option == "--length" && length == -1 {
            length = payload.number(value.bytes(), 10)
        } else if option == "--manifest" && manifest_path == "" {
            manifest_path = value
        } else if option == "--sha256" && expected == "" && verb == "stage" {
            expected = value
        } else if option == "--manifest-sha256" && !manifest_hash_set && verb == "stage" {
            manifest_hash = value
            manifest_hash_set = true
        } else if option == "--manifest-length" && !manifest_length_set && verb == "stage" {
            manifest_length = payload.number(value.bytes(), 10)
            manifest_length_set = true
        } else if option == "--into" && root == "" && verb == "stage" {
            root = value
        } else {
            eprint("larder: unknown or duplicate payload option")
            return 2
        }
        i += 2
    }
    if (manifest_hash_set || manifest_length_set) &&
        (
            !manifest_hash_set ||
                !manifest_length_set ||
                manifest_length < 0 ||
                !schema.digest(manifest_hash)
        ) {
        eprint(
            "larder: stage manifest binding requires --manifest-sha256 HEX and --manifest-length N",
        )
        return 2
    }
    if path == "" ||
        length < 0 ||
        verb == "stage" && (manifest_path == "" || root == "" || !schema.digest(expected)) {
        eprint(
            "larder: payload usage requires FILE --length N; stage also --manifest FILE --sha256 HEX --into DIR",
        )
        return 2
    }
    let fd = fs_open_mode(path, 21) else |_| { return fail("payload-open") }
    let stat = fs_fstat(fd) else |_| { fs_close(fd) else |_| {}; return fail("payload-stat") }
    if stat[0] != 0 || stat[1] != length { fs_close(fd) else |_| {}; return fail("payload-length") }
    if verb == "stage" {
        let hash = payload.digest(fd, length)
        if hash.error != "" { fs_close(fd) else |_| {}; return fail(hash.error) }
        if hash.hash != expected { fs_close(fd) else |_| {}; return fail("payload-digest") }
    }
    let code = reader(
        fd,
        length,
        verb,
        manifest_path,
        root,
        as_json,
        manifest_hash,
        manifest_length,
    )
    fs_close(fd) else |_| { return fail("payload-close") }
    code
}
