//! Strict shared argument parsing for trust-only CLI verbs.

use trust_json as json
use trust_metadata as meta
use trust_writer as writer

/// Parsed flag values and repeated package inputs, or a named usage refusal.
pub struct Options {
    values: Map[str, str],
    manifests: List[str],
    buildinfos: List[str],
    root_keys: List[str],
    signatures: List[str],
    adds: List[str],
    error: str,
}

/// Read one optional flag, returning the empty string when absent.
pub fn flag_value(o: Options, name: str) -> str { o.values[name] else "" }

/// Parse flag/value pairs. Repetition is allowed only for paired package inputs.
pub fn parse(args: List[str], start: int) -> Options {
    var o = Options {
        values: Map[str, str](),
        manifests: List[str](),
        buildinfos: List[str](),
        root_keys: List[str](),
        signatures: List[str](),
        adds: List[str](),
        error: "",
    }
    var i = start
    while i < args.len {
        if i + 1 >= args.len { o.error = "missing-option-value"; return o }
        let name = args[i]
        let value = args[i + 1]
        var known = false
        for allowed in [
            "--repo",
            "--keys",
            "--old-keys",
            "--root",
            "--state",
            "--cache",
            "--target",
            "--stage",
            "--version",
            "--root-version",
            "--now",
            "--root-validity",
            "--timestamp-validity",
            "--snapshot-validity",
            "--targets-validity",
            "--manifest",
            "--buildinfo",
            "--tls-roots",
            "--public",
            "--file",
            "--expires",
            "--root-threshold",
            "--targets-key",
            "--snapshot-key",
            "--timestamp-key",
            "--signed",
            "--previous",
            "--out",
            "--root-key",
            "--signature",
            "--add",
            "--targets-version",
            "--snapshot-version",
        ] {
            if name == allowed { known = true }
        }
        if !known { o.error = "unknown-option"; return o }
        if value == "" { o.error = "empty-option-value"; return o }
        if name == "--root-key" {
            (mut o.root_keys).push(value)
        } else if name == "--signature" {
            (mut o.signatures).push(value)
        } else if name == "--add" {
            (mut o.adds).push(value)
        } else if name == "--manifest" {
            (mut o.manifests).push(value)
        } else if name == "--buildinfo" {
            (mut o.buildinfos).push(value)
        } else {
            if flag_value(o, name) != "" { o.error = "duplicate-option"; return o }
            o.values[name] = value
        }
        if o.root_keys.len > 16 || o.signatures.len > 16 || o.adds.len > 64 {
            o.error = "key-limit"
            return o
        }
        if o.manifests.len > 256 || o.buildinfos.len > 256 { o.error = "target-limit"; return o }
        i += 2
    }
    o
}

/// Nonnegative decimal CLI integer; -1 on any noninteger or overflow.
pub fn integer(text: str) -> int {
    if text.len > 19 { return -1 }
    let bytes = text.bytes()
    let d = json.parse(bytes)
    if d.error != "" || d.nodes.len != 1 || d.nodes[0].kind != "int" { return -1 }
    d.nodes[0].number
}

/// Fix update time once. Explicit tests use --now; fallback announces the system clock.
pub fn now(o: Options) -> int {
    let explicit = flag_value(o, "--now")
    if explicit != "" { return meta.utc(explicit) }
    print("clock=system")
    time_unix_ms() / 1000
}

/// This build's clock floor, a lower bound on when this paxage was built (UTC
/// 2026-11-21T00:00:00Z). A system clock before it is wrong. It is raised at
/// each release and never runs ahead of the commit that carries it.
const BUILD_FLOOR: int = 1795219200

/// A system clock before this build refuses (T13); an explicit --now, a test
/// option, is never judged against the floor.
pub fn build_refusal(explicit: bool, now: int) -> str {
    if explicit || now >= BUILD_FLOOR { return "" }
    "clock-before-build: the system clock reads {writer.date(now)}, before this build of paxage ({writer.date(BUILD_FLOOR)}); set the clock (PAX takes it from the machine's battery clock, set in the firmware setup)"
}

/// Positive validity window added without overflowing the supported UTC range.
pub fn expiry(o: Options, option: str, defaults: int, now: int) -> int {
    var seconds = defaults
    let specified = flag_value(o, option)
    if specified != "" { seconds = integer(specified) }
    if now < 0 || seconds < 1 || seconds > 253402300799 - now { return -1 }
    now + seconds
}

/// Literal absolute local file URL; no authority, decoding, query or fragment.
pub fn file_path(url: str) -> str {
    if !url.starts_with("file:///") || url.len > 1031 { return "" }
    for b in url.bytes() {
        if b < 32 as byte ||
            b == 127 as byte ||
            b == 37 as byte ||
            b == 63 as byte ||
            b == 35 as byte {
            return ""
        }
    }
    url[7..]
}
