//! Named transition hooks. The shipped paxage passes an empty spec, so every hook
//! is a no-op there; only the test-only paxage-failpoint executable arms one.

use std.str as text

/// An armed hook: NAME:ACTION with ACTION crash, eio, enospc or pause; or trace; or
/// mark, which records every hook on the MARK path for the power-cut witness.
pub struct Fail { name: str, action: str, trace: bool, fifo: str, mark: str }

/// The inert hook set the shipped executable uses.
pub fn none() -> Fail { Fail { name: "", action: "", trace: false, fifo: "", mark: "" } }

/// Parse LARDER_FAILPOINT. An unknown action arms nothing and is reported by the caller.
pub fn parse(spec: str, fifo: str) -> Fail {
    if spec == "" { return none() }
    if spec == "trace" { return Fail { name: "", action: "", trace: true, fifo, mark: "" } }
    if spec == "mark" { return Fail { name: "", action: "mark", trace: false, fifo, mark: "" } }
    let parts = text.rsplit_once(spec, ":") else |_| { return none() }
    let (name, action) = parts
    if action != "crash" && action != "eio" && action != "enospc" && action != "pause" {
        return none()
    }
    Fail { name, action, trace: false, fifo, mark: "" }
}

/// The mark action's target: a block device (the recorder's mark export) or a file.
pub fn marked(f: Fail, path: str) -> Fail {
    Fail { name: f.name, action: f.action, trace: f.trace, fifo: f.fifo, mark: path }
}

/// True when the spec named a known action or trace, and a mark has its target.
pub fn valid(spec: str, f: Fail) -> bool {
    spec == "" || f.trace || f.action != "" && (f.action != "mark" || f.mark != "")
}

/// One 512-byte record at offset 0, synced: a block device takes no O_APPEND write, and
/// the recorder logs every record in order with the data writes, so overwriting is enough.
fn record(f: Fail, point: str, detail: str) {
    var line = "MARK {point}"
    if detail != "" { line = "MARK {point} {detail}" }
    eprint(line)
    var rec = List[byte]()
    for b in line.bytes() {
        if rec.len < 511 { (mut rec).push(b) }
    }
    (mut rec).push(10 as byte)
    while rec.len < 512 { (mut rec).push(0 as byte) }
    let fd = fs_open_mode(f.mark, 3) else |_| {
        eprint("MARK-FAILED open {f.mark}")
        return
    }
    fs_write_chunk(fd, rec) else |_| { eprint("MARK-FAILED write {f.mark}") }
    fs_sync(fd) else |_| { eprint("MARK-FAILED sync {f.mark}") }
    fs_close(fd) else |_| {}
}

fn wait(f: Fail) -> bool {
    let fd = fs_open_mode(f.fifo, 0) else |_| { return false }
    let line = fs_read_chunk(fd, 64) else |_| { List[byte]() }
    fs_close(fd) else |_| {}
    line.len >= 5 && line[0] == 99 as byte && line[1] == 114 as byte && line[2] == 97 as byte
}

/// Pass a named transition. Returns "" to continue, or the injected error's name.
/// crash ends the process at once by a runtime trap (exit 134, no unwinding and no
/// cleanup of any kind); os_exit would need the exec capability paxage never declares.
pub fn hit(f: Fail, point: str, detail: str) -> str {
    if f.action == "mark" {
        record(f, point, detail)
        return ""
    }
    if f.trace {
        if detail == "" {
            eprint("FAILPOINT {point}")
        } else {
            eprint("FAILPOINT {point} {detail}")
        }
        return ""
    }
    if f.name == "" || f.name != point { return "" }
    if f.action == "crash" {
        eprint("CRASH {point}")
        assert(false, "failpoint crash")
    }
    if f.action == "eio" { return "io" }
    if f.action == "enospc" { return "no-space" }
    if f.action == "pause" {
        eprint("PAUSED {point}")
        // "crash" on the fifo ends the paused owner by a trap, so a lock row can show
        // an abrupt owner death without the test signalling any process.
        if wait(f) {
            eprint("CRASH {point}")
            assert(false, "failpoint crash after pause")
        }
    }
    ""
}
