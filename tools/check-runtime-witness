#!/usr/bin/env bash
# Record the requested three-line runtime witness; never alter the runtime.
set -eu
ulimit -c 0
LARDER_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export LARDER_ROOT
cd "$LARDER_ROOT"
. tools/lib-toolchain.sh
out="$LARDER_ROOT/target/runtime-witness"
mkdir -p "$out"
"$WOLF" --version > "$out/version.txt"
cat "$out/version.txt"
for row in trap return; do
  "$WOLF" build --deny-warnings "tests/runtime/$row/main.lu" -o "$out/$row"
  result=0
  if [ "$(uname -s)" = Linux ]; then
    prlimit --as=2147483648 -- "$out/$row" > "$out/$row.stdout" 2> "$out/$row.stderr" || result=$?
  else
    "$out/$row" > "$out/$row.stdout" 2> "$out/$row.stderr" || result=$?
  fi
  printf '%s\n' "$result" > "$out/$row.exit"
  echo "runtime-witness row=$row exit=$result"
  cat "$out/$row.stdout" "$out/$row.stderr"
  if [ "$row" = trap ]; then
    if [ "$result" -ne 134 ]; then echo "FAIL runtime-trap-exit" >&2; exit 1; fi
    if grep -q PM02-before-trap "$out/$row.stderr"; then echo 'before-trap stderr present'; else echo 'before-trap stderr MISSING'; fi
    if grep -q PM02-assert-message "$out/$row.stderr"; then echo 'assert message present'; else echo 'assert message MISSING'; fi
  else
    if [ "$result" -ne 1 ] || ! grep -q PM02-before-return "$out/$row.stderr"; then echo "FAIL runtime-return-control" >&2; exit 1; fi
  fi
done
echo 'END runtime-witness-recorded exit=0'
