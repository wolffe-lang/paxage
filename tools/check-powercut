echo o > /proc/sysrq-trigger
sleep 30
"""


def payload(d, job, bins, extra=()):
    path = d / 'payload.tar'
    with tarfile.open(path, 'w', format=tarfile.GNU_FORMAT) as t:
        def add_bytes(name, data, mode=0o644):
            info = tarfile.TarInfo(name)
            info.size, info.mode, info.mtime = len(data), mode, 0
            t.addfile(info, io.BytesIO(data))
        add_bytes('boot.sh', BOOT_SH.encode(), 0o755)
        add_bytes('job.json', json.dumps(job).encode())
        for f in sorted((ROOT / 'tools').iterdir()):
            if f.is_file():
                t.add(f, f'larder/tools/{f.name}')
        for n in ('paxage', 'paxage-failpoint'):
            t.add(bins / n, f'larder/target/bin/{n}')
        for arc, src in extra:
            t.add(src, arc)
    return path


def boot(name, job, bins, recorded=False, eio='', scratch=False, matrix=False, extra=(), timeout=1800):
    """One guest boot. Returns (relayed PASS/FAIL lines, GUEST lines, the recorder's log dir or None)."""
    d = WORK / 'vm' / name
    d.mkdir(parents=True)
    sock = short_sock()
    g = guest_dir()
    rec = None
    if recorded:
        args = ['--export', f'data:{DATA_SIZE >> 20}M', '--export', 'mark:1M']
        if eio:
            args += ['--eio', eio]
        rec = subprocess.Popen([sys.executable, '-I', str(RECORDER), '--socket', str(sock), '--log',
                                str(d / 'log'), '--connections', '2', '--ready', str(d / 'ready'),
                                '--timeout', str(timeout + 120), *args],
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        deadline = time.monotonic() + 15
        while not (d / 'ready').exists() and time.monotonic() < deadline and rec.poll() is None:
            time.sleep(0.05)
    tar = payload(d, job, bins, extra)
    cmdline = ('root=LABEL=cloudimg-rootfs ro console=ttyS0 quiet loglevel=1 fsck.mode=skip panic=-1 '
               'init=/bin/sh -- -c "mount -t tmpfs -o size=2600m pc /mnt && mkdir /mnt/p && '
               'tar -xf /dev/vdb -C /mnt/p && exec /bin/sh /mnt/p/boot.sh"')
    qemu = ['qemu-system-x86_64', '-enable-kvm', '-cpu', 'host', '-m', '3584', '-smp', '2', '-display', 'none',
            '-monitor', 'none', '-nodefaults', '-no-reboot', '-serial', f'file:{d / "console.log"}',
            '-kernel', str(g / 'ubuntu-24.04-server-cloudimg-amd64-vmlinuz-generic'),
            '-initrd', str(g / 'ubuntu-24.04-server-cloudimg-amd64-initrd-generic'), '-append', cmdline,
            '-drive', f'if=none,id=root,format=qcow2,readonly=on,file={g / "ubuntu-24.04-server-cloudimg-amd64.img"}',
            '-device', 'virtio-blk-pci,drive=root,serial=pcroot',
            '-drive', f'if=none,id=payload,format=raw,readonly=on,file={tar}',
            '-device', 'virtio-blk-pci,drive=payload,serial=pcpayload']
    if recorded:
        for export in ('data', 'mark'):
            qemu += ['-blockdev', f'driver=nbd,node-name={export},server.type=unix,server.path={sock},'
                     f'export={export}', '-device', f'virtio-blk-pci,drive={export},serial=pc{export},write-cache=on']
    for flag, disk, size in ((scratch, 'scratch', 32 << 20), (matrix, 'matrix', 3 << 30)):
        if flag:
            img = d / f'{disk}.img'
            with open(img, 'wb') as f:
                f.truncate(size)
            qemu += ['-drive', f'if=none,id={disk},format=raw,file={img}',
                     '-device', f'virtio-blk-pci,drive={disk},serial=pc{disk},write-cache=on']
    start = time.monotonic()
    try:
        q = subprocess.run(qemu, capture_output=True, text=True, timeout=timeout)
        qrc = q.returncode
        qerr = q.stderr[-400:]
    except subprocess.TimeoutExpired:
        qrc, qerr = 'timeout', f'qemu ran past {timeout}s'
    secs = time.monotonic() - start
    if rec is not None:
        try:
            rec.wait(timeout=60)
        except subprocess.TimeoutExpired:
            rec.terminate()
    console = (d / 'console.log').read_text(errors='replace') if (d / 'console.log').exists() else ''
    relayed, guest = [], []
    for line in console.splitlines():
        line = line.strip('\r')
        if line.startswith('PASS ') or line.startswith('FAIL '):
            relayed.append(line)
            print(line, flush=True)
            if line.startswith('FAIL '):
                FAILED.append(line.split()[1])
        elif line.startswith('GUEST '):
            guest.append(line)
    done = [x for x in guest if x.startswith('GUEST done')]
    print(f'powercut: boot {name} secs={secs:.0f} qemu={qrc} rows={len(relayed)} '
          f'{done[0] if done else "no GUEST done"}', flush=True)
    if not done:
        tail = '\n'.join(console.splitlines()[-12:])
        emit(False, f'vm-boot-{name}', f'qemu={qrc} {qerr!r} console tail: {tail!r}')
    return relayed, guest, (d / 'log') if recorded else None


SOCKETS = []


def short_sock():
    """A unix socket path well under the 104-byte limit, whatever the checkout's depth."""
    d = WORK / 'sk'
    d.mkdir(parents=True, exist_ok=True)
    SOCKETS.append(1)
    path = d / f'{len(SOCKETS)}.sock'
    if len(str(path).encode()) >= 100:
        raise SystemExit(f'FAIL powercut-socket-path {path} is too long for a unix socket')
    return path


def guest_json(guest, prefix):
    return [json.loads(x[len(prefix):]) for x in guest if x.startswith(prefix)]


def eio_runs(fs, bins, run_log, sy):
    """The EIO rows (R-pm04b-1, the recorder's NBD_EIO at a named mark). Separable: a different EIO ruling
    replaces only this function and its rows."""
    sets = []
    scen = sy.scenarios(sy.Log(run_log))
    targets = [('upgrade', 'upgrade', s) for s in EIO_STEPS] + [('rescue', 'rescue-undo', 'rescue:undo:0')]
    for verb, scenario, step in targets:
        marks = [text for _, text in scen.get(scenario, [])]
        steps = [sy.step_of(t) for t in marks]
        if step not in steps[1:]:
            emit(False, f'vm-eio-{fs}-{verb}-{step}', f'no {step} mark in the {scenario} run: {steps}')
            continue
        before = ' '.join(marks[steps.index(step, 1) - 1].split()[:2])
        for cmd in ('write', 'flush'):
            row = f'{verb}-{step}-{cmd}'
            name = f'eio-{verb}-{step.replace(":", "-")}-{cmd}'
            job = {'phase': 'eio', 'fs': fs, 'scenario': name, 'verb': verb, 'row': row}
            try:
                _, guest, log = boot(f'{fs}-{name}', job, bins, recorded=True, eio=f'{before}:{cmd}', timeout=600)
            except RowFailed:
                continue
            spent = 'eio_spent=True' in ((log / 'DONE').read_text() if (log / 'DONE').exists() else '')
            try:
                check(spent, f'vm-eio-{fs}-{row}-injected', f'armed after {before!r}; DONE says {spent}')
            except RowFailed:
                continue
            for sc in guest_json(guest, 'GUEST SCENARIO '):
                sets.append({'log': f'logs/{fs}-{name}', 'src': str(log), 'scenario': name, 'fs': fs,
                             'root': sc['root'], 'old': sc['old'], 'new': sc['new'], 'preen': True,
                             'states': sy.final(sy.Log(log), name, f'vm-eio-{fs}-{row}')})
    return sets


@vm
def guest_rows():
    for piece in (RECORDER, SYNTH, GUEST):
        if missing(piece, ['vm-boot']):
            return
    sy = synth_module()
    bins, built = guest_build()
    for fs in OPTIONS['fs']:
        job = {'phase': 'run', 'fs': fs, 'enospc': True, 'capacity': fs == 'ext4', 'qualify': fs == 'ext4',
               'matrix': not OPTIONS['quick']}
        _, guest, log = boot(f'{fs}-run', job, bins, recorded=True, scratch=True, matrix=True, timeout=3000)
        seen = guest_json(guest, 'GUEST binaries ')
        if fs == OPTIONS['fs'][0]:
            check(any(x.startswith('GUEST start') for x in guest), 'vm-boot', 'no GUEST start line')
            try:
                check(seen and seen[0] == built, 'vm-binaries-match', f'guest={seen} host={built}')
            except RowFailed:
                pass
        sets = []
        for sc in guest_json(guest, 'GUEST SCENARIO '):
            states, steps = sy.plan(sy.Log(log), sc['name'], f'powercut-{fs}')
            print(f'powercut: {fs} {sc["name"]} steps={len(steps)} states={len(states)}', flush=True)
            sets.append({'log': f'logs/{fs}-run', 'src': str(log), 'scenario': sc['name'], 'fs': fs,
                         'root': sc['root'], 'old': sc['old'], 'new': sc['new'], 'states': states})
        if not OPTIONS['quick']:
            sets += eio_runs(fs, bins, log, sy)
        extra = []
        for src in sorted({x['src'] for x in sets}):
            arc = [x['log'] for x in sets if x['src'] == src][0]
            extra += [(f'{arc}/log.jsonl', Path(src) / 'log.jsonl'), (f'{arc}/blobs.bin', Path(src) / 'blobs.bin')]
        job = {'phase': 'check', 'size': DATA_SIZE, 'sets': [{k: v for k, v in x.items() if k != 'src'} for x in sets]}
        total = sum(len(x['states']) for x in sets)
        print(f'powercut: {fs} check boot: {len(sets)} sets, {total} states', flush=True)
        boot(f'{fs}-check', job, bins, extra=extra, timeout=5400)


def main():
    global KEEP_GOING
    ap = argparse.ArgumentParser()
    ap.add_argument('--host', action='store_true', help='the rows that need no VM')
    ap.add_argument('--vm', action='store_true', help='the guest rows (Linux, KVM, the staged image)')
    ap.add_argument('--available', action='store_true', help='can this host run --vm?')
    ap.add_argument('--all', action='store_true', help='keep going after a FAIL')
    ap.add_argument('--fs', default=','.join(FILESYSTEMS), help='development only: a subset of ext4,ext3')
    ap.add_argument('--quick', action='store_true', help='development only: no matrix and no EIO boots')
    args = ap.parse_args()
    KEEP_GOING = args.all
    OPTIONS['fs'] = tuple(f for f in args.fs.split(',') if f in FILESYSTEMS)
    OPTIONS['quick'] = args.quick
    if args.available:
        ok, why = vm_available()
        print('powercut: vm available' if ok else f'powercut: vm unavailable: {why}', flush=True)
        return 0 if ok else 1
    groups = (HOST if args.host or not args.vm else []) + (VM if args.vm else [])
    if args.vm:
        ok, why = vm_available()
        if not ok:
            print(f'FAIL vm-available {why}', flush=True)
            return 1
    if WORK.exists():
        shutil.rmtree(WORK)
    WORK.mkdir(parents=True, mode=0o755)
    for fn in groups:
        try:
            fn()
        except RowFailed:
            continue
    if FAILED:
        print(f'powercut: {len(FAILED)} red rows', flush=True)
        return 1
    print('PASS powercut', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
