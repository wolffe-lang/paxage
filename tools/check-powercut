class RowFailed(Exception):
    pass


def emit(ok, row, detail=''):
    if ok:
        print(f'PASS {row}', flush=True)
        return True
    print(f'FAIL {row}' + (f' {detail}' if detail else ''), flush=True)
    FAILED.append(row)
    if not KEEP_GOING:
        raise SystemExit(1)
    raise RowFailed(row)


def check(ok, row, detail=''):
    return emit(bool(ok), row, detail)


def missing(piece, rows):
    """Every row of a group FAILs by name while the piece it drives is absent."""
    if piece.exists():
        return False
    for name in rows:
        try:
            emit(False, name, f'missing {piece.relative_to(ROOT)}')
        except RowFailed:
            pass
    return True


