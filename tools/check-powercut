def guest_build():
    """paxage and paxage-failpoint built in the guest's own release (R-pm04b-3), same commit and toolchain."""
    out = WORK / 'guest-bin'
    src = WORK / 'guest-src'
    out.mkdir(parents=True)
    shutil.copytree(ROOT, src, symlinks=True,
                    ignore=shutil.ignore_patterns('target', '.wolf-bin', '.git', '.lu-cache', '__pycache__'))
    engine = os.environ.get('LARDER_CONTAINER_ENGINE') or shutil.which('podman') or 'podman'
    image = os.environ['LARDER_GUEST_BUILD_IMAGE']
    cpus = os.environ.get('LARDER_CPUS', '')
    pin = f'taskset -c {cpus} ' if cpus else ''
    toolchain = (ROOT / '.wolf-bin').resolve()
    args = [engine, 'run', '--rm', '--network', 'none', '--memory', os.environ.get('LARDER_CONTAINER_MEMORY', '8g'),
            '-v', f'{src.resolve()}:/w', '-v', f'{toolchain}:/w/.wolf-bin:ro', '-v', f'{out.resolve()}:/out', image,
            'bash', '-c', f'cd /w && {pin}tools/build > /out/build.log 2>&1 && '
                          'cp target/bin/paxage target/bin/paxage-failpoint /out/']
    p = subprocess.run(args, capture_output=True, text=True, timeout=1800)
    built = {n: sha256_file(out / n) for n in ('paxage', 'paxage-failpoint') if (out / n).exists()}
    tail = (out / 'build.log').read_text()[-400:] if (out / 'build.log').exists() else ''
    check(p.returncode == 0 and len(built) == 2, 'vm-guest-build', f'rc={p.returncode} {p.stderr[-300:]!r} {tail!r}')
    print(f'powercut: guest binaries {json.dumps(built, sort_keys=True)}', flush=True)
    return out, built


