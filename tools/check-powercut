def guest_dir():
    return Path(os.environ.get('LARDER_GUEST_DIR', ''))


def vm_available():
    if sys.platform != 'linux':
        return False, 'not Linux'
    if not os.access('/dev/kvm', os.R_OK | os.W_OK):
        return False, 'no read-write /dev/kvm'
    if not shutil.which('qemu-system-x86_64'):
        return False, 'no qemu-system-x86_64 in PATH'
    d = guest_dir()
    if not os.environ.get('LARDER_GUEST_DIR') or not all((d / f).is_file() for f in GUEST_FILES):
        return False, 'LARDER_GUEST_DIR does not hold the staged Ubuntu 24.04 image'
    if not os.environ.get('LARDER_GUEST_BUILD_IMAGE'):
        return False, 'no LARDER_GUEST_BUILD_IMAGE to build the guest binaries in'
    return True, ''


@vm
def inputs_digests():
    d = guest_dir()
    bad = [f'{f} {sha256_file(d / f)}' for f, want in GUEST_FILES.items() if sha256_file(d / f) != want]
    check(not bad, 'vm-inputs-digests', f'refused: {bad}')


