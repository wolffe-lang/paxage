@row('fetch-next-root-503')
def next_root_503(e):
    label = 'rotate'
    path = f'/{label}/metadata/2.root.json'
    s = root_failure(e, label, lambda l: {path: {'kind': 'status', 'code': 503}},
                     'root: http-status 503', 'fetch-next-root-503')
    if s is None:
        return
    ct.check(s.count(path) == 3, 'fetch-next-root-503-three-attempts', f'requests={s.count(path)}')
    # The repository then rotates; the next install, with the server healthy, takes root 2.
    local = e.www / label
    p = pxg('repo', 'rotate', '--repo', local.as_uri(), '--old-keys', e.repo.keys, '--keys', e.repo.keys,
            '--version', '2', '--now', NOW)
    if not ct.ok(p, 'fetch-next-root-503-rotate', last='repo rotate ok'):
        return
    del s.rules[path]
    root = sorted((WORK / 'runs').glob('*-fetch-next-root-503'))[-1] / 'root'
    q = install(root, e.pki.roots, 'alpha', binary=FPBIN, env=FAST)
    ct.ok(q, 'fetch-next-root-503-then-rotates', last='install ok generation=1')
    ct.check(s.count(path) == 4, 'fetch-next-root-503-root-2-read', f'requests={s.count(path)}')


@row('fetch-repo-changes')
def repo_changes(e):
    label = 'changes'
    local = e.copy(label)
    newer = e.copy(f'{label}-next')
    p = pxg('repo', 'publish', '--repo', newer.as_uri(), '--keys', e.repo.keys, '--version', '2',
            *sum((['--manifest', m, '--buildinfo', b] for m, b in e.repo.built.values()), []), '--now', NOW)
    if not ct.ok(p, 'fetch-repo-changes-publish', last='repo publish ok'):
        return

    def swap(_path):
        # The publisher moves on between the timestamp read and the snapshot read.
        for name in ['2.snapshot.json', '2.targets.json', 'timestamp.json']:
            shutil.copyfile(newer / 'metadata' / name, local / 'metadata' / name)
        (local / 'metadata/1.snapshot.json').unlink()
    server, url = e.serve(label, copy=False)
    state, q = bootstrap(e, url, 'fetch-repo-changes')
    if not ct.ok(q, 'fetch-repo-changes-bootstrap', last='bootstrap ok'):
        return
    server.rules[f'/{label}/metadata/1.snapshot.json'] = {'kind': 'hook', 'call': swap, 'times': 1}
    ct.ok(update(url, state, e.pki.roots), 'fetch-repo-changes-one-restart', last='update ok')
    ct.check(server.count(f'/{label}/metadata/timestamp.json') == 2, 'fetch-repo-changes-restarted-once',
             str(server.log))


