@row('fetch-http-503-retry')
def http_503_retry(e):
    server, url = e.serve('retry')
    state, p = bootstrap(e, url, 'fetch-http-503-retry')
    if not ct.ok(p, 'fetch-http-503-retry-bootstrap', last='bootstrap ok'):
        return
    server.rules['/retry/metadata/timestamp.json'] = {'kind': 'status', 'code': 503, 'times': 2}
    started = time.monotonic()
    q = update(url, state, e.pki.roots)
    took = time.monotonic() - started
    ct.ok(q, 'fetch-http-503-retry', last='update ok')
    ct.check(server.count('/retry/metadata/timestamp.json') == 3 and took >= 40, 'fetch-http-503-retry-shipped-waits',
             f'requests={server.count("/retry/metadata/timestamp.json")} seconds={took:.1f}')


def root_failure(e, label, rules, needle, rowname, names=('alpha',), fast=True):
    """A failpoint-binary install over https against a fixture with rules; returns the server."""
    server, url = e.serve(label)
    root = ready_root(e, url, rowname, binary=FPBIN)
    if root is None:
        return None
    for path, rule in rules(label).items():
        server.rules[path] = rule
    p = install(root, e.pki.roots, *names, binary=FPBIN, env=FAST if fast else None)
    ct.refused(p, rowname, 1, needle)
    return server


