# ---------------------------------------------------------------- the cache and target kinds

@row('fetch-part-reaper')
def part_reaper(e):
    local = e.copy('reaper')
    obj = next((local / 'targets').glob(f'*.{PAYLOAD}'))
    data = bytearray(obj.read_bytes())
    data[len(data) // 2] ^= 0x01
    obj.write_bytes(bytes(data))
    url = local.as_uri()
    state, p = bootstrap(e, url, 'fetch-part-reaper')
    if not ct.ok(p, 'fetch-part-reaper-bootstrap', last='bootstrap ok'):
        return
    if not ct.ok(update(url, state, None), 'fetch-part-reaper-update', last='update ok'):
        return
    cache = state.parent / 'cache'
    last = None
    for _ in range(65):
        last = fetch(url, state, cache, PAYLOAD, None)
        if last.returncode != 1 or 'target-hash' not in last.stderr:
            break
    ct.refused(last, 'fetch-part-reaper', 1, 'target-hash')
    parts = list((cache / '.part').iterdir()) if (cache / '.part').is_dir() else []
    ct.check(len(parts) <= 1, 'fetch-part-reaper-slots', f'parts={len(parts)}')


@row('fetch-unknown-kind')
def unknown_kind(e):
    tv = load('generate_trust_vectors', 'generate-trust-vectors')
    tool = e.pki.tool

    def command(*args):
        p = subprocess.run([tool, *map(str, args)], capture_output=True, timeout=30)
        if p.returncode:
            raise RuntimeError(f'OpenSSL black-box exit={p.returncode}: {p.stderr.decode(errors="replace")}')
        return p.stdout
    tv.command = command
    home = e.fresh('unknown-kind')
    gen = tv.Generator(home / 'out', home / 'keys')
    repo = home / 'repo'
    (repo / 'metadata').mkdir(parents=True)
    (repo / 'targets').mkdir()
    root = gen.root(1)
    (repo / 'metadata/1.root.json').write_bytes(tv.canonical(root))
    body = gen.target_body(100)
    data = b'test-only target of a kind this client does not know\n'
    body['targets']['alpha-1-1.index'] = {
        'length': len(data), 'hashes': {'sha256': tv.digest(data)},
        'custom': {'name': 'alpha', 'version': '1-1', 'architecture': 'x86_64', 'kind': 'index'}}
    (repo / 'targets' / f'{tv.digest(data)}.alpha-1-1.index').write_bytes(data)
    gen.chain(repo, target_body=body)
    pinned = repo / 'metadata/1.root.json'
    url = repo.as_uri()
    state = home / 'state'
    p = pxg('bootstrap', '--repo', url, '--root', pinned, '--state', state, '--now', tv.NOW)
    if not ct.ok(p, 'fetch-unknown-kind-bootstrap', last='bootstrap ok'):
        return
    p = pxg('update', '--repo', url, '--state', state, '--now', tv.NOW)
    ct.ok(p, 'fetch-unknown-kind', last='update ok')
    p = pxg('fetch', '--repo', url, '--state', state, '--cache', home / 'cache', '--target', 'alpha-1-1.index',
            '--now', tv.NOW)
    ct.refused(p, 'fetch-unknown-kind-never-used', 1, 'target-kind')


