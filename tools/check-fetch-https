#!/usr/bin/env python3
"""The HTTPS transport rows: paxage against a loopback repository fixture.

Every row prints PASS or FAIL by name and every row runs; the step fails at the
end if any row is red. The fixture (tools/fetch-fixture) serves copies of one
test repository built by paxage's own test-only writer, over TLS 1.3 under a
per-run test CA, or over plain HTTP on 127.0.0.1 (the one plaintext form the
client accepts). Nothing leaves the loopback interface except the one name
lookup of a `.invalid` name, which RFC 6761 answers with NXDOMAIN.

Rows that need short retry waits or a short read deadline run through the
test-only paxage-failpoint binary with PAXAGE_FETCH_KNOBS; the shipped binary's
waits are fixed, and fetch-http-503-retry runs it at those waits.
"""
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True  # loaded modules leave no __pycache__ in the checkout
import time

ROOT = Path(__file__).resolve().parent.parent
TOOLS = ROOT / 'tools'


def load(name, file):
    loader = importlib.machinery.SourceFileLoader(name, str(TOOLS / file))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


fx = load('fetch_fixture', 'fetch-fixture')
ct = load('check_transactions', 'check-transactions')
BIN = ROOT / 'target/bin/paxage'
FPBIN = ROOT / 'target/bin/paxage-failpoint'
WORK = ROOT / 'target/fetch-https'
ct.BIN, ct.FPBIN, ct.WORK, ct.KEEP_GOING = BIN, FPBIN, WORK, True
NOW = ct.NOW
FAST = {'PAXAGE_FETCH_KNOBS': 'waits=0,0 read=1500'}
PAYLOAD = 'alpha-1-1.payload.tar'

ROWS = []


def row(name):
    def wrap(fn):
        ROWS.append((name, fn))
        return fn
    return wrap


class Env:
    """The run's PKI, its repository and helpers to serve copies of it."""

    def __init__(self):
        self.pki = fx.Pki(WORK / 'pki')
        print(f'fetch-https: {self.pki.version}', flush=True)
        fixture = ct.fixture_dir(WORK / 'fixture')
        ct.fixture_dir(fixture / 'packages')
        self.repo = ct.Repo(fixture)
        self.repo.setup()
        self.repo.publish([ct.simple('alpha'), ct.simple('beta', requires=[ct.dep('alpha')])])
        self.www = WORK / 'www'
        self.www.mkdir()
        self.servers = []
        self.count = 0

    def copy(self, label):
        dst = self.www / label
        shutil.copytree(self.repo.repo, dst)
        return dst

    def serve(self, label, cert='good', groups=None, tls=True, copy=True):
        if copy:
            self.copy(label)
        if tls:
            c, k = getattr(self.pki, cert.replace('-', '_'))
            server, port = fx.serve(self.www, c, k, groups)
        else:
            server, port = fx.serve(self.www)
        self.servers.append(server)
        scheme, host = ('https', 'localhost') if tls else ('http', '127.0.0.1')
        return server, f'{scheme}://{host}:{port}/{label}/'

    def object_path(self, label, logical):
        found = sorted((self.www / label / 'targets').glob(f'*.{logical}'))
        return f'/{label}/targets/{found[0].name}'

    def fresh(self, label):
        self.count += 1
        d = WORK / 'runs' / f'{self.count:03d}-{label}'
        d.mkdir(parents=True, mode=0o700)
        return d


def pxg(*args, binary=BIN, env=None, timeout=300):
    return ct.pxg(*args, binary=binary, env=env, timeout=timeout)


def bootstrap(e, url, label):
    state = e.fresh(label) / 'state'
    p = pxg('bootstrap', '--repo', url, '--root', e.repo.pinned, '--state', state, '--now', NOW)
    return state, p


def trusted(e, url, label, roots=None):
    """A bootstrapped and updated state, or a red row naming the setup step."""
    state, p = bootstrap(e, url, label)
    if not ct.ok(p, f'{label}-bootstrap', last='bootstrap ok'):
        return None
    p = update(url, state, roots or e.pki.roots)
    if not ct.ok(p, f'{label}-update', last='update ok'):
        return None
    return state


def update(url, state, roots, *extra, binary=BIN, env=None, now=NOW):
    args = ['update', '--repo', url, '--state', state, '--now', now]
    if roots:
        args += ['--tls-roots', roots]
    return pxg(*args, *extra, binary=binary, env=env)


def fetch(url, state, cache, target, roots, *extra, binary=BIN, env=None):
    args = ['fetch', '--repo', url, '--state', state, '--cache', cache, '--target', target, '--now', NOW]
    if roots:
        args += ['--tls-roots', roots]
    return pxg(*args, *extra, binary=binary, env=env)


def root_init(e, url, label, binary=BIN):
    root = e.fresh(label) / 'root'
    root.mkdir(mode=0o755)
    p = pxg('init', '--root', root, '--repo', url, '--pinned-root', e.repo.pinned,
            '--arch', ct.ARCH, '--slot', ct.SLOT, '--now', NOW, binary=binary)
    return root, p


def install(root, roots, *names, binary=BIN, env=None):
    args = ['install', '--root', root, *names, '--now', NOW]
    if roots:
        args += ['--tls-roots', roots]
    return pxg(*args, binary=binary, env=env)


def ready_root(e, url, label, binary=BIN):
    root, p = root_init(e, url, label, binary=binary)
    if not ct.ok(p, f'{label}-init', last='init ok'):
        return None
    return root


# ---------------------------------------------------------------- the transport

@row('fetch-https-transport')
def https_transport(e):
    server, url = e.serve('transport')
    state = trusted(e, url, 'fetch-https-transport', e.pki.roots)
    if state is None:
        return
    staged = e.fresh('transport-stage') / 'stage'
    staged.mkdir(mode=0o700)
    cache = staged.parent / 'cache'
    p = fetch(url, state, cache, PAYLOAD, e.pki.roots, '--stage', staged)
    ct.ok(p, 'fetch-https-transport-fetch', last='fetch ok')
    body = (staged / 'usr/share/alpha/alpha')
    ct.check(body.is_file() and body.read_bytes() == b'alpha 1-1\n', 'fetch-https-transport-staged-tree')
    root = ready_root(e, url, 'fetch-https-transport-root')
    if root is None:
        return
    p = install(root, e.pki.roots, 'beta')
    ct.ok(p, 'fetch-https-transport-install', last='install ok generation=1')
    ct.check(set(ct.installed(root)) == {'alpha', 'beta'}, 'fetch-https-transport-installed',
             str(ct.installed(root)))
    ct.check(server.count('/transport/metadata/timestamp.json') >= 2, 'fetch-https-transport-reached')


