def main():
    if WORK.exists():
        shutil.rmtree(WORK)
    WORK.mkdir(parents=True, mode=0o755)
    wanted = set(filter(None, (sys.argv[1] if len(sys.argv) > 1 else '').split(',')))
    e = Env()
    try:
        for name, fn in ROWS:
            if wanted and name not in wanted:
                continue
            try:
                fn(e)
            except ct.RowFailed:
                continue
            except Exception as exc:
                try:
                    ct.emit(False, name, f'crashed {type(exc).__name__}: ' + ' | '.join(str(exc).splitlines()))
                except ct.RowFailed:
                    continue
    finally:
        for s in e.servers:
            fx.stop(s)
    if ct.FAILED:
        print(f'fetch-https: {len(ct.FAILED)} red rows: {" ".join(ct.FAILED)}', flush=True)
        return 1
    print('PASS fetch-https', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
