def file_refusal(e, label, mutate, verb):
    """The refusal file:// gives for a mutated copy, the reference the https row must equal."""
    local = e.copy(f'{label}-file')
    mutate(local)
    url = local.as_uri()
    state, p = bootstrap(e, url, f'{label}-file')
    if p.returncode != 0:
        return None, ct.describe(p)
    if verb == 'update':
        q = update(url, state, None)
    else:
        q = update(url, state, None)
        if q.returncode != 0:
            return None, ct.describe(q)
        q = fetch(url, state, state.parent / 'cache', PAYLOAD, None)
    return q, ''


@row('fetch-object-missing')
def object_missing(e):
    def no_snapshot(d):
        (d / 'metadata/1.snapshot.json').unlink()

    def no_payload(d):
        next((d / 'targets').glob(f'*.{PAYLOAD}')).unlink()

    for name, mutate, verb in [('snapshot', no_snapshot, 'update'), ('payload', no_payload, 'fetch')]:
        rowname = f'fetch-object-missing-{name}'
        reference, why = file_refusal(e, f'missing-{name}', mutate, verb)
        if reference is None:
            ct.check(False, rowname, f'file:// reference setup: {why}')
            continue
        server, url = e.serve(f'missing-{name}-https')
        mutate(e.www / f'missing-{name}-https')
        state, p = bootstrap(e, url, rowname)
        if not ct.ok(p, f'{rowname}-bootstrap', last='bootstrap ok'):
            continue
        q = update(url, state, e.pki.roots)
        if verb == 'fetch' and q.returncode == 0:
            q = fetch(url, state, state.parent / 'cache', PAYLOAD, e.pki.roots)
        ct.check(reference.returncode == 1 and q.returncode == 1 and q.stderr == reference.stderr, rowname,
                 f'file:// {ct.describe(reference)} https {ct.describe(q)}')


