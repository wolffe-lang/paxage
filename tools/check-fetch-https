@row('fetch-locked')
def locked(e):
    server, url = e.serve('locked')
    root = ready_root(e, url, 'fetch-locked')
    if root is None:
        return
    path = '/locked/metadata/timestamp.json'
    server.rules[path] = {'kind': 'hold', 'max': 60}
    first = subprocess.Popen([str(BIN), 'install', '--root', str(root), 'alpha', '--now', NOW,
                              '--tls-roots', str(e.pki.roots)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, preexec_fn=ct.no_core)
    deadline = time.monotonic() + 30
    while server.count(path) == 0 and time.monotonic() < deadline and first.poll() is None:
        time.sleep(0.1)
    held = server.count(path) == 1 and first.poll() is None
    second = install(root, e.pki.roots, 'alpha')
    server.release()
    out, err = first.communicate(timeout=120)
    ct.check(held, 'fetch-locked-first-held', f'exit={first.returncode} stderr={err[-300:]!r}')
    ct.refused(second, 'fetch-locked', 7, 'locked')
    ct.check(first.returncode == 0 and out.splitlines()[-1:] == ['install ok generation=1'],
             'fetch-locked-first-completes', f'exit={first.returncode} stdout={out!r} stderr={err[-300:]!r}')


