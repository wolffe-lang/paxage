def trust_failure(e, label, rule_paths, needle, rowname, verb='update'):
    server, url = e.serve(label)
    state = trusted(e, url, rowname) if verb == 'fetch' else None
    if verb == 'update':
        state, p = bootstrap(e, url, rowname)
        if not ct.ok(p, f'{rowname}-bootstrap', last='bootstrap ok'):
            return None, None
    elif state is None:
        return None, None
    paths = rule_paths(label)
    for path, rule in paths.items():
        server.rules[path] = rule
    if verb == 'update':
        q = update(url, state, e.pki.roots)
    else:
        q = fetch(url, state, state.parent / 'cache', PAYLOAD, e.pki.roots)
    ct.refused(q, rowname, 1, needle)
    return server, list(paths)


