#!/usr/bin/env python3
"""T11-T16 real CLI round trips; no crypto/reference implementation imports."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
BIN = ROOT / 'target/bin/larder'
WORK = ROOT / 'target/trust-e2e'
NOW = '2026-11-03T00:00:00Z'

def check(ok, row):
    if not ok:
        print(f'FAIL {row}')
        raise SystemExit(1)
    print(f'PASS {row}')

def run(row, *args, error=None, last=None):
    p = subprocess.run([str(BIN), *map(str, args)], capture_output=True, text=True, timeout=30)
    if error is None:
        ok = p.returncode == 0 and not p.stderr
        if last is not None:
            ok = ok and p.stdout.splitlines()[-1:] == [last]
    else:
        ok = p.returncode == 1 and error in p.stderr and not p.stdout
    if not ok:
        print(f'FAIL {row} exit={p.returncode} stdout={p.stdout!r} stderr={p.stderr!r}')
        raise SystemExit(1)
    print(f'PASS {row}')
    return p.stdout

def package(name, version):
    src = WORK / f'{name}-{version}-source'
    out = WORK / f'{name}-{version}-pack'
    (src / 'usr/share').mkdir(parents=True)
    out.mkdir()
    (src / 'usr/share' / name).write_bytes(f'{name} {version}\n'.encode())
    buildinfo = WORK / f'{name}-{version}.buildinfo'
    buildinfo.write_text(f'buildinfo {{ test_only: true, name: "{name}", version: "{version}" }}\n')
    template = (ROOT / 'tests/manifests/valid.manifest').read_text()
    template = template.replace('name: "sample"', f'name: "{name}"').replace('version: "1-1"', f'version: "{version}"')
    template = template.replace('buildinfo: "' + '0' * 64 + '"', 'buildinfo: "' + hashlib.sha256(buildinfo.read_bytes()).hexdigest() + '"')
    manifest = WORK / f'{name}-{version}.template'
    manifest.write_text(template)
    run(f'T16-pack-{name}-{version}', 'pack', src, manifest, out, '--epoch', '100', last=f'pack ok {name}-{version}')
    return src, out / f'{name}-{version}.manifest', buildinfo

def tree(path):
    return {str(p.relative_to(path)): ('dir' if p.is_dir() else 'file', p.stat().st_mode & 0o777,
                                      None if p.is_dir() else p.read_bytes())
            for p in path.rglob('*')}

def main():
    WORK.mkdir(mode=0o700)
    keys, repo, state, cache = [WORK / n for n in ('test-only-keys', 'repo', 'state', 'cache')]
    url = repo.as_uri()
    run('T15-keygen', 'repo', 'keygen', '--keys', keys, '--now', NOW, last='repo keygen ok')
    files = list(keys.glob('*.test-only.key'))
    check(len(files) == 6, 'T15-six-test-keys')
    for key in files:
        check(key.stat().st_mode & 0o777 == 0o600 and json.loads(key.read_text())['test-only'] is True, f'T15-key-marker-mode-{key.name}')
    unmarked = keys / 'root1.test-only.key'
    key_bytes = unmarked.read_bytes(); key_data = json.loads(key_bytes); key_data['test-only'] = False
    unmarked.write_text(json.dumps(key_data))
    run('T15-unmarked-key-refused', 'repo', 'init', '--repo', url, '--keys', keys, '--now', NOW,
        error="Real repository keys need std's constant-time signing review and the maintainer's ceremony (R-pm00-7)")
    check(not list((repo / 'metadata').iterdir()), 'T15-unmarked-key-no-signatures')
    unmarked.write_bytes(key_bytes)
    run('T15-init', 'repo', 'init', '--repo', url, '--keys', keys, '--now', NOW, last='repo init ok')
    pinned = WORK / 'pinned-root.json'
    shutil.copyfile(repo / 'metadata/1.root.json', pinned)
    run('T15-root-create-only', 'repo', 'init', '--repo', url, '--keys', keys, '--now', NOW, error='immutable-rewrite')
    alpha = package('alpha', '1-1')
    beta = package('beta', '1-1')
    original_manifest = alpha[1].read_bytes()
    changed_manifest = WORK / 'changed.manifest'
    changed_manifest.write_bytes(original_manifest.replace(b'name: "alpha"', b'name: "other"', 1))
    payload = alpha[1].with_name('alpha-1-1.payload.tar')
    destination = WORK / 'bound-manifest-stage'; destination.mkdir(mode=0o700)
    bound = ['stage', payload, '--length', str(payload.stat().st_size), '--sha256', hashlib.sha256(payload.read_bytes()).hexdigest(),
             '--manifest', changed_manifest, '--manifest-sha256', hashlib.sha256(original_manifest).hexdigest(),
             '--manifest-length', str(len(original_manifest)), '--into', destination]
    run('T16-manifest-replacement-at-consumption', *bound, error='manifest-digest')
    check(not list(destination.iterdir()), 'T16-replaced-manifest-zero-writes')
    bound[bound.index('--manifest') + 1] = alpha[1]
    bound[bound.index('--manifest-length') + 1] = str(len(original_manifest) + 1)
    run('T16-manifest-length-at-consumption', *bound, error='manifest-length')
    check(not list(destination.iterdir()), 'T16-manifest-length-zero-writes')
    bound[bound.index('--manifest-length') + 1] = str(len(original_manifest))
    run('T16-bound-manifest-stage', *bound, last='stage ok entries=3')
    check(tree(alpha[0]) == tree(destination), 'T16-bound-manifest-exact-tree')
    run('T15-publish-first', 'repo', 'publish', '--repo', url, '--keys', keys, '--version', '1',
        '--manifest', alpha[1], '--buildinfo', alpha[2], '--manifest', beta[1], '--buildinfo', beta[2], '--now', NOW,
        last='repo publish ok')
    run('T11-bootstrap', 'bootstrap', '--repo', url, '--root', pinned, '--state', state, '--now', NOW, last='bootstrap ok')
    run('T13-update-first', 'update', '--repo', url, '--state', state, '--now', NOW, last='update ok')
    run('T13-update-idempotent', 'update', '--repo', url, '--state', state, '--now', NOW, last='update ok')
    for name, source in [('alpha', alpha[0]), ('beta', beta[0])]:
        staged = WORK / f'{name}-staged'
        staged.mkdir(mode=0o700)
        run(f'T16-fetch-stage-{name}', 'fetch', '--repo', url, '--state', state, '--cache', cache,
            '--target', f'{name}-1-1.payload.tar', '--stage', staged, '--now', NOW, last='fetch ok')
        if tree(source) != tree(staged):
            print(f'FAIL T16-exact-tree-{name}'); return 1
        print(f'PASS T16-exact-tree-{name}')
    old_timestamp = (repo / 'metadata/timestamp.json').read_bytes()
    alpha2 = package('alpha', '2-1')
    (repo / 'metadata/2.snapshot.json').write_bytes(b'test-only blocked create-only output')
    run('T15-publish-interruption', 'repo', 'publish', '--repo', url, '--keys', keys, '--version', '2',
        '--manifest', alpha2[1], '--buildinfo', alpha2[2], '--manifest', beta[1], '--buildinfo', beta[2], '--now', NOW,
        error='immutable-rewrite')
    check((repo / 'metadata/timestamp.json').read_bytes() == old_timestamp, 'T15-timestamp-last-on-failure')
    run('T15-old-publication-still-usable', 'update', '--repo', url, '--state', state, '--now', NOW, last='update ok')
    # Test-operator cleanup of deliberately unpublished outputs, not writer repair.
    (repo / 'metadata/2.snapshot.json').unlink(); (repo / 'metadata/2.targets.json').unlink()
    run('T15-publish-second', 'repo', 'publish', '--repo', url, '--keys', keys, '--version', '2',
        '--manifest', alpha2[1], '--buildinfo', alpha2[2], '--manifest', beta[1], '--buildinfo', beta[2], '--now', NOW,
        last='repo publish ok')
    run('T13-update-second', 'update', '--repo', url, '--state', state, '--now', NOW, last='update ok')
    staged = WORK / 'alpha2-staged'; staged.mkdir(mode=0o700)
    run('T16-fetch-stage-second', 'fetch', '--repo', url, '--state', state, '--cache', cache,
        '--target', 'alpha-2-1.payload.tar', '--stage', staged, '--now', NOW, last='fetch ok')
    if tree(alpha2[0]) != tree(staged): print('FAIL T16-exact-tree-second'); return 1
    print('PASS T16-exact-tree-second')
    latest = (repo / 'metadata/timestamp.json').read_bytes()
    (repo / 'metadata/timestamp.json').write_bytes(old_timestamp)
    before = (state / 'current').read_bytes()
    run('T13-rollback-timestamp', 'update', '--repo', url, '--state', state, '--now', NOW, error='rollback-timestamp')
    check((state / 'current').read_bytes() == before, 'T13-refusal-preserves-generation')
    (repo / 'metadata/timestamp.json').write_bytes(latest + b'\n')
    run('T13-timestamp-rewrite', 'update', '--repo', url, '--state', state, '--now', NOW, error='same-version-rewrite')
    (repo / 'metadata/timestamp.json').write_bytes(latest)
    run('T13-clock-floor', 'update', '--repo', url, '--state', state, '--now', '2026-11-02T23:59:59Z', error='clock-before-floor')
    run('T1-network-refused', 'update', '--repo', 'https://invalid.example/', '--state', state, '--now', NOW, error='unsupported-transport')
    run('T1-offline-recovery-refused', 'recover-offline', error='offline-recovery-refused')
    for version in range(2, 35):
        run(f'T12-publish-root-{version}', 'repo', 'rotate', '--repo', url, '--old-keys', keys, '--keys', keys,
            '--version', str(version), '--now', NOW, last='repo rotate ok')
    last_root = repo / 'metadata/34.root.json'
    last_bytes = last_root.read_bytes()
    if sys.platform == 'linux': last_root.write_bytes(b' ' * 65537)
    run('T1-root-chain-limit', 'update', '--repo', url, '--state', state, '--now', NOW, error='root-chain-limit')
    pointer = json.loads((state / 'current').read_bytes())
    stored_root = json.loads((state / f'g{pointer["generation"]}' / 'root.json').read_bytes())
    check(stored_root['signed']['version'] == 33, 'T12-last-verified-root-durable')
    last_root.write_bytes(last_bytes)
    run('T12-root-chain-resume', 'update', '--repo', url, '--state', state, '--now', NOW, last='update ok')
    evidence = Path(os.environ.get('LARDER_WRITER_EVIDENCE', ROOT / 'target/evidence/trust-writer-metadata'))
    evidence.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(repo / 'metadata', evidence)
    print('PASS trust-e2e')
    return 0

if __name__ == '__main__':
    sys.exit(main())
