#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
step() {
  local name=$1 started=$SECONDS result=0
  shift
  printf 'START %s\n' "$name"
  "$@" || result=$?
  printf 'END %s exit=%s secs=%s\n' "$name" "$result" "$((SECONDS-started))"
  return "$result"
}
case "${1:-e2e}" in
  e2e|corruption) suite=${1:-e2e} ;;
  *) echo 'usage: check-trust-integration [e2e|corruption]' >&2; exit 2 ;;
esac
step trust-cli-build bash tools/build
step "trust-cli-$suite" python3 -I "tools/check-trust-$suite"
