#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
step() {
  local name=$1 started=$SECONDS result=0
  shift
  printf 'START %s\n' "$name"
  "$@" || result=$?
  printf 'END %s exit=%s secs=%s\n' "$name" "$result" "$((SECONDS-started))"
  return "$result"
}
step trust-cli-build bash tools/build
step trust-cli-e2e python3 -I tools/check-trust-e2e
