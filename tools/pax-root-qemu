#!/usr/bin/env bash
# Install the supplied verified ISO to a new sparse QEMU disk, add only the
# test probe offline, then run it from that installed root. Never host devices.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
: "${CENSUS_OUT:?}" "${CENSUS_IMAGE_DIR:?}" "${CENSUS_ENGINE:?}" "${LIGHT_CPUS:?}" "${CENSUS_PAX:?}"
export TMPDIR=${TMPDIR:?}
export PAX_BUILD=$CENSUS_OUT/qemu-build PAX_CACHE=$CENSUS_OUT/qemu-cache
mkdir -p "$PAX_BUILD" "$PAX_CACHE"
[ ! -e "$CENSUS_OUT/installed.img" ] || { printf 'REFUSED installed disk already exists\n'; exit 2; }
# The scripts and kernel are read-only inputs. The output mount is the only
# writable mount; the container receives no host block device or host network.
"$CENSUS_ENGINE" run -i --rm --network none --memory "${LIGHT_MEM:-6g}" --device /dev/kvm \
  -e LIGHT_CPUS -e TMPDIR=/out/tmp -e PAX_BUILD=/out/qemu-build -e PAX_CACHE=/out/qemu-cache \
  -v "$CENSUS_OUT:/out" -v "$CENSUS_IMAGE_DIR:/images:ro" \
  -v "$CENSUS_PAX:/pax:ro" -v "$root:/source:ro" \
  6bab9e961bed5df88a060156f7e9967a8868c255eb396b5f48aa0fb6a9452f23 \
  taskset -c "$LIGHT_CPUS" bash -s <<'GUEST_RIG'
set -euo pipefail
mkdir -p /out/tmp /out/qemu-build /out/qemu-cache
sha256sum /images/pax-bf1e38db.iso
[ "$(sha256sum /images/pax-bf1e38db.iso | cut -d' ' -f1)" = 8b89157e52275debf7de63a5fe93dcd65a5e4b1c3d18f9901338abd968b9a07f ]
truncate -s 1073741824 /out/installed.img
printf '%s\n' "printf 'model= serial=PM05B-TARGET\\n' > /run/census-targets" \
  "pax-install --install --ext2-preview --target vda --seed pm05b-image --user pax --games no --allow-list /run/census-targets --confirm 'ERASE /dev/vda 254:0-seq1 1073741824 pm05b-image'" \
  'echo CENSUS_INSTALL=$?' 'exit 0' > /out/install.keys
/pax/tools/qemu-halt --accel kvm --firmware bios --serial /out/install.serial --timeout 900 \
  --qemu -m --qemu 2048M --elf /images/kernel/kmain_console.elf \
  --drive '/out/installed.img;serial=PM05B-TARGET' --type /out/install.keys --prompt '$ ' \
  --marker 'halt|PANIC .*' /images/pax-bf1e38db.iso > /out/install.halt 2>&1
python3 -I - <<'PY'
from pathlib import Path
import re,struct
s=re.sub(rb'\x1b\[[0-9;?=<>]*[A-Za-z]',b'',Path('/out/install.serial').read_bytes()).replace(b'\r',b'')
assert b'\nCENSUS_INSTALL=0\n' in s,s[-6000:]
with Path('/out/installed.img').open('rb') as f:
 f.seek(512);h=f.read(512);assert h[:8]==b'EFI PART'
 table=struct.unpack_from('<Q',h,72)[0];width=struct.unpack_from('<I',h,84)[0]
 f.seek(table*512+width);e=f.read(width);start,end=struct.unpack_from('<QQ',e,32)
 assert 0<start<=end and (end+1)*512<=1073741824
 Path('/out/root-offset').write_text(str(start*512))
 f.seek(start*512)
 with Path('/out/root.img').open('wb') as o:
  remaining=(end-start+1)*512
  while remaining:
   chunk=f.read(min(remaining,1048576));assert chunk
   if any(chunk):o.write(chunk)
   else:o.seek(len(chunk),1)
   remaining-=len(chunk)
  o.truncate()
PY
dumpe2fs -h /out/root.img > /out/root-superblock.txt 2>&1
e2fsck -fn /out/root.img > /out/root-before.fsck 2>&1
debugfs -R 'dump /etc/pax-install/manifest /out/install.manifest' /out/root.img
debugfs -R 'dump /etc/pax-release /out/pax-release' /out/root.img
debugfs -w -R 'write /out/pax-root-probe /bin/pm05b-census' /out/root.img
debugfs -w -R 'set_inode_field /bin/pm05b-census mode 0100755' /out/root.img
# Restore the modified partition. A 1 GiB disk keeps this take below 3 GiB.
python3 -I - <<'PY'
from pathlib import Path
with Path('/out/root.img').open('rb') as i,Path('/out/installed.img').open('r+b') as o:
 o.seek(int(Path('/out/root-offset').read_text()))
 while b:=i.read(1048576):o.write(b)
PY
printf '%s\n' 'set +o friendly' '/bin/pm05b-census /var/lib/pm05b-census' 'echo CENSUS_ABI=$?' 'exit 0' > /out/census.keys
/pax/tools/qemu-halt --accel kvm --boot-disk --firmware bios --serial /out/census.serial --timeout 300 \
  --qemu -m --qemu 2048M --elf /images/kernel/kmain_console.elf \
  --type /out/census.keys --prompt '$ ' --marker 'halt|PANIC .*' /out/installed.img > /out/census.halt 2>&1
python3 -I - <<'PY'
from pathlib import Path
import re
s=re.sub(rb'\x1b\[[0-9;?=<>]*[A-Za-z]',b'',Path('/out/census.serial').read_bytes()).replace(b'\r',b'')
Path('/out/census.norm').write_bytes(s)
for line in s.splitlines():
 if line.startswith((b'PASS abi-',b'FAIL abi-',b'OBSERVE ',b'ABI-END',b'CENSUS_ABI=',b'root:')): print(line.decode())
assert b'root: PARTUUID=' in s and b'on /: ext2' in s,'not the installed disk root'
assert b'ABI-END failures=' in s,'probe did not complete'
print('PASS census-installed-root-measured (individual missing calls stay FAIL above)')
PY
du -sh /out
if grep -q '^FAIL abi-' /out/census.norm; then exit 1; fi
GUEST_RIG
