#!/usr/bin/env python3
"""No signing material is generated or loaded by these local tests."""
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys
import tempfile
from unittest import mock

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
loader = importlib.machinery.SourceFileLoader('fixture_producer', str(ROOT/'tools/fixture-producer'))
spec = importlib.util.spec_from_loader(loader.name, loader)
producer = importlib.util.module_from_spec(spec)
loader.exec_module(producer)


def main():
    with tempfile.TemporaryDirectory(dir=ROOT/'target', prefix='public-fixture-check-') as temp:
        first, second = Path(temp)/'first', Path(temp)/'second'
        first.mkdir(); second.mkdir()
        with mock.patch.object(producer.time, 'time', side_effect=[100, 200]):
            for directory in (first, second):
                (directory/'TEST-ONLY.json').write_text(json.dumps(dict(test_only=True, epoch=producer.fixture_epoch()))+'\n')
        if not producer.two_builds_equal(first, second):
            print('FAIL fixture-two-builds-equal', flush=True)
            return 1
        (second/'TEST-ONLY.json').write_text('{"test_only":true,"changed":true}\n')
        if producer.two_builds_equal(first, second):
            print('FAIL fixture-two-builds-equal', flush=True)
            return 1
    print('PASS fixture-two-builds-equal', flush=True)
    return 0


if __name__ == '__main__':
    (ROOT/'target').mkdir(exist_ok=True)
    sys.exit(main())
