#!/usr/bin/env bash
# Generate independent vectors only in an offline, unprivileged Linux container.
set -eu
cd "$(dirname "$0")/.."
. tools/rig-profile
[ "$PXG_INTEROP" = 1 ] || { echo 'FAIL generator-profile'; exit 1; }
: "${PAXAGE_VECTOR_WORK:?set a new lane-local vector output directory}"
mkdir -m 700 "$PAXAGE_VECTOR_WORK"
mkdir -m 700 "$PAXAGE_VECTOR_WORK/tmp" "$PAXAGE_VECTOR_WORK/home"
image=77fdad6b841abfdb3968ea6137b1edf7248578bdfc4f92e4aab6b2a05f241485
"$PXG_CONTAINER_RUNTIME" run --rm --pull=never --network none --read-only --init \
  --userns keep-id --user "$(id -u):$(id -g)" --memory "$PXG_CONTAINER_MEMORY" --pids-limit "$PXG_CONTAINER_PIDS" \
  --cpuset-cpus "$PXG_CONTAINER_CPUS" --cap-drop ALL --security-opt no-new-privileges \
  -e TMPDIR=/work/tmp -e HOME=/work/home -e PXG_RIG_PROFILE="$PXG_RIG_PROFILE" \
  -v "$PWD:/src:ro" -v "$PAXAGE_VECTOR_WORK:/work:rw" "$image" \
  prlimit --as=2147483648 python3 -I /src/tools/generate-trust-vectors \
  --output /work/independent --keys /work/test-only-keys
