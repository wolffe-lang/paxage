#!/usr/bin/env python3
"""Bounded diagnostic for the coherent trusted-storage replay threat boundary."""
import json
from pathlib import Path
import subprocess
import sys

binary = Path(sys.argv[1]).resolve()
work = binary.parent.parent / 'coherent-replay-witness'
work.mkdir(mode=0o700)
repo, keys, state = [work / name for name in ('repo', 'test-only-keys', 'state')]
t0, t1 = '2026-11-03T00:00:00Z', '2026-11-03T01:00:00Z'


def run(*args, error=None):
    p = subprocess.run([str(binary), *map(str, args)], capture_output=True, text=True, timeout=15)
    if error is None:
        if p.returncode or p.stderr: raise RuntimeError((args, p.returncode, p.stdout, p.stderr))
    elif p.returncode != 1 or error not in p.stderr: raise RuntimeError((args, p.returncode, p.stdout, p.stderr))
    return p


def header():
    pointer = json.loads((state / 'current').read_bytes())
    return json.loads((state / f'g{pointer["generation"]}' / 'state.json').read_bytes())


run('repo', 'keygen', '--keys', keys, '--now', t0)
run('repo', 'init', '--repo', repo.as_uri(), '--keys', keys, '--now', t0)
run('repo', 'publish', '--repo', repo.as_uri(), '--keys', keys, '--version', '1', '--now', t0)
pinned = work / 'pinned-root.json'; pinned.write_bytes((repo / 'metadata/1.root.json').read_bytes())
run('bootstrap', '--repo', repo.as_uri(), '--root', pinned, '--state', state, '--now', t0)
run('update', '--repo', repo.as_uri(), '--state', state, '--now', t0)
old_pointer = (state / 'current').read_bytes(); old_timestamp = (repo / 'metadata/timestamp.json').read_bytes()
old_header = header()
run('repo', 'publish', '--repo', repo.as_uri(), '--keys', keys, '--version', '2', '--now', t1)
run('update', '--repo', repo.as_uri(), '--state', state, '--now', t1)
latest = header()
if latest['timestamp_version'] != 2 or latest['floor'] <= old_header['floor']: raise RuntimeError('setup-history')
(repo / 'metadata/timestamp.json').write_bytes(old_timestamp)
run('update', '--repo', repo.as_uri(), '--state', state, '--now', t1, error='rollback-timestamp')
(state / 'current').write_bytes(old_pointer)
p = run('update', '--repo', repo.as_uri(), '--state', state, '--now', t0)
replayed = header()
if replayed['timestamp_version'] != 1 or replayed['floor'] != old_header['floor']: raise RuntimeError('behavior-changed')
print('WITNESS mirror-only rollback refused; coherent local current replay was accepted')
print(f'WITNESS previous timestamp={latest["timestamp_version"]} floor={latest["floor"]}; replay timestamp={replayed["timestamp_version"]} floor={replayed["floor"]}')
print('WITNESS this diagnoses a threat-boundary limitation, not a passing rollback-protection gate')
