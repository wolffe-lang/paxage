#!/usr/bin/env python3
"""Linux container-only archiver contrasts and read-only-parent confinement.
No archiver source is imported or inspected. Verdicts are frozen F6 expectations.
"""
from pathlib import Path
import importlib.machinery, json, os, shutil, subprocess, tempfile
import sys

def _named_failure(kind, value, traceback):
    print("FAIL F6-container-interop-confinement", file=sys.stderr, flush=True)
    sys.__excepthook__(kind, value, traceback)

if __name__ == '__main__': sys.excepthook = _named_failure

ROOT=Path(__file__).resolve().parents[1]
v=importlib.machinery.SourceFileLoader('vectors',str(ROOT/'tools/check-payload')).load_module()
IMAGE='docker.io/library/archlinux@sha256:8185e444e45ba166146b244b41f1cba2d7d91f3eddce533a839cc9591e0fa785'

def container(command,mounts):
    engine=os.environ.get('LARDER_CONTAINER_ENGINE') or ('podman' if shutil.which('podman') else 'docker')
    args=[engine,'run','--rm','--network','none','--memory','2g','--read-only','--cap-drop=ALL','--security-opt=no-new-privileges','--user',f'{os.getuid()}:{os.getgid()}']
    if engine.endswith('podman'):args+=['--userns=keep-id','--read-only-tmpfs=false']
    for source,target,mode in mounts:args+=['-v',f'{source}:{target}:{mode}']
    cpus=os.environ.get('LARDER_CONTAINER_CPUS')
    if cpus:command=f'exec taskset -c {cpus} /usr/bin/bash -c '+__import__('shlex').quote(command)
    args +=[IMAGE,'/usr/bin/bash','-c',command]
    p=subprocess.run(args,stdin=subprocess.DEVNULL,capture_output=True,timeout=60)
    assert p.returncode==0,(command,p.returncode,p.stdout,p.stderr)
    return p.stdout

def main():
    with tempfile.TemporaryDirectory(dir=os.environ['TMPDIR'],prefix='container-') as d:
        d=Path(d);work=d/'work';work.mkdir();tree=work/'tree';tree.mkdir();(tree/'usr').mkdir()
        file=tree/'usr/file';file.write_bytes(b'abc');file.chmod(0o644);os.utime(file,(-1,-1))
        # These invocations select the restricted profile, not the tools' verdicts.
        container("tar --blocking-factor=1 --format=pax --owner=0 --group=0 --mtime=@0 --pax-option=delete=atime,delete=ctime -cf /work/gnu.tar -C /work/tree usr/file",[(work,'/work','rw')])
        container("bsdtar -b 1 --format=pax --uid 0 --gid 0 --uname '' --gname '' -cf /work/bsd.tar -C /work/tree usr/file",[(work,'/work','rw')])
        for name in ['gnu','bsd']:
            path=work/f'{name}.tar';raw=path.read_bytes();off=0
            # POSIX framing only, independently identify physical tail padding.
            while raw[off:off+512] != bytes(512):
                h=raw[off:off+512];assert len(h)==512,'F6-contrast-header-length'
                size=int(h[124:136].rstrip(b'\0 ').decode() or '0',8)
                off+=512+((size+511)//512)*512
            assert raw[off:off+1024]==bytes(1024),'F6-contrast-end-blocks'
            extra=len(raw)-(off+1024)
            expected='trailing-data' if extra else None
            print(f'contrast={name} expected={expected or "accept"} extra_tail_bytes={extra}',flush=True)
            v.verify(path,expected)
        out=work/'out';out.mkdir();v.invoke(['pack',tree,ROOT/'tests/manifests/valid.manifest',out,'--epoch',0])
        payload=out/'sample-1-1.payload.tar';manifest=out/'sample-1-1.manifest'
        rows=json.loads(v.invoke(['list-payload',payload,'--length',payload.stat().st_size,'--json']).stdout)
        expected=sorted(e['path'] for e in rows)
        for tool in ['tar','bsdtar']:
            names=container(f'{tool} -tf /input/sample-1-1.payload.tar',[(out,'/input','ro')]).decode().splitlines()
            assert sorted(s.rstrip('/') for s in names)==expected,('F6-interop-list',tool,names,expected)
        # Bind an existing read-only character device, without creating a node
        # or invoking a privileged process, to exercise pack's device refusal.
        device=tree/'null';device.touch()
        device_cmd="message=$(/bin/larder pack /tree /template /out --epoch 0 2>&1); result=$?; test \"$result\" = 1 && test \"$message\" = 'larder: pack-device'"
        container(device_cmd,[(ROOT/'target/bin/larder','/bin/larder','ro'),(tree,'/tree','ro'),(Path('/dev/null'),'/tree/null','ro'),(ROOT/'tests/manifests/valid.manifest','/template','ro'),(out,'/out','rw')])
        device.unlink()
        stage=out/'stage';stage.mkdir(mode=0o700)
        before={p.name:(p.stat().st_ino,p.stat().st_size) for p in out.iterdir() if p.is_file()}
        cmd='/bin/larder stage /fixture/sample-1-1.payload.tar --length '+str(payload.stat().st_size)+' --sha256 '+__import__('hashlib').sha256(payload.read_bytes()).hexdigest()+' --manifest /fixture/sample-1-1.manifest --into /fixture/stage'
        result=container(cmd,[(ROOT/'target/bin/larder','/bin/larder','ro'),(out,'/fixture','ro'),(stage,'/fixture/stage','rw')])
        assert result.startswith(b'stage ok') and (stage/'usr/file').read_bytes()==b'abc'
        assert before=={p.name:(p.stat().st_ino,p.stat().st_size) for p in out.iterdir() if p.is_file()},'F6-container-parent-unchanged'
        mounted=d/'mount-stage';mounted.mkdir(mode=0o700)
        refused=cmd.replace('/fixture/','/input/').replace('--into /input/stage','--into /stage')
        mount_cmd='message=$('+refused+' 2>&1); result=$?; test "$result" = 1 && test "$message" = "larder: stage-root-mount"'
        container(mount_cmd,[(ROOT/'target/bin/larder','/bin/larder','ro'),(out,'/input','ro'),(mounted,'/stage','rw')])
        assert list(mounted.iterdir())==[],'F6-mount-refusal-no-writes'

    print('END F6-container-interop-confinement exit=0',flush=True)
if __name__=='__main__':main()
