#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
export PAXAGE_ROOT="$PWD"
. tools/lib-toolchain.sh
case "${1:-}" in trust_json|trust_state|trust_metadata) unit=$1 ;; *) echo 'usage: check-trust-unit trust_json|trust_state|trust_metadata' >&2; exit 2 ;; esac
step() {
  local name=$1 started=$SECONDS result=0
  shift
  printf 'START %s\n' "$name"
  "$@" || result=$?
  printf 'END %s exit=%s secs=%s\n' "$name" "$result" "$((SECONDS-started))"
  return "$result"
}
build() {
  mkdir -p target/tests || return $?
  rm -rf src/.lu-cache || return $?
  "$WOLF" build --deny-warnings "src/${unit}_test.lu" -o "target/tests/$unit"
}
run() {
  if [ "$unit" = trust_state ]; then
    mkdir -m 700 target/tests/state || return $?
    "target/tests/$unit" "$PWD/target/tests/state"
  else
    "target/tests/$unit"
  fi
}
step "$unit-build" build
step "$unit" run
