#!/bin/sh
set -eu
PAXAGE_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PAXAGE_ROOT
cd "$PAXAGE_ROOT"
. tools/lib-toolchain.sh
mkdir -p target/tests
for row in version literal solver payload transaction; do
    rm -rf "$PAXAGE_ROOT/src/.lu-cache"
    echo "RUN unit-$row"
    result=0
    "$WOLF" build --deny-warnings "src/${row}_test.lu" -o "target/tests/$row" || result=$?
    if [ "$result" -eq 0 ]; then "target/tests/$row" || result=$?; fi
    echo "unit-$row exit=$result"
    if [ "$result" -ne 0 ]; then echo "FAIL unit-$row exit=$result" >&2; exit "$result"; fi
done

rm -rf "$PAXAGE_ROOT/src/.lu-cache"
"$WOLF" build --deny-warnings src/payload_probe.lu -o target/bin/payload-probe
rm -rf "$PAXAGE_ROOT/src/.lu-cache"
"$WOLF" build --deny-warnings src/chunk_probe.lu -o target/bin/chunk-probe
