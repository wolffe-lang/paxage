#!/usr/bin/env bash
# Flat top-level records accepted by planning's gauntlet-record.sh (68dae09).
set -eu
cd "$(dirname "$0")/.."
step() {
  local name=$1 started=$SECONDS result=0
  shift
  printf 'START %s\n' "$name"
  "$@" || result=$?
  if [ "$result" -ne 0 ]; then printf 'FAIL %s exit=%s\n' "$name" "$result" >&2; fi
  printf 'END %s exit=%s secs=%s\n' "$name" "$result" "$((SECONDS-started))"
  if [ "$result" -ne 0 ]; then exit "$result"; fi
}
step fmt tools/check-fmt
step ci-routing python3 -I ci/local-gate-test.py
step census python3 -I tools/check-census
step build tools/build
step runtime-witness bash tools/check-runtime-witness
step unit tools/check-test
step cli tools/check-e2e
step names python3 -I tools/check-names
if [ "$(uname -s)" = Linux ]; then
  step payload prlimit --as=2147483648 python3 -I tools/check-payload --fuzz
  # podman runs uncapped; the step caps the archivers and larder inside the container (ulimit -v
  # 2 GiB). The warm step pulls and copies the image under its own bound first, for a cold store.
  step container-warm python3 -I tools/check-payload-container --warm
  step container python3 -I tools/check-payload-container
  step inventory-bound prlimit --as=2147483648 python3 -I tools/check-inventory-bound
  step chunk-rss prlimit --as=2147483648 python3 -I tools/check-chunk-rss
  step rss prlimit --as=2147483648 python3 -I tools/check-payload-rss
else
  step payload-roundtrip python3 -I tools/check-payload --roundtrip-only
  echo 'SKIP payload-growth reason=Linux-only capped entry, cumulative-extension and allocation bounds'
  echo 'SKIP payload-fuzz reason=Linux-only capped 100000 mutations; never on the Mac'
  echo 'SKIP container reason=Linux-only container interoperability and confinement'
  echo 'SKIP inventory-bound reason=Linux-only capped maximum-inventory measurement'
  echo 'SKIP chunk-rss reason=Linux-only capped allocation measurement'
  echo 'SKIP rss reason=Linux-only capped large-file measurement; never on the Mac'
fi
if [ "$(uname -s)" = Linux ]; then
  unqualified=$(mktemp -d /dev/shm/larder-unqualified.XXXXXX)
  step transactions env LARDER_UNQUALIFIED_ROOT="$unqualified" python3 -I tools/check-transactions
  rm -rf "$unqualified"
else
  echo 'SKIP fs-unqualified-refused reason=no tmpfs root on this host; Linux takes refuse one by name'
  step transactions python3 -I tools/check-transactions
fi
if bash tools/check-transactions-privileged --available; then
  step transactions-privileged bash tools/check-transactions-privileged
else
  echo 'SKIP transactions-privileged reason=no root route here (not root, no CI sudo, no container engine and image); owners stay logical'
fi
step powercut-host python3 -I tools/check-powercut --host
if vm_why=$(python3 -I tools/check-powercut --available); then
  step powercut-vm python3 -I tools/check-powercut --vm
else
  echo "SKIP powercut-vm reason=${vm_why#powercut: vm unavailable: }; the power-cut witness needs a KVM Linux take"
fi
step fetch-retry python3 -I tools/check-fetch-retry
bash tools/check-trust-unit trust_json
bash tools/check-trust-unit trust_metadata
bash tools/check-trust-unit trust_state
step trust-harness python3 -I tools/check-trust-harness
if [ "$(uname -s)" = Linux ]; then
  prlimit --as=2147483648 bash tools/check-trust-crypto
else
  bash tools/check-trust-crypto
fi
bash tools/check-trust-integration e2e
step trust-corruption python3 -I tools/check-trust-corruption
if [ "$(uname -s)" = Linux ]; then
  step trust-independent prlimit --as=2147483648 python3 -I tools/check-trust-independent
  if [ "$(hostname)" = kasumi ]; then
    step trust-openssl-writer bash tools/check-openssl-writer
  else
    echo 'SKIP trust-openssl-writer reason=OpenSSL CLI runs only in the kasumi container; frozen signed vectors run here'
  fi
  prlimit --as=2147483648 bash tools/check-trust-fuzz-runner
else
  step trust-independent python3 -I tools/check-trust-independent --bounded
  echo 'SKIP trust-large-metadata reason=three byte-limit cases run only on capped Linux'
  echo 'SKIP trust-openssl-writer reason=OpenSSL CLI runs only in the kasumi container'
  echo 'SKIP trust-fuzz reason=Linux-only capped 100000 mutations; never on the Mac'
fi
step trust-local-replay-limit python3 -I tools/witness-trust-replay "$PWD/target/bin/larder"
