#!/usr/bin/env python3
"""F6 bounded-RSS qualification; large sparse zero fixtures deleted in this job."""
from pathlib import Path
import importlib.machinery, hashlib, json, os, platform, re, subprocess, tempfile, time
import sys

def _named_failure(kind, value, traceback):
    print("FAIL F6-RSS-grows-with-payload", file=sys.stderr, flush=True)
    sys.__excepthook__(kind, value, traceback)

if __name__ == '__main__': sys.excepthook = _named_failure

ROOT=Path(__file__).resolve().parents[1]
v=importlib.machinery.SourceFileLoader('vectors',str(ROOT/'tools/check-payload')).load_module()

def wait(p,label):
    while True:
        try: return p.communicate(timeout=30)
        except subprocess.TimeoutExpired:print(f'RSS waiting {label} pid={p.pid}',flush=True)

def main():
    if platform.system() == 'Darwin' and '78b9d3cbc41d51db44d18c40b6694403644d1c83' in (ROOT/'wolf-toolchain.toml').read_text():
        raise SystemExit('FAIL F6-RSS-grows-with-payload: blocked on sc76; refusing known-growing Mac run')
    results=[]
    with tempfile.TemporaryDirectory(dir=os.environ['TMPDIR'],prefix='rss-') as d:
        d=Path(d)
        for size in [64*1024**2,1024**3]:
            raw=d/'zero';raw.touch();os.truncate(raw,size)
            oracle=['shasum','-a','256',str(raw)] if platform.system()=='Darwin' else ['sha256sum',str(raw)]
            p=subprocess.Popen(oracle,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
            stdout,stderr=wait(p,f'oracle-{size}');assert p.returncode==0,(stdout,stderr)
            expected=stdout.decode().split()[0]
            path=d/'payload.tar'
            with path.open('wb') as f:
                f.write(v.header(b'usr/blob',b'0',size,0o644));f.seek(size,1);f.write(bytes(1024))
            args=['/usr/bin/time','-l' if platform.system()=='Darwin' else '-v',str(ROOT/'target/bin/larder'),'list-payload',str(path),'--length',str(path.stat().st_size),'--json']
            if platform.system() == 'Linux':args=['prlimit','--as=2147483648','--',*args]
            p=subprocess.Popen(args,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
            stdout,stderr=wait(p,str(size));assert p.returncode==0,('F6-RSS-grows-with-payload',p.returncode,stdout,stderr)
            rows=json.loads(stdout);assert rows[0]['length']==size and rows[0]['sha256']==expected,rows
            text=stderr.decode()
            if platform.system()=='Darwin':rss=int(re.search(r'(\d+)\s+maximum resident set size',text)[1])//1024
            else:rss=int(re.search(r'Maximum resident set size \(kbytes\):\s*(\d+)',text)[1])
            results.append(rss)
            print(f'RSS platform={platform.system()} bytes={size} peak_kib={rss} sha256={expected}',flush=True)
            path.unlink();raw.unlink()
    assert results[1]-results[0] <= 8192,('F6-RSS-grows-with-payload',results)
    print('END F6-RSS-64MiB-1GiB exit=0',flush=True)
if __name__=='__main__':main()
