        ('payload-length',archive((header(b'usr/file',b'0',999999,0o644),b''))),
        ('payload-length',valid[:-1]),('end-blocks',valid[:-512]+header()),
        ('trailing-data',valid+bytes(512)),('trailing-data',valid+b'\0'),
        ('set-id-mode',archive((header(b'usr/file',b'0',0,0o4644),b''))),
        ('type-size',archive((header(b'usr',b'5',1),b'x'))),
        ('unused-link',archive((header(b'usr/file',b'0',0,0o644,b'x'),b''))),
        ('pax-global',archive((header(b'Global',b'g',0,0o644),b''))),
        ('extension-limit',archive((header(b'PaxHeader',b'x',1048577,0o644),b''))),
        ('pax-orphan',archive((header(b'PaxHeader',b'x',len(pax('mtime',b'-1')),0o644),pax('mtime',b'-1')))),
        ('pax-multiple',archive((header(b'x',b'x',len(pax('mtime',b'-1')),0o644),pax('mtime',b'-1')),(header(b'y',b'x',0,0o644),b''))),
        ('pax-duplicate',extended(pax('mtime',b'-1')+pax('mtime',b'-2'))),
        ('pax-unused',extended(pax('path',b'usr/file'))),
        ('pax-unused',extended(pax('linkpath',b'x'*101))),
        ('pax-unused',extended(pax('size',b'1'))),
        ('pax-number',extended(pax('size',b'9223372036854775808'))),
        ('installed-limit',extended(pax('size',b'17179869185'))),
        ('payload-length',extended(pax('size',b'17179869184'))),
        ('pax-time',extended(pax('mtime',b'1.'))),
        ('pax-unused',extended(pax('mtime',b'1'))),
        ('pax-unused',extended(pax('mtime',b'1.000'))),
        ('pax-unused',extended(pax('mtime',b'-0'))),
        ('pax-text',extended(pax('mtime',b'\xff'))),
        ('pax-text',extended(pax('mtime',b'-1\x00'))),
        ('pax-record',extended(b'9999 path=foo\n'))]
    for flag in [b'3',b'4',b'6',b'7',b'S',b'L',b'K',b'V',b'Z',b's']:
        cases.append(('payload-type',archive((header(b'usr/file',flag,0,0o644),b''))))
    for key in ['GNU.sparse.map','GNU.sparse.size','SCHILY.xattr.test','SCHILY.acl.access','uid','gid','uname','gname','hdrcharset','unknown']:
        cases.append(('pax-keyword',extended(pax(key,b'1'))))
    h=bytearray(header(b'usr/file',b'0',0,0o644));h[0]^=1;cases.append(('checksum',archive((bytes(h),b''))))
    h=bytearray(header());field(h,136,12,b'777777777777');cases.append(('header-number',archive((checksum(h),b''))))
    h=bytearray(header());h[124]=128;cases.append(('header-number',archive((checksum(h),b''))))
    h=bytearray(header());h[329]=49;cases.append(('device-metadata',archive((checksum(h),b''))))
    h=bytearray(header());h[501]=1;cases.append(('header-padding',archive((checksum(h),b''))))
    h=bytearray(header());h[257]=71;cases.append(('ustar-magic',archive((checksum(h),b''))))
    pad=bytearray(valid);pad[1027]=1;cases.append(('nonzero-padding',bytes(pad)))
    long=b'usr/'+b'a'*200+b'/'+b'b'*101
    cases.append(('bad-path',extended(pax('path',b'../'+b'x'*300))))
    positives=[valid,extended(pax('path',long)),extended(pax('path','usr/é'.encode())),extended(pax('linkpath','é'.encode()),header(b'usr/link',b'2',0,0o777)),extended(pax('mtime',b'-1.25')),extended(pax('atime',b'0')+pax('ctime',b'1')),
       archive((header(b'usr/f',b'0',0,0o644),b''),(header(b'usr/h',b'1',0,0o644,b'usr/f'),b''))]
    for binary in [BINARY,BINARY.with_name('pxg')]:
        for i,(error,raw) in enumerate(cases):
            path=d/'vector.tar';path.write_bytes(raw);verify(path,error,binary)
        for raw in positives:
            path=d/'vector.tar';path.write_bytes(raw);verify(path,binary=binary)
    print('PASS F6-trailing-data-refused exit=0',flush=True)
    # 100001-entry bound is reached before allocation of entry 100001 or sorting.
    path=d/'entries.tar'
    with path.open('wb') as f:
        for i in range(100001):f.write(header(f'usr/f{i:06}'.encode(),b'0',0,0o644))
        f.write(bytes(1024))
    verify(path,'entry-limit')
    with path.open('r+b') as f:
        f.truncate(100000*512);f.seek(0,2);f.write(bytes(1024))
    verify(path);path.unlink()
    # Bound-before-allocation was exercised with a declared 1MiB+1 header above.
    print(f'PASS F6-independent-vectors-{len(cases)} exit=0',flush=True)
    return valid

def tree_signature(root):
    import stat
    records={};inodes={}
    for parent,dirs,files in os.walk(root,followlinks=False):
        for name in dirs+files:
            p=Path(parent)/name;rel=str(p.relative_to(root));info=p.lstat()
            mode=stat.S_IMODE(info.st_mode)
            if stat.S_ISLNK(info.st_mode):records[rel]=('symlink',mode,os.readlink(p))
            elif stat.S_ISDIR(info.st_mode):records[rel]=('dir',mode)
            else:
                assert stat.S_ISREG(info.st_mode),('F6-tree-type',rel)
                records[rel]=('file',mode,info.st_size,hashlib.sha256(p.read_bytes()).hexdigest())
                inodes.setdefault((info.st_dev,info.st_ino),[]).append(rel)
    aliases=sorted(tuple(sorted(names)) for names in inodes.values() if len(names)>1)
    return records,aliases

def roundtrip(d):
    previous=os.umask(0)
    try:return _roundtrip(d)
    finally:os.umask(previous)

def _roundtrip(d):
    source=d/'source';source.mkdir();(source/'usr').mkdir();(source/'usr/bin').mkdir()
    (source/'usr/bin/tool').write_bytes(b'hello\0payload\n');(source/'usr/bin/tool').chmod(0o755)
    (source/'usr/data').write_bytes(b'abc');(source/'usr/data').chmod(0o640)
    os.link(source/'usr/data',source/'usr/hard');os.symlink('data',source/'usr/link')
    (source/'usr/a b').write_bytes(b'utf8')
    long=source/'usr'/('a'*150)/('b'*150);long.mkdir(parents=True);(long/'file').write_bytes(b'long')
    for p in source.rglob('*'):
        if p.is_symlink():assert p.lstat().st_mode&0o777==0o777,'F6-fixture-symlink-mode'
        elif p.is_dir():p.chmod(0o755)
        else:p.chmod(0o755 if p.name=='tool' else 0o640 if p.name in ['data','hard'] else 0o644)
    print('canonical fixture modes fixed; caller umask=0000; nonportable ASCII path included',flush=True)
    expected_tree=tree_signature(source)
    outputs=[]
    for n in range(2):
        binary=BINARY if n==0 else BINARY.with_name('pxg')
        out=d/f'out{n}';out.mkdir()
        invoke(['pack',source,ROOT/'tests/manifests/valid.manifest',out,'--epoch',0],binary=binary)
        path=out/'sample-1-1.payload.tar';manifest=out/'sample-1-1.manifest'
        verify(path,manifest=manifest,binary=binary)
        rows=json.loads(invoke(['list-payload',path,'--length',path.stat().st_size,'--json'],binary=binary).stdout)
        outputs.append(path.read_bytes())
        into=d/f'stage{n}';into.mkdir(mode=0o700)
        assert tree_signature(source)==expected_tree,'F6-source-unchanged-between-packs'
        before=sorted(p.name for p in d.iterdir())
        invoke(stage_args(path,manifest,into),binary=binary)
        assert before==sorted(p.name for p in d.iterdir()),'F6-no-write-outside-root'
        assert tree_signature(into)==expected_tree,'F6-independent-source-tree-roundtrip'
        for e in rows:
            p=into/e['path'];s=p.lstat();assert s.st_mode&0o777==e['mode'],(e,oct(s.st_mode))
            if e['type']=='file':assert hashlib.sha256(p.read_bytes()).hexdigest()==e['sha256'] and s.st_size==e['length']
            if e['type']=='symlink':assert os.readlink(p)==e['target']
            if e['type']=='hardlink':assert s.st_ino==(into/e['target']).stat().st_ino
        bad=d/f'bad-stage{n}';bad.mkdir(mode=0o700)
        invoke(stage_args(path,manifest,bad,'0'*64),1,'payload-digest');assert list(bad.iterdir())==[]
        wrong=d/'wrong.manifest';wrong.write_text((ROOT/'tests/manifests/valid.manifest').read_text())
        invoke(stage_args(path,wrong,bad),1,'inventory-mismatch');assert list(bad.iterdir())==[]
        (bad/'sentinel').write_text('keep');invoke(stage_args(path,manifest,bad),1,'stage-root-not-empty')
        assert (bad/'sentinel').read_text()=='keep'
        bad.rmdir() if not list(bad.iterdir()) else None
        if n==0:
            # Reverse physical insertion order without changing modes/inode relationships.
            for p in [source/'usr/a b',source/'usr/bin/tool']:
                raw=p.read_bytes();mode=p.stat().st_mode&0o777;p.unlink();p.write_bytes(raw);p.chmod(mode)
    assert outputs[0]==outputs[1],'F6-deterministic-listing-order'
    artifact=ROOT/'target/evidence/canonical.payload.tar';artifact.parent.mkdir(parents=True,exist_ok=True);artifact.write_bytes(outputs[0])
    print('canonical payload sha256='+hashlib.sha256(outputs[0]).hexdigest(),flush=True)
    print('PASS F6-roundtrip-determinism-authentication exit=0',flush=True)

def check_staged(rows,into):
    # Record modes before temporarily enabling reads/search for independent checks.
    expected=set()
    for e in rows:
        rel=Path(e['path']);expected.add(str(rel))
        expected.update(str(p) for p in rel.parents if str(p)!='.')
        target=into/rel;st=target.lstat()
        assert st.st_mode&0o777==e['mode'],('F6-fuzz-mode',e,st.st_mode)
        if e['type']=='dir':target.chmod(e['mode']|0o700)
        elif e['type']=='file':
            target.chmod(e['mode']|0o400)
            assert st.st_size==e['length'] and hashlib.sha256(target.read_bytes()).hexdigest()==e['sha256']
            target.chmod(e['mode'])
        elif e['type']=='symlink':assert os.readlink(target)==e['target']
        else:assert st.st_ino==(into/e['target']).stat().st_ino
    actual=set()
    for root,dirs,files in os.walk(into,followlinks=False):
        for name in dirs+files:actual.add(str((Path(root)/name).relative_to(into)))
    assert actual==expected,('F6-fuzz-tree-inventory',actual,expected)

def fuzz(d,valid):
    seed=1347244082; rng=random.Random(seed);count=int(os.environ.get('LARDER_FUZZ_CASES','100000'))
    assert count>=100000,'F6-fuzz-minimum'
    print(f'F6 mutation seed={seed} inputs={count} per-input-timeout=5s',flush=True)
    command=[str(PROBE)]
    if sys.platform.startswith('linux'):command=['prlimit','--as=2147483648','--',*command]
    p=subprocess.Popen(command,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,bufsize=0)
    accepted=0;refused=0;before=set(d.iterdir())
    longpath=b'usr/'+b'a'*150+b'/'+b'b'*150
    extension=pax('path',longpath)
    pool=[(valid,1024,[0,512]),
        (archive((header(b'usr/f',b'0',3,0o644),b'abc')),512,[0]),
        (archive((header(b'usr',b'5'),b''),(header(b'usr/f',b'0',3,0o644),b'abc'),(header(b'usr/h',b'1',0,0o644,b'usr/f'),b''),(header(b'usr/s',b'2',0,0o777,b'f'),b'')),1024,[0,512,1536,2048]),
        (archive((header(b'PaxHeader',b'x',len(extension),0o644),extension),(header(b'PaxFile',b'0',3,0o644),b'abc')),1536,[0,1024])]
    try:
        for i in range(count):
            base,data_at,headers=pool[rng.randrange(len(pool))];raw=bytearray(base)
            if i%11==0:raw[data_at+rng.randrange(3)]^=rng.randrange(1,256)
            elif i%13==0:del raw[rng.randrange(len(raw)):]
            else:
                for _ in range(rng.randrange(1,5)):raw[rng.randrange(len(raw))]^=rng.randrange(1,256)
            # Preserve checksums on a subset so framing/type/path/extension checks,
            # not just the checksum guard, receive hostile inputs.
            if i%7==0:
                for off in headers:
                    if off+512<=len(raw):raw[off:off+512]=checksum(raw[off:off+512])
            p.stdin.write(f'{len(raw):08}'.encode()+raw)
            ready,_,_=select.select([p.stdout],[],[],5)
            assert ready,('F6-fuzz-timeout',seed,i)
            line=p.stdout.readline();assert line,('F6-fuzz-crash',seed,i,p.poll())
            if line.startswith(b'refused:'):
                assert line.strip()[8:] and b' ' not in line.strip()[8:];refused+=1
            else:
                rows=json.loads(line)
                path=d/'fuzz.tar';path.write_bytes(raw)
                m=d/'fuzz.manifest';m.write_text(manifest_for(rows))
                into=d/'fuzz-stage';into.mkdir(mode=0o700)
                args=[str(BINARY),*map(str,stage_args(path,m,into))]
                if sys.platform.startswith('linux'):args=['prlimit','--as=2147483648','--',*args]
                staged=subprocess.run(args,capture_output=True,timeout=5)
                if staged.returncode==0:
                    assert staged.stderr==b'';check_staged(rows,into);accepted+=1
                else:
                    # F5 can describe symlink modes this unprivileged host cannot
                    # reproduce. That must be a named refusal, never false success.
                    assert staged.returncode==1 and staged.stderr==b'larder: stage-mode\n',(seed,i,staged.returncode,staged.stdout,staged.stderr)
                    refused+=1
                import shutil
                shutil.rmtree(into);path.unlink();m.unlink()
            if i%10000==0:print(f'fuzz progress={i} accepted={accepted} refused={refused}',flush=True)
        p.stdin.close();assert p.wait(timeout=5)==0,p.stderr.read()
    finally:
        if p.poll() is None:p.kill();p.wait()
    assert set(d.iterdir())==before,'F6-fuzz-outside-write'
    print(f'PASS F6-fuzz-{count}-accepted-{accepted}-refused-{refused} exit=0',flush=True)

def edges(d):
    template=ROOT/'tests/manifests/valid.manifest'
    out=d/'refusal-out';out.mkdir()
    source=d/'refusal-source';source.mkdir()
    for name,create,error in [
        ('setid',lambda p:(p.write_bytes(b'x'),p.chmod(0o4644)),'set-id-mode'),
        ('sticky',lambda p:(p.write_bytes(b'x'),p.chmod(0o1644)),'set-id-mode'),
        ('escape',lambda p:os.symlink('../outside',p),'bad-symlink'),
        ('var',lambda p:p.mkdir(),'bad-path'),
        ('fifo',lambda p:os.mkfifo(p),'pack-fifo')]:
        path=source/name;create(path)
        invoke(['pack',source,template,out,'--epoch',0],1,error)
        path.rmdir() if path.is_dir() and not path.is_symlink() else path.unlink()
        assert list(out.iterdir())==[],('F6-preflight-no-output',name)
    sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
    try:
        sock.bind(str(source/'socket'))
        invoke(['pack',source,template,out,'--epoch',0],1,'pack-socket')
    finally:sock.close();(source/'socket').unlink()
    (source/'file').write_bytes(b'modes');(source/'file').chmod(0o400)
    invoke(['pack',source,template,out,'--epoch',8589934592])
    path=out/'sample-1-1.payload.tar';m=out/'sample-1-1.manifest'
    verify(path,manifest=m)
    # Exact modes can be more restrictive than staging's temporary creation mode.
    into=d/'restricted-stage';into.mkdir(mode=0o700)
    invoke(stage_args(path,m,'/'),1,'stage-root-is-root')
    invoke(stage_args(path,m,into));assert (into/'file').stat().st_mode&0o777==0o400
    for binary in [BINARY,BINARY.with_name('pxg')]:
        invoke(['list-payload',path,'--length',path.stat().st_size,'--json'],binary=binary)
        invoke(['pack',source,template,out,'--epoch','bad'],1,'pack-epoch',binary=binary)
        invoke(['stage'],2,binary=binary)
        invoke(['verify-payload',path,'--length',path.stat().st_size,'--length',1],2,binary=binary)
        invoke(['verify-payload',path,'--length',path.stat().st_size+1],1,'payload-length',binary=binary)
        invoke(['verify-payload',d/'absent','--length',0],1,'payload-open',binary=binary)
    target=d/'auth-first-stage';target.mkdir(mode=0o700)
    malformed=d/'malformed.manifest';malformed.write_text('not a manifest')
    hostile=d/'auth-first.tar';hostile.write_bytes(archive((header(b'../escape',b'0',0,0o644),b'')))
    invoke(stage_args(hostile,malformed,target,'0'*64),1,'payload-digest')
    invoke(stage_args(hostile,template,target),1,'bad-path')
    assert list(target.iterdir())==[],'F6-auth-first-zero-writes'
    unicode_out=d/'unicode-out';unicode_out.mkdir()
    (source/'é').write_bytes(b'utf8');(source/'é').chmod(0o644)
    invoke(['pack',source,template,unicode_out,'--epoch',0])
    unicode_path=unicode_out/'sample-1-1.payload.tar';unicode_manifest=unicode_out/'sample-1-1.manifest'
    verify(unicode_path,manifest=unicode_manifest)
    unicode_stage=d/'unicode-stage';unicode_stage.mkdir(mode=0o700)
    invoke(stage_args(unicode_path,unicode_manifest,unicode_stage))
    assert (unicode_stage/'é').read_bytes()==b'utf8','F6-unicode-roundtrip'
    # Cumulative extension bytes: many individually legal local mtime headers.
    large=d/'cumulative.tar';body=pax('mtime',b'-1.'+b'0'*1010)
    with large.open('wb') as f:
        for i in range(1048576//len(body)+1):
            f.write(header(b'PaxHeader',b'x',len(body),0o644));f.write(body);f.write(bytes((-len(body))%512))
            f.write(header(f'usr/f{i:06}'.encode(),b'0',0,0o644))
        f.write(bytes(1024))
    verify(large,'extension-limit');large.unlink()
    oversized=d/'oversized-path.tar';oversized.write_bytes(extended(pax('path',b'u/'+b'a'*4095)))
    verify(oversized,'bad-path')
    nodes=d/'nodes-source';nodes.mkdir();nodes_out=d/'nodes-out';nodes_out.mkdir()
