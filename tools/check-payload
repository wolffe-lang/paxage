#!/usr/bin/env python3
"""Independent POSIX.1-2017 byte vectors and F5/F6 CLI e2e. No tar imports.
Spec: https://pubs.opengroup.org/onlinepubs/9699919799/utilities/pax.html
Verdicts below derive from FORMAT F5/F6, never GNU tar or bsdtar behavior.
"""
from pathlib import Path
import hashlib, json, os, random, select, socket, subprocess, sys, tempfile, time
import sys

def _named_failure(kind, value, traceback):
    print("FAIL F6-payload-cli-e2e", file=sys.stderr, flush=True)
    sys.__excepthook__(kind, value, traceback)

if __name__ == '__main__': sys.excepthook = _named_failure

ROOT = Path(__file__).resolve().parents[1]
BINARY = ROOT / 'target/bin/paxage'
PROBE = ROOT / 'target/bin/payload-probe'

def field(h, off, width, raw):
    assert len(raw) <= width
    h[off:off+width] = raw + bytes(width-len(raw))

def checksum(h):
    h=bytearray(h);field(h,148,8,b'        ')
    field(h,148,8,f'{sum(h):06o}\0 '.encode());return bytes(h)

def header(path=b'usr', kind=b'5', size=0, mode=0o755, link=b''):
    h = bytearray(512)
    # POSIX ustar header field offsets and widths, in octets.
    for off, width, raw in [(0,100,path),(100,8,f'{mode:07o}\0'.encode()),
        (108,8,b'0000000\0'),(116,8,b'0000000\0'),
        (124,12,f'{size:011o}\0'.encode()),(136,12,b'00000000000\0'),
        (148,8,b'        '),(156,1,kind),(157,100,link),
        (257,6,b'ustar\0'),(263,2,b'00')]: field(h,off,width,raw)
    return checksum(h)

def archive(*records):
    return b''.join(h + data + bytes((-len(data)) % 512) for h,data in records)+bytes(1024)

def pax(key, value):
    body = key.encode()+b'='+value+b'\n'; n=len(body)+2
    while len(str(n))+1+len(body)!=n: n=len(str(n))+1+len(body)
    return str(n).encode()+b' '+body

def extended(body, following=None):
    return archive((header(b'PaxHeader',b'x',len(body),0o644),body),
                   (following or header(b'usr/file',b'0',0,0o644),b''))

def invoke(args, code=0, error=None, binary=BINARY, timeout=10):
    command=[str(binary),*map(str,args)]
    if sys.platform.startswith("linux"):command=["prlimit","--as=2147483648","--",*command]
    p=subprocess.run(command,capture_output=True,timeout=timeout)
    assert p.returncode==code, ('FAIL F6-'+(error or str(args[0])),args,p.returncode,p.stdout,p.stderr)
    if error: assert p.stderr==f'larder: {error}\n'.encode(),('FAIL F6-'+error,args,p.stderr,error)
    elif code==0: assert p.stderr==b'',(args,p.stderr)
    return p

def verify(path, error=None, binary=BINARY, manifest=None):
    args=['verify-payload',path,'--length',path.stat().st_size]
    if manifest: args+=['--manifest',manifest]
    return invoke(args,1 if error else 0,error,binary=binary,timeout=60)

def literal_string(value):
    # F2 is not JSON: only its five escapes and doubled literal braces.
    return json.dumps(value,ensure_ascii=False).replace('{','{{').replace('}','}}')

def manifest_for(rows):
    records=[]
    for e in rows:
        records.append('file { '+', '.join(k+': '+(str(v) if isinstance(v,int) else literal_string(v)) for k,v in e.items())+' }')
    return (ROOT/'tests/manifests/valid.manifest').read_text().replace('files: []','files: ['+', '.join(records)+']')

def stage_args(path, manifest, into, digest=None):
    return ['stage',path,'--length',path.stat().st_size,'--sha256',digest or hashlib.sha256(path.read_bytes()).hexdigest(),'--manifest',manifest,'--into',into]

def vectors(d):
    valid=archive((header(b'usr',b'5'),b''),(header(b'usr/file',b'0',3,0o644),b'abc'))
    cases=[]
    for path in [b'../escape',b'/escape',b'a/../escape',b'a//b',b'./a',b'var/db',b'home/user',b'usr/',b'a\\b',b'a\x01b',b'\xff']:
        cases.append(('header-text' if path in [b'a\x01b',b'\xff'] else 'bad-path',archive((header(path,b'0',0,0o644),b''))))
    cases += [('bad-symlink',archive((header(b'usr/link',b'2',0,0o777,b'../../escape'),b''))),
        ('path-conflict',archive((header(b'usr',b'2',0,0o777,b'etc'),b''),(header(b'usr/file',b'0',0,0o644),b''))),
        ('bad-hardlink',archive((header(b'usr/link',b'1',0,0o644,b'absent'),b''))),
