@row('crash-rescue')
def crash_rescue(r):
    if not FPBIN.exists():
        emit(False, 'crash-rescue', f'missing {FPBIN}')
    base, old, _new = references(r, 'remove')
    _, names = failpoints(r, base, 'remove')
    cut = [n for n in names if n.startswith('apply:')][-1]
    stuck = r.copy(base, 'rescue-base')
    run_verb(stuck, 'remove', binary=FPBIN, env={'LARDER_FAILPOINT': f'{cut}:crash'})
    probe = r.copy(stuck, 'rescue-trace')
    p = pxg('rescue', '--root', probe, binary=FPBIN, env={'LARDER_FAILPOINT': 'trace'})
    rescue_names = [name for name, _ in trace_points(p, 'rescue:')]
    check(any(n.startswith('rescue:undo:') for n in rescue_names), 'crash-rescue-hooked', repr(rescue_names))
    for name in rescue_names:
        root = r.copy(stuck, 'crash-rescue')
        q = pxg('rescue', '--root', root, binary=FPBIN, env={'LARDER_FAILPOINT': f'{name}:crash'})
        try:
            check(q.returncode == CRASH_EXIT, f'crash-rescue-{name}-cut', describe(q))
            recovered_twice(r, root, f'crash-rescue-{name}', old)
        except RowFailed:
            continue


def injected_matrix(r, verb):
    base, old, new = references(r, verb)
    _, names = failpoints(r, base, verb)
    picks = [n for n in names if n.split(':')[0] in ('capacity', 'backup', 'intent-written', 'generation', 'commit-written')]
    picks += [n for n in names if n.endswith(':temp')][:1] + [n for n in names if n.endswith(':renamed')][:1]
    check(any(n.endswith(':temp') for n in picks) or verb == 'remove', f'injected-{verb}-temp-step-present', repr(picks))
    for kind in ('eio', 'enospc'):
        for name in picks:
            root = r.copy(base, f'{kind}')
            p = run_verb(root, verb, binary=FPBIN, env={'LARDER_FAILPOINT': f'{name}:{kind}'})
            row_name = f'{kind}-{verb}-{name}'
            try:
                check(p.returncode == 1 and ('io' if kind == 'eio' else 'no-space') in p.stderr,
                      f'{row_name}-refused', describe(p))
                if name == 'capacity':
                    check(not list((root / 'var/lib/paxage/transactions').iterdir()), f'{row_name}-zero-writes')
                recovered_twice(r, root, row_name, old)
            except RowFailed:
                continue


