#!/usr/bin/env python3
"""X-clause transaction rows over the real CLI (pm04, docs/TRANSACTIONS.md).

Every row drives target/bin/paxage (or the test-only paxage-failpoint) against a
synthetic root under target/transactions; nothing outside that directory is
written, and a sentinel tree outside every root is digested before and after.
Run as container root for the ownership rows, as a plain user for the logical
rows. --all keeps going after a FAIL so a red take names every red row.
"""
import argparse
import resource
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
BIN = ROOT / 'target/bin/paxage'
FPBIN = ROOT / 'target/bin/paxage-failpoint'
WORK = ROOT / 'target/transactions'
NOW = '2026-11-09T00:00:00Z'
ARCH, SLOT = 'x86_64', 'default'
ZERO = '0' * 64
CRASH_EXIT = 134  # the failpoint crash is a runtime trap (assert), never an exit call
EXCLUDED = ('var/lib/paxage/trust', 'var/cache/paxage')
PRIVILEGED = os.geteuid() == 0


def fixture_identity():
    """The unprivileged identity that publishes the fixture repository in a root take
    (pm03 refuses test-only signing as root; root runs only the root verbs). It is the
    checkout's owner, who can always reach the checkout: a GitHub runner keeps it under a
    0750 home that nobody else may search, so a fixed uid like 65534 cannot exec the
    binary there. A root-owned checkout (the container take's copy) falls back to sudo's
    caller, then to 65534. LARDER_FIXTURE_UID overrides."""
    if os.environ.get('LARDER_FIXTURE_UID', '').isdigit():
        uid = int(os.environ['LARDER_FIXTURE_UID'])
        return uid, uid
    st = ROOT.stat()
    if st.st_uid != 0:
        return st.st_uid, st.st_gid
    sudo_uid, sudo_gid = os.environ.get('SUDO_UID', ''), os.environ.get('SUDO_GID', '')
    if sudo_uid.isdigit() and int(sudo_uid) != 0:
        return int(sudo_uid), int(sudo_gid) if sudo_gid.isdigit() else int(sudo_uid)
    return 65534, 65534


FIXTURE_UID, FIXTURE_GID = fixture_identity()

FAILED = []
KEEP_GOING = False


class RowFailed(Exception):
    pass


def emit(ok, row, detail=''):
    if ok:
        print(f'PASS {row}', flush=True)
        return True
    line = f'FAIL {row}' + (f' {detail}' if detail else '')
    print(line, flush=True)
    FAILED.append(row)
    if not KEEP_GOING:
        raise SystemExit(1)
    raise RowFailed(row)


def check(ok, row, detail=''):
    return emit(bool(ok), row, detail)


def pxg(*args, binary=None, env=None, timeout=120, fixture=False):
    exe = binary or BIN
    if not Path(exe).exists():
        return subprocess.CompletedProcess([str(exe)], 127, '', f'missing executable {exe}')
    full_env = dict(os.environ)
    full_env.pop('LARDER_FAILPOINT', None)
    if env:
        full_env.update(env)
    drop = fixture and PRIVILEGED
    return subprocess.run([str(exe), *map(str, args)], capture_output=True, text=True,
                          timeout=timeout, env=full_env, preexec_fn=as_fixture if drop else no_core)


def no_core():
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))


def as_fixture():
    no_core()
    os.setgroups([])
    os.setgid(FIXTURE_GID)
    os.setuid(FIXTURE_UID)


def fixture_dir(path):
    path.mkdir(parents=True, mode=0o700)
    if PRIVILEGED:
        os.chown(path, FIXTURE_UID, FIXTURE_GID)
    return path


def describe(p):
    return f'exit={p.returncode} stdout={p.stdout[-400:]!r} stderr={p.stderr[-400:]!r}'


def ok(p, row, last=None):
    good = p.returncode == 0
    if good and last is not None:
        good = p.stdout.splitlines()[-1:] == [last]
    return check(good, row, '' if good else describe(p))


def refused(p, row, code, needle):
    good = p.returncode == code and needle in p.stderr
    return check(good, row, '' if good else f'want exit={code} {needle!r}; ' + describe(p))


# ---------------------------------------------------------------- tree digests

def entries(root):
    root = Path(root)
    out = []
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        rel_dir = os.path.relpath(dirpath, root)
        for name in sorted(dirnames + filenames):
            rel = name if rel_dir == '.' else f'{rel_dir}/{name}'
            if any(rel == e or rel.startswith(e + '/') for e in EXCLUDED):
                continue
            out.append(rel)
        dirnames[:] = [d for d in dirnames
                       if not any((d if rel_dir == '.' else f'{rel_dir}/{d}') == e for e in EXCLUDED)]
    return sorted(out, key=lambda s: s.encode())


def tree_digest(root):
    """Section 5's digest: path, type, mode, owner, length, content or target,
    hardlink class. Times are excluded; trust/ and the cache are excluded."""
    root = Path(root)
    h = hashlib.sha256()
    first = {}
    for rel in entries(root):
        p = root / rel
        st = os.lstat(p)
        if stat.S_ISDIR(st.st_mode):
            kind, body = 'dir', ''
        elif stat.S_ISLNK(st.st_mode):
            kind, body = 'symlink', os.readlink(p)
        elif stat.S_ISREG(st.st_mode):
            kind, body = 'file', hashlib.sha256(p.read_bytes()).hexdigest()
        else:
            kind, body = 'other', ''
        link = ''
        if kind == 'file' and st.st_nlink > 1:
            link = first.setdefault((st.st_dev, st.st_ino), rel)
        owner = f'{st.st_uid}:{st.st_gid}' if PRIVILEGED else 'logical'
        h.update(f'{rel}\0{kind}\0{stat.S_IMODE(st.st_mode):o}\0{owner}\0{st.st_size}\0{body}\0{link}\n'.encode())
    return h.hexdigest()


def clone(src, dst):
    """Copy a root preserving types, modes, owners (when privileged) and hardlinks."""
    src, dst = Path(src), Path(dst)
    seen = {}
    dst.mkdir()
    shutil.copymode(src, dst)
    for rel in entries(src) + [e for e in _excluded_entries(src)]:
        s, d = src / rel, dst / rel
        st = os.lstat(s)
        if stat.S_ISDIR(st.st_mode):
            d.mkdir()
        elif stat.S_ISLNK(st.st_mode):
            os.symlink(os.readlink(s), d)
        elif stat.S_ISREG(st.st_mode):
            key = (st.st_dev, st.st_ino)
            if st.st_nlink > 1 and key in seen:
                os.link(seen[key], d)
                continue
            shutil.copyfile(s, d, follow_symlinks=False)
            seen[key] = d
        if PRIVILEGED:
            os.lchown(d, st.st_uid, st.st_gid)
        if not stat.S_ISLNK(st.st_mode):
            os.chmod(d, stat.S_IMODE(st.st_mode))
    for rel in reversed(entries(src)):
        s, d = src / rel, dst / rel
        if os.path.isdir(s) and not os.path.islink(s):
            os.chmod(d, stat.S_IMODE(os.lstat(s).st_mode))


def _excluded_entries(root):
    out = []
    for e in EXCLUDED:
        base = Path(root) / e
        if not base.exists():
            continue
        out.append(e)
        for dirpath, dirnames, filenames in os.walk(base):
            for name in sorted(dirnames + filenames):
                out.append(os.path.relpath(os.path.join(dirpath, name), root))
    return sorted(set(out), key=lambda s: (s.count('/'), s.encode()))


# ---------------------------------------------------------------- fixtures

def dep(name, op='any', version=''):
    return f'dep {{ name: "{name}", op: "{op}", version: "{version}", arch: "{ARCH}", slot: "{SLOT}" }}'


class Package:
    def __init__(self, name, version, files, requires=(), configs=(), actions=(), provides=()):
        self.name, self.version = name, version
        self.files = files            # path -> ('file', mode, bytes) | ('dir', mode) | ('symlink', target) | ('hardlink', path)
        self.requires, self.configs, self.actions, self.provides = requires, configs, actions, provides

    def build(self, work):
        src = work / f'src-{self.name}-{self.version}'
        out = work / f'pack-{self.name}-{self.version}'
        src.mkdir(parents=True)
        out.mkdir()
        dirs = sorted({str(Path(p).parent) for p in self.files if str(Path(p).parent) != '.'} |
                      {p for p, v in self.files.items() if v[0] == 'dir'}, key=lambda s: (s.count('/'), s))
        for d in dirs:
            (src / d).mkdir(parents=True, exist_ok=True)
        for p, v in sorted(self.files.items()):
            if v[0] == 'file':
                (src / p).write_bytes(v[2])
                os.chmod(src / p, v[1])
        for p, v in sorted(self.files.items()):
            if v[0] == 'symlink':
                os.symlink(v[1], src / p)
            elif v[0] == 'hardlink':
                os.link(src / v[1], src / p)
        for d in sorted(dirs, key=lambda s: -s.count('/')):
            mode = self.files.get(d, ('dir', 0o755))[1]
            os.chmod(src / d, mode)
        buildinfo = work / f'{self.name}-{self.version}.buildinfo'
        buildinfo.write_text(f'buildinfo {{ test_only: true, name: "{self.name}", version: "{self.version}" }}\n')
        records = ', '.join(
            f'file {{ path: "{c}", type: "file", mode: 420, owner: 0, group: 0, length: 0, sha256: "{ZERO}", target: "" }}'
            for c in self.configs)
        provides = ', '.join(f'provide {{ name: "{n}", version: "{v}" }}' for n, v in self.provides)
        actions = ', '.join(f'action {{ kind: "{k}", name: "{n}", version: 1 }}' for k, n in self.actions)
        configs = ', '.join(f'"{c}"' for c in self.configs)
        template = (
            f'manifest {{ schema: 1, features: [], name: "{self.name}", version: "{self.version}", '
            f'arch: "{ARCH}", slot: "{SLOT}", license: "GPL-3.0-or-later", '
            f'sources: [source {{ name: "source", sha256: "{ZERO}", length: 0 }}], '
            f'buildinfo: "{hashlib.sha256(buildinfo.read_bytes()).hexdigest()}", installed_bytes: 0, '
            f'installed_inodes: 0, requires: [{", ".join(self.requires)}], optional: [], '
            f'provides: [{provides}], conflicts: [], replaces: [], files: [{records}], '
            f'configs: [{configs}], actions: [{actions}] }}\n')
        tpath = work / f'{self.name}-{self.version}.template'
        tpath.write_text(template)
        if PRIVILEGED:
            for top in (src, out, buildinfo, tpath):
                os.lchown(top, FIXTURE_UID, FIXTURE_GID)
                for dirpath, dirnames, filenames in os.walk(top):
                    for n in dirnames + filenames:
                        os.lchown(os.path.join(dirpath, n), FIXTURE_UID, FIXTURE_GID)
        p = pxg('pack', src, tpath, out, '--epoch', '100', fixture=True)
        if p.returncode != 0:
            raise SystemExit(f'FAIL fixture-pack-{self.name}-{self.version} {describe(p)}')
        return out / f'{self.name}-{self.version}.manifest', buildinfo


def alpha(version):
    one = version in ('1-1', '1-2')
    files = {
        'usr': ('dir', 0o755), 'usr/bin': ('dir', 0o755), 'usr/share': ('dir', 0o755),
        'usr/share/alpha': ('dir', 0o755), 'etc': ('dir', 0o755),
        'usr/bin/alpha': ('file', 0o755, {'1-1': b'alpha 1\n', '1-2': b'alpha 1.2\n'}.get(version, b'alpha 2\n')),
        'usr/bin/al': ('symlink', 'alpha'),
        'usr/share/alpha/data': ('file', 0o644, b'data 1\n' if one else b'data 2\n'),
        'usr/share/alpha/data.link': ('hardlink', 'usr/share/alpha/data'),
        'etc/alpha.conf': ('file', 0o644, b'setting=1\n' if one else b'setting=2\n'),
    }
    if version == '1-1':
        files['usr/share/alpha/old'] = ('file', 0o644, b'old\n')
    else:
        files['usr/share/alpha/new'] = ('file', 0o644, b'new\n')
    return Package('alpha', version, files, configs=['etc/alpha.conf'],
                   actions=[('account', 'pm04-daemon'), ('directory', 'pm04-spool'), ('cache', 'pm04-index')])


def simple(name, version='1-1', requires=(), path=None, body=None):
    path = path or f'usr/share/{name}/{name}'
    files = {'usr': ('dir', 0o755), 'usr/share': ('dir', 0o755), str(Path(path).parent): ('dir', 0o755),
             path: ('file', 0o644, body or f'{name} {version}\n'.encode())}
    return Package(name, version, files, requires=requires)


class Repo:
    def __init__(self, work):
        self.work = work
        self.keys = work / 'test-only-keys'
        self.repo = work / 'repo'
        self.url = self.repo.as_uri()
        self.pinned = work / 'pinned-root.json'
        self.version = 0
        self.built = {}

    def setup(self):
        if PRIVILEGED:
            try:
                reach = pxg('version', fixture=True)
            except PermissionError as e:
                raise SystemExit(f'FAIL fixture-identity-reach uid={FIXTURE_UID} cannot exec {BIN}: {e}')
            if reach.returncode != 0:
                raise SystemExit(f'FAIL fixture-identity-reach uid={FIXTURE_UID} {describe(reach)}')
            print(f'transactions: fixture published as uid={FIXTURE_UID} gid={FIXTURE_GID}', flush=True)
        p = pxg('repo', 'keygen', '--keys', self.keys, '--now', NOW, fixture=True)
        if p.returncode != 0:
            raise SystemExit(f'FAIL fixture-keygen {describe(p)}')
        p = pxg('repo', 'init', '--repo', self.url, '--keys', self.keys, '--now', NOW, fixture=True)
        if p.returncode != 0:
            raise SystemExit(f'FAIL fixture-repo-init {describe(p)}')
        shutil.copyfile(self.repo / 'metadata/1.root.json', self.pinned)

    def publish(self, packages):
        self.version += 1
        args = []
        for pkg in packages:
            key = (pkg.name, pkg.version)
            if key not in self.built:
                self.built[key] = pkg.build(self.work / 'packages')
            manifest, buildinfo = self.built[key]
            args += ['--manifest', manifest, '--buildinfo', buildinfo]
        p = pxg('repo', 'publish', '--repo', self.url, '--keys', self.keys, '--version', str(self.version),
                *args, '--now', NOW, fixture=True)
        if p.returncode != 0:
            raise SystemExit(f'FAIL fixture-publish-{self.version} {describe(p)}')


def universe(upgraded=False, alphas=None):
    alphas = alphas or (['2-1', '1-1'] if upgraded else ['1-1'])
    pkgs = [alpha(v) for v in alphas] + [simple('beta', requires=[dep('alpha')]),
            simple('omega', path='usr/bin/alpha', body=b'omega\n'),
            simple('app', requires=[dep('gamma')]), simple('gamma', requires=[dep('delta')]),
            simple('delta', requires=[dep('gamma')]), simple('lone')]
    return pkgs


# ---------------------------------------------------------------- roots

class Roots:
    def __init__(self, repo):
        self.repo = repo
        self.count = 0
        self.outside = WORK / 'outside'

    def fresh(self, label):
        self.count += 1
        root = WORK / 'roots' / f'{self.count:04d}-{label}'
        root.mkdir(parents=True, mode=0o755)
        return root

    def init(self, label):
        root = self.fresh(label)
        p = pxg('init', '--root', root, '--repo', self.repo.url, '--pinned-root', self.repo.pinned,
                '--arch', ARCH, '--slot', SLOT, '--now', NOW)
        return root, p

    def ready(self, label, *installs):
        root, p = self.init(label)
        if p.returncode != 0:
            raise_setup(label, 'init', p)
        for spec in installs:
            q = pxg('install', '--root', root, *spec.split(), '--now', NOW)
            if q.returncode != 0:
                raise_setup(label, f'install {spec}', q)
        return root

    def copy(self, base, label):
        self.count += 1
        dst = WORK / 'roots' / f'{self.count:04d}-{label}'
        clone(base, dst)
        return dst


def raise_setup(row, what, p):
    emit(False, row, f'setup {what}: {describe(p)}')


def status(root):
    p = pxg('status', '--root', root, '--json')
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout)
    except ValueError:
        return None


def installed(root):
    s = status(root) or {}
    return {pkg['name']: (pkg['version'], pkg['reason']) for pkg in s.get('packages', [])}


def outside_digest(roots):
    return tree_digest(roots.outside)


# ---------------------------------------------------------------- rows

ROWS = []


def row(name):
    def wrap(fn):
        ROWS.append((name, fn))
        return fn
    return wrap


@row('init-root')
def init_root(r):
    root, p = r.init('init-root')
    ok(p, 'init-root', last='init ok')
    state = root / 'var/lib/paxage'
    check(stat.S_IMODE(os.lstat(state).st_mode) == 0o700 and (state / 'lock').is_file()
          and (state / 'current').is_file(), 'init-root-layout')
    s = status(root)
    check(s is not None and s.get('generation') == 0 and s.get('packages') == [] and s.get('pending') == '',
          'status-generation-zero', json.dumps(s))
    again = pxg('init', '--root', root, '--repo', r.repo.url, '--pinned-root', r.repo.pinned,
                '--arch', ARCH, '--slot', SLOT, '--now', NOW)
    refused(again, 'init-refuses-existing-state', 1, 'state-exists')


@row('live-root-refused')
def live_root(r):
    p = pxg('install', '--root', '/', 'alpha', '--now', NOW)
    refused(p, 'live-root-refused', 1, 'live-root-is-pm05')


@row('lock-persistent-inode')
def lock_inode(r):
    root = r.ready('lock-inode')
    lock = root / 'var/lib/paxage/lock'
    before = os.lstat(lock)
    ok(pxg('install', '--root', root, 'lone', '--now', NOW), 'lock-inode-install')
    ok(pxg('remove', '--root', root, 'lone'), 'lock-inode-remove')
    after = os.lstat(lock)
    check((before.st_dev, before.st_ino) == (after.st_dev, after.st_ino) and after.st_size == 0,
          'lock-persistent-inode', f'{before.st_ino} -> {after.st_ino} size={after.st_size}')


def paused(root, failpoint, *args):
    fifo = WORK / f'fifo-{os.getpid()}-{time.monotonic_ns()}'
    os.mkfifo(fifo, 0o600)
    env = dict(os.environ, LARDER_FAILPOINT=f'{failpoint}:pause', LARDER_FAILPOINT_FIFO=str(fifo))
    proc = subprocess.Popen([str(FPBIN), *map(str, args)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, env=env, preexec_fn=no_core)
    deadline = time.monotonic() + 30
    line = ''
    while time.monotonic() < deadline:
        line = proc.stderr.readline()
        if line.startswith('PAUSED ') or not line:
            break
    return proc, fifo, line.strip()


def resume(proc, fifo, word='go'):
    with open(fifo, 'w') as f:
        f.write(word + '\n')
    out, err = proc.communicate(timeout=120)
    os.unlink(fifo)
    return subprocess.CompletedProcess(proc.args, proc.returncode, out, err)


@row('lock-contention')
def lock_contention(r):
    root = r.ready('lock-contention')
    if not FPBIN.exists():
        emit(False, 'lock-contention', f'missing {FPBIN}')
    proc, fifo, line = paused(root, 'lock', 'install', '--root', root, 'lone', '--now', NOW)
    check(line == 'PAUSED lock', 'lock-contention-paused', line)
    started = time.monotonic()
    p = pxg('install', '--root', root, 'beta', '--now', NOW)
    elapsed = time.monotonic() - started
    refused(p, 'lock-contention', 7, 'locked')
    check(elapsed < 5, 'lock-contention-nonblocking', f'{elapsed:.2f}s')
    refused(pxg('rescue', '--root', root), 'lock-contention-rescue', 7, 'locked')
    check(status(root) is not None, 'lock-contention-status-read-only')
    ok(resume(proc, fifo), 'lock-contention-holder-completes')
    check('lone' in installed(root), 'lock-contention-holder-result')


@row('lock-owner-exit')
def lock_owner_exit(r):
    root = r.ready('lock-owner-exit')
    if not FPBIN.exists():
        emit(False, 'lock-owner-exit', f'missing {FPBIN}')
    proc, fifo, line = paused(root, 'lock', 'install', '--root', root, 'lone', '--now', NOW)
    check(line == 'PAUSED lock', 'lock-owner-exit-paused', line)
    # The holder dies by its own trap; the test signals nothing (RULES 5).
    died = resume(proc, fifo, 'crash')
    check(died.returncode == CRASH_EXIT, 'lock-owner-exit-holder-died', describe(died))
    ok(pxg('install', '--root', root, 'lone', '--now', NOW), 'lock-owner-exit')
    check(not any(p.name.startswith('pid') for p in (root / 'var/lib/paxage').iterdir()), 'lock-no-pid-file')


@row('lock-symlink-refused')
def lock_symlink(r):
    root = r.ready('lock-symlink')
    lock = root / 'var/lib/paxage/lock'
    lock.unlink()
    os.symlink(r.outside / 'lock-target', lock)
    refused(pxg('install', '--root', root, 'lone', '--now', NOW), 'lock-symlink-refused', 1, 'lock-inode')
    check(not (r.outside / 'lock-target').exists(), 'lock-symlink-target-untouched')


@row('lock-missing-refused')
def lock_missing(r):
    root = r.ready('lock-missing')
    (root / 'var/lib/paxage/lock').unlink()
    refused(pxg('install', '--root', root, 'lone', '--now', NOW), 'lock-missing-refused', 1, 'lock-missing')
    check(not (root / 'var/lib/paxage/lock').exists(), 'lock-missing-not-recreated')


@row('install-explicit')
def install_explicit(r):
    root = r.ready('install')
    before = outside_digest(r)
    p = pxg('install', '--root', root, 'alpha', '--now', NOW)
    ok(p, 'install-explicit', last='install ok generation=1')
    check(installed(root) == {'alpha': ('1-1', 'explicit')}, 'install-explicit-database', json.dumps(status(root)))
    check((root / 'usr/bin/alpha').read_bytes() == b'alpha 1\n'
          and stat.S_IMODE(os.lstat(root / 'usr/bin/alpha').st_mode) == 0o755
          and os.readlink(root / 'usr/bin/al') == 'alpha'
          and os.lstat(root / 'usr/share/alpha/data').st_ino == os.lstat(root / 'usr/share/alpha/data.link').st_ino,
          'install-tree-identity')
    if PRIVILEGED:
        check(all(os.lstat(root / f).st_uid == 0 for f in ('usr/bin/alpha', 'usr/share/alpha/data')),
              'install-owner-applied')
    check(outside_digest(r) == before, 'install-outside-untouched')
    ok(pxg('verify', '--root', root), 'verify-clean', last='verify ok')
    check(not list((root / 'var/lib/paxage/transactions').iterdir()), 'install-no-transaction-left')


@row('install-dependency-reason')
def install_dependency(r):
    root = r.ready('install-dependency')
    ok(pxg('install', '--root', root, 'beta', '--now', NOW), 'install-dependency-reason-run')
    check(installed(root) == {'alpha': ('1-1', 'dependency'), 'beta': ('1-1', 'explicit')},
          'install-dependency-reason', json.dumps(status(root)))
    check((root / 'usr/share').is_dir(), 'install-shared-directory')


