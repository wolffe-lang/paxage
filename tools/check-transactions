@row('rescue-entry')
def rescue_entry(r):
    root = r.ready('rescue-entry', 'alpha')
    p = pxg('rescue', '--root', root)
    ok(p, 'rescue-nothing-to-do', last='rescue: nothing to do')
    if not FPBIN.exists():
        emit(False, 'rescue-unknown-state', f'missing {FPBIN}')
    _, names = failpoints(r, root, 'remove')
    cut = [n for n in names if n.startswith('apply:') and n.count(':') == 1][-1]
    stuck = r.copy(root, 'rescue-stuck')
    run_verb(stuck, 'remove', binary=FPBIN, env={'LARDER_FAILPOINT': f'{cut}:crash'})
    s = status(stuck) or {}
    check(s.get('pending', '').startswith('t'), 'status-recovery-needed', json.dumps(s))
    refused(pxg('install', '--root', stuck, 'lone', '--now', NOW), 'mutation-refused-recovery-needed', 8,
            'recovery-needed')
    tampered = r.copy(stuck, 'rescue-tampered')
    (tampered / 'usr/bin').mkdir(parents=True, exist_ok=True)
    (tampered / 'usr/bin/alpha').write_bytes(b'neither\n')
    before = tree_digest(tampered)
    refused(pxg('rescue', '--root', tampered), 'rescue-unknown-state', 9, 'rescue-unknown-state')
    check(tree_digest(tampered) == before, 'rescue-unknown-state-no-writes')
    gone = r.copy(stuck, 'rescue-missing-backup')
    backups = sorted((gone / 'var/lib/paxage/transactions').glob('t*/backup/*'))
    if backups:
        backups[0].unlink()
    refused(pxg('rescue', '--root', gone), 'rescue-missing-backup', 9, 'rescue-missing-backup')
    bad = r.copy(stuck, 'rescue-malformed')
    intents = sorted((bad / 'var/lib/paxage/transactions').glob('t*/intent'))
    if intents:
        data = intents[0].read_bytes()
        intents[0].write_bytes(data[:-10] + b'x' * 10)
    refused(pxg('rescue', '--root', bad), 'rescue-malformed-intent', 9, 'rescue-malformed-intent')


@row('race-ancestors')
def races(r):
    if not FPBIN.exists():
        emit(False, 'race-ancestors', f'missing {FPBIN}')
    base = r.ready('race-base')
    old = tree_digest(base)
    probe = r.copy(base, 'race-trace')
    p = pxg('install', '--root', probe, 'alpha', '--now', NOW, binary=FPBIN, env={'LARDER_FAILPOINT': 'trace'})
    points = trace_points(p)
    target = 'usr/share/alpha/data'
    walks = [n for n, info in points if n.endswith(':walk') and f'path={target}' in info.split()]
    check(len(walks) == 1, 'race-ancestors-hooked', repr(points[:6]))
    for point in walks + [w.replace(':walk', ':temp') for w in walks]:
        for ancestor in ['usr', 'usr/share', 'usr/share/alpha']:
            label = f'race-ancestor-{ancestor.replace("/", "-")}-{point.split(":")[-1]}'
            root = r.copy(base, label)
            pre = outside_digest(r)
            proc, fifo, line = paused(root, point, 'install', '--root', root, 'alpha', '--now', NOW)
            try:
                check(line.startswith('PAUSED'), f'{label}-paused', line)
                real = root / ancestor
                aside = root.parent / f'{root.name}-aside'
                if real.exists():
                    os.rename(real, aside)
                os.symlink(r.outside / 'sentinel', real)
                result = resume(proc, fifo)
                refused(result, label, 1, 'path-race')
                check(outside_digest(r) == pre, f'{label}-outside-untouched')
                refused(pxg('rescue', '--root', root), f'{label}-rescue-refuses-while-swapped', 9,
                        'rescue-unknown-state')
                os.unlink(real)
                if aside.exists():
                    os.rename(aside, real)
                recovered_twice(r, root, f'{label}-restored', old)
            except RowFailed:
                continue


