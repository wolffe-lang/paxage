# ---------------------------------------------------------------- recovery

SCENARIOS = {
    'install': (lambda r, label: r.ready(label), ['install', 'alpha', '--now', NOW]),
    'upgrade': (None, ['upgrade', '--now', NOW]),
    'remove': (lambda r, label: r.ready(label, 'alpha'), ['remove', 'alpha']),
}


def scenario_base(r, verb):
    if verb == 'upgrade':
        # The repository already offers 2-1 here; the base pins 1-1 explicitly.
        return r.ready('base-upgrade', 'alpha=1-1')
    return SCENARIOS[verb][0](r, f'base-{verb}')


def run_verb(root, verb, binary=None, env=None):
    args = SCENARIOS[verb][1]
    return pxg(args[0], '--root', root, *args[1:], binary=binary, env=env)


def references(r, verb):
    base = scenario_base(r, verb)
    old = tree_digest(base)
    done = r.copy(base, f'ref-new-{verb}')
    p = run_verb(done, verb)
    if p.returncode != 0:
        raise_setup(f'crash-{verb}', 'reference run', p)
    return base, old, tree_digest(done)


def trace_points(p, prefix=''):
    """FAILPOINT <name> [detail...] lines, in order; the name is what a cut arms."""
    out = []
    for line in p.stderr.splitlines():
        if line.startswith('FAILPOINT ' + prefix):
            parts = line.split(' ', 2)
            out.append((parts[1], parts[2] if len(parts) > 2 else ''))
    return out


def failpoints(r, base, verb):
    root = r.copy(base, f'trace-{verb}')
    p = run_verb(root, verb, binary=FPBIN, env={'LARDER_FAILPOINT': 'trace'})
    return p, [name for name, _ in trace_points(p)]


REQUIRED_PHASES = ['lock', 'capacity', 'stage', 'intent-written', 'intent', 'generation', 'commit-written',
                   'commit-renamed', 'commit', 'done']


def recovered_twice(r, root, row, expect):
    first = pxg('rescue', '--root', root)
    one = tree_digest(root)
    second = pxg('rescue', '--root', root)
    two = tree_digest(root)
    good = first.returncode == 0 and second.returncode == 0 and one == two and one == expect
    detail = '' if good else f'first={describe(first)} second={describe(second)} same={one == two} expect={one == expect}'
    check(good, row, detail)
    check(second.stdout.strip().endswith('rescue: nothing to do'), f'{row}-second-is-noop', second.stdout)


def crash_matrix(r, verb):
    if not FPBIN.exists():
        emit(False, f'crash-{verb}', f'missing {FPBIN}')
    base, old, new = references(r, verb)
    trace, names = failpoints(r, base, verb)
    ok(trace, f'crash-{verb}-trace')
    missing = [n for n in REQUIRED_PHASES if n not in names]
    if verb != 'install':
        missing += [] if any(n.startswith('backup:') for n in names) else ['backup:<i>']
    missing += [] if any(n.startswith('apply:') for n in names) else ['apply:<i>']
    check(not missing, f'crash-{verb}-every-transition-hooked', f'missing={missing}')
    committed = False
    for name in names:
        if name == 'commit-renamed':
            committed = True
        root = r.copy(base, f'crash-{verb}')
        p = run_verb(root, verb, binary=FPBIN, env={'LARDER_FAILPOINT': f'{name}:crash'})
        row_name = f'crash-{verb}-{name}'
        try:
            check(p.returncode == CRASH_EXIT, f'{row_name}-cut', describe(p))
            pending = (status(root) or {}).get('pending', '')
            if pending:
                refused(run_verb(r.copy(root, 'probe'), 'install'), f'{row_name}-mutation-refused', 8,
                        'recovery-needed')
            recovered_twice(r, root, row_name, new if committed else old)
        except RowFailed:
            continue
    return base, names


@row('crash-install')
def crash_install(r):
    crash_matrix(r, 'install')


