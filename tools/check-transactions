@row('fs-unqualified-refused')
def unqualified(r):
    target = os.environ.get('LARDER_UNQUALIFIED_ROOT', '')
    if not target:
        # The gauntlet prints the column-0 SKIP for this row; inside a step it would read as a nested SKIP.
        print('  skipped fs-unqualified-refused: no LARDER_UNQUALIFIED_ROOT (the container take mounts a tmpfs)')
        return
    root = Path(target) / 'root'
    root.mkdir()
    p = pxg('init', '--root', root, '--repo', r.repo.url, '--pinned-root', r.repo.pinned,
            '--arch', ARCH, '--slot', SLOT, '--now', NOW)
    refused(p, 'fs-unqualified-refused', 1, 'unqualified-filesystem')


def main():
    global KEEP_GOING
    ap = argparse.ArgumentParser()
    ap.add_argument('--all', action='store_true', help='keep going after a FAIL')
    ap.add_argument('--rows', default='', help='comma-separated row-group names')
    args = ap.parse_args()
    KEEP_GOING = args.all
    if WORK.exists():
        shutil.rmtree(WORK)
    WORK.mkdir(parents=True, mode=0o755)
    fixture = fixture_dir(WORK / 'fixture')
    fixture_dir(fixture / 'packages')
    repo = Repo(fixture)
    repo.setup()
    repo.publish(universe())
    roots = Roots(repo)
    roots.outside.mkdir()
    (roots.outside / 'sentinel').mkdir()
    (roots.outside / 'sentinel/keep').write_bytes(b'outside\n')
    wanted = set(filter(None, args.rows.split(',')))
    print(f'transactions: privileged={PRIVILEGED} platform={sys.platform}', flush=True)
    for name, fn in ROWS:
        if wanted and name not in wanted:
            continue
        try:
            fn(roots)
        except RowFailed:
            continue
    if FAILED:
        print(f'transactions: {len(FAILED)} red rows', flush=True)
        return 1
    print('PASS transactions', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
