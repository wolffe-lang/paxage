#!/bin/sh
set -eu
LARDER_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export LARDER_ROOT
cd "$LARDER_ROOT"
. tools/lib-toolchain.sh
mkdir -p target/bin
rm -rf "$LARDER_ROOT/src/.lu-cache"
"$WOLF" build --deny-warnings src/larder.lu -o target/bin/larder
ln -sf larder target/bin/lrd
rm -rf "$LARDER_ROOT/src/.lu-cache"
"$WOLF" build --deny-warnings src/larder_failpoint.lu -o target/bin/larder-failpoint
printf 'build: target/bin/larder and lrd\n'
