#!/usr/bin/env python3
"""Every refusal code the sources name for a privilege or live-root refusal is documented."""
import pathlib
import re
import sys

root = pathlib.Path(__file__).resolve().parent.parent
code = re.compile(r'"(live-root-[a-z-]+|privileged-[a-z-]+)"')
found = {}
for path in sorted((root / 'src').rglob('*.lu')):
    if path.name.endswith('_test.lu'):
        continue
    for match in code.finditer(path.read_text(encoding='utf-8')):
        found.setdefault(match.group(1), path.relative_to(root).as_posix())
docs = '\n'.join(p.read_text(encoding='utf-8') for p in sorted((root / 'docs').glob('*.md')))
failed = False
for name, where in sorted(found.items()):
    if f'`{name}`' not in docs:
        print(f'FAIL docs-code {name} defined in {where} is not documented in docs/')
        failed = True
want = {'live-root-unsupported', 'privileged-staging-refused', 'privileged-trust-refused'}
for name in sorted(want - set(found)):
    print(f'FAIL docs-code {name} is not defined in src/')
    failed = True
# Reviewed public bootstrap identity, independent of the page being checked.
# This is a documentation pin, not a runtime trust-anchor selection mechanism.
LIVE_ROOT_SHA256 = 'c770e228533144c436ae8e5ee8d62de0a74f56c5bf9e7aade0259701b7b2b0f3'
anchor = root / 'docs/TRUST-ANCHOR.md'
if not anchor.is_file() or f'SHA-256: `{LIVE_ROOT_SHA256}`' not in anchor.read_text(encoding='utf-8'):
    print('FAIL docs-live-root-fingerprint: trust-anchor page differs from the reviewed documentation pin')
    failed = True
else:
    print('PASS docs-live-root-fingerprint ' + LIVE_ROOT_SHA256)
if failed:
    sys.exit(1)
print('PASS docs-code ' + ' '.join(sorted(found)))
