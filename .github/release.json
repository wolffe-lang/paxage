{
  "schema": 1,
  "name": "paxage",
  "manifest": "src/wolf.pkg",
  "gate_workflow": ".github/workflows/release-gate.yml",
  "gate_profile": "full",
  "build": [
    "sh",
    "-eu",
    "-c",
    "PAXAGE_ROOT=\"$PWD\"; export PAXAGE_ROOT; . tools/lib-toolchain.sh; mkdir -p target/release; \"$WOLF\" build --release --deny-warnings src/paxage.lu -o target/release/paxage; cp target/release/paxage target/release/pxg"
  ],
  "binaries": {
    "paxage": "target/release/paxage",
    "pxg": "target/release/pxg"
  },
  "version_args": [
    "--version"
  ],
  "version_pattern": "^paxage (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+) \\(.+\\)$",
  "smoke": [
    [
      "{bin}/paxage",
      "--version"
    ],
    [
      "{bin}/pxg",
      "compare",
      "1-1",
      "2-1"
    ]
  ],
  "experimental": true
}
